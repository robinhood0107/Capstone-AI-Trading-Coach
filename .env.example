POSTGRES_DB=trading
POSTGRES_ADMIN_USER=postgres
POSTGRES_HOST=127.0.0.1
# local OpenAPI fixture 등 기본 5432와 격리할 때만 host/application port를 같은 값으로 설정
POSTGRES_HOST_PORT=5432
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
POSTGRES_COLLECTOR_PASSWORD=
POSTGRES_DISCLOSURE_READER_PASSWORD=
POSTGRES_MARKET_WRITER_PASSWORD=
POSTGRES_PORTFOLIO_WRITER_PASSWORD=
POSTGRES_RISK_WRITER_PASSWORD=
POSTGRES_FILL_WRITER_PASSWORD=
POSTGRES_RAG_WRITER_PASSWORD=
POSTGRES_RAG_ADMIN_PASSWORD=
POSTGRES_RAG_QUERY_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
JWT_SECRET=                # HS256 전용 32byte 이상 랜덤 secret
JWT_ISSUER=                # 배포 환경에서 exact 문자열 고정
JWT_AUDIENCE=              # 배포 환경에서 exact 문자열 고정
LOGIN_SCOPE_HMAC_KEY=      # JWT secret과 다른 32byte 이상 랜덤 secret
PRINCIPLE_CURSOR_HMAC_KEY= # JWT/login key와 다른 32byte 이상 랜덤 secret; S2.1 cursor 전용
DECISION_IDEMPOTENCY_SCOPE_HMAC_KEY= # Principle/JWT key와 분리한 S2.3 idempotency scope 전용 32byte 이상 secret
BROKERAGE_IDEMPOTENCY_SCOPE_HMAC_KEY= # JWT/Decision key와 분리한 S3.1 brokerage mock idempotency scope 전용 32byte 이상 secret
BROKERAGE_DB_CAPABILITY_TOKEN= # direct table DML을 막는 S3.1 DB function 전용 32byte 이상 random capability
BROKERAGE_DB_CAPABILITY_TOKEN_SHA256= # 위 capability의 lowercase SHA-256 hex; Flyway에는 digest만 전달
RAG_ANSWERER=FIXTURE_ONLY # S4.4 기본값. live provider answerer는 별도 승인 전 허용하지 않음
RAG_HISTORY_SECRET_DIRECTORY=/run/secrets/rag-history # 운영 secret mount의 absolute normalized 0700 directory
RAG_HISTORY_CURRENT_KEK_VERSION=kek-v1 # 위 directory의 rag-history-kek-v1.key(0600, 32-byte key)
RAG_IDEMPOTENCY_SCOPE_HMAC_KEY= # JWT/Decision/Brokerage 및 아래 RAG key와 분리한 32byte 이상 secret
RAG_REQUEST_FINGERPRINT_HMAC_KEY= # RAG canonical request fingerprint 전용 32byte 이상 secret
RAG_PROVIDER_USAGE_HMAC_KEY= # RAG provider usage ledger fingerprint 전용 32byte 이상 secret
RAG_RATE_LIMIT_HMAC_KEY= # Redis owner rate-limit scope 전용 32byte 이상 secret
RAG_HISTORY_CURSOR_HMAC_KEY= # owner-bound RAG history cursor 전용 32byte 이상 secret
DEMO_CREDENTIAL_SEPARATION_KEY= # 정확히 32byte를 unpadded Base64url로 인코딩; JWT/limiter key와 분리
DEMO_USER_CREDENTIAL_BUNDLE=''  # s21-v1 USER bundle; $ 포함 hash 보존을 위해 actual .env에서도 single quote
DEMO_ADMIN_CREDENTIAL_BUNDLE='' # s21-v1 ADMIN bundle; 두 bundle은 같은 approved workflow에서 원자 게시
KIS_MODE=mock              # mock | live (live는 S1.1에서 읽기 전용 시장데이터만)
KIS_OFFLINE=0              # 1이면 fixture 모드(S1.1)
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=       # private env/secret store 전용 8자리-2자리 모의계좌; 로그·문서·fixture 금지
KIS_MOCK_BOUND_ACCOUNT_ID= # 위 credential과 1:1 결속할 acct_<32 lowercase hex>; approval author/probe는 root .env(0600)에서만 읽고 불일치 시 outbound 전 거부
KIS_MOCK_ORDER_REFERENCE_KEY= # 32 random bytes의 canonical Fernet urlsafe Base64; JWT/HMAC key와 분리, approval author/probe의 recovery outcome receipt에도 재사용
KIS_MOCK_ORDER_REFERENCE_TTL_SECONDS=900 # 60..604800; provider 취소 reference ciphertext TTL
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
# 미설정 기본: mock 1/s, live hard cap 18/s. 설정할 때는 mode 상한보다 낮은 값만 허용
# KIS_RATE_LIMIT_PER_SECOND=1
# 미설정 기본 호출 간격: mock 1000ms, live 120ms(공식 권장 100~150ms)
# KIS_REQUEST_INTERVAL_MILLISECONDS=1000
# limiter 총 대기 상한은 Redis I/O 예산을 포함해 8초 초과 10초 이하만 허용
# KIS_RATE_LIMIT_MAX_WAIT_SECONDS=10
KIS_DATA_DIR=data/kis
OPENDART_API_KEY=
# S1.6 OpenDART online collector는 아래 네 값을 모두 명시해야 하며 코드 기본값이 없다.
# 값을 채우는 것만으로 online/provider 호출이 승인되거나 자동 활성화되지는 않는다.
OPENDART_DAILY_CALL_LIMIT=
OPENDART_DAILY_CALL_BUDGET=
OPENDART_MAX_CALLS_PER_RUN=
OPENDART_MAX_SYMBOLS_PER_RUN=
ECOS_API_KEY=
ECOS_MAX_ATTEMPTS_PER_REQUEST=2  # 1..2, 승인 smoke는 1
KRX_OPENAPI_AUTH_KEY=
OPENAI_API_KEY=

# 향후 LLM/RAG provider. 계정·키 준비만으로 runtime provider가 자동 활성화되지는 않는다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# S1.6 Market Calendar/Event Aggregator 후보. 공공데이터포털 공통 키를 쓰더라도 서비스별로 분리해 관리한다.
DATA_GO_KASI_SERVICE_KEY=
DATA_GO_FSC_DIVIDEND_SERVICE_KEY=
DATA_GO_FSC_RIGHTS_SERVICE_KEY=
DATA_GO_KOTRA_SERVICE_KEY=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
# Massive(구 Polygon.io)
MASSIVE_API_KEY=

PYTHON_GRPC_BIND_ADDRESS=127.0.0.1:50051
PYTHON_GRPC_ENABLE_REFLECTION=false
DECISION_GRPC_SHARED_SECRET= # Spring↔Python Disclosure loopback gRPC shared secret; secret store에서만 주입
PYTHON_GRPC_SHARED_SECRET=  # Disclosure Python process용으로 DECISION_GRPC_SHARED_SECRET와 같은 값
RAG_GRPC_SHARED_SECRET= # RAG 전용 loopback secret; enabled면 모든 활성 auth·Decision/Python·brokerage credential과 달라야 함
RAG_GRPC_ENABLED=false # fixture/retrieval-only Python process가 같은 배포 단위에서 준비된 뒤만 true
# RAG v2는 v1 process와 별도 loopback secret/port/DB least-privilege roles를 사용한다.
RAG_V2_GRPC_ENABLED=false
RAG_V2_GRPC_TARGET=127.0.0.1:50054
RAG_V2_GRPC_BIND_ADDRESS=127.0.0.1:50054
RAG_V2_GRPC_SHARED_SECRET= # RAG_GRPC_SHARED_SECRET/JWT/DB capability와 다른 32byte 이상 purpose-separated secret
RAG_V2_QUERY_DATABASE_DSN= # decision_rag_query role만 사용; argv가 아닌 secret store에서 주입
CAPSTONE_RAG_WRITER_DATABASE_DSN= # decision_rag_writer role만 사용; public/owner staging 및 Voyage ledger 전용
CAPSTONE_RAG_ADMIN_DATABASE_DSN= # decision_rag_admin role만 사용; CAS activation/owner hard-delete 전용
CAPSTONE_RAG_LOCAL_ROOT= # 0700 local-only RAG control/cache root; Git 경로·raw path를 넣지 않음
CAPSTONE_RAG_BGE_PACKET_ROOT= # read-only pinned local BGE artifact root; provider URL을 넣지 않음
VOYAGE_API_KEY= # Voyage live는 privacy/billing evidence와 per-call local packet이 있을 때만 사용
RAG_V2_VERTEX_ENABLED=false
RAG_V2_VERTEX_HEAD_COMMIT=
RAG_V2_VERTEX_TREE_DIGEST=
RAG_V2_VERTEX_CI_DIGEST=
RAG_V2_VERTEX_SECURITY_DIGEST=
GOOGLE_APPLICATION_CREDENTIALS= # 0700 root 아래 0600 regular service-account JSON only; Developer API key 금지
GOOGLE_CLOUD_PROJECT=
BROKERAGE_GRPC_ENABLED=false # S3.1 기본 OFF. true는 별도 mock-provider wiring 승인 뒤에만 사용
BROKERAGE_GRPC_TARGET=127.0.0.1:50052
BROKERAGE_GRPC_SHARED_SECRET= # Spring↔Python brokerage loopback gRPC shared secret; secret store에서만 주입
BROKERAGE_GRPC_DEADLINE_MILLIS=45000 # 1..60000; 주문성 RPC는 자동 retry하지 않음
PYTHON_BROKERAGE_GRPC_BIND_ADDRESS=127.0.0.1:50052
KIS_MOCK_BROKERAGE_ONLINE_ENABLED=false # KIS_MOCK만 허용; 일반 개발/테스트와 KIS_LIVE는 계속 OFF
KIS_BROKERAGE_TOKEN_P_PHYSICAL_CAP= # exact bounded approval에서만 0 또는 1
KIS_BROKERAGE_PHYSICAL_CAP= # exact bounded approval에서만 1..32; 5-step probe는 정확히 5
S3_KIS_MOCK_EXACT_APPROVAL_ID= # schema v2 current-user unexpired exact approval latch; approval probe는 process env 대신 root .env(0600)에서만 읽음
S3_KIS_MOCK_EXACT_APPROVAL_SHA256= # schema v2 private 0600 approval packet canonical SHA-256; approval probe는 process env 대신 root .env(0600)에서만 읽음
DECISION_DISCLOSURE_READER_DATABASE_DSN= # decision_disclosure_reader의 bounded projection reader DSN; secret store에서만 주입
# 아래 DSN은 S2.3 sanitized offline fixture append 전용이다. 각 exact writer role을 사용하고 운영 DB에는 주입하지 않는다.
DECISION_SOURCE_WRITER_OFFLINE_TARGET= # local | offline | test | testcontainers
DECISION_MARKET_WRITER_DATABASE_DSN=
DECISION_PORTFOLIO_WRITER_DATABASE_DSN=
DECISION_RISK_WRITER_DATABASE_DSN=
DECISION_FILL_WRITER_DATABASE_DSN=
DECISION_COLLECTOR_DATABASE_DSN=
ASYNC_ADAPTER=db           # db | kafka
