POSTGRES_PASSWORD=
JWT_SECRET=                # 32byte 이상 랜덤
DEMO_USER_PASSWORD=
DEMO_ADMIN_PASSWORD=
KIS_MODE=mock              # mock | live (live는 S1.1에서 읽기 전용 시장데이터만)
KIS_OFFLINE=0              # 1이면 fixture 모드(S1.1)
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
KIS_MOCK_ACCOUNT_NO=       # S1.1 시장데이터에는 사용하지 않음
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=       # S1.1 시장데이터에는 사용하지 않음
KIS_RATE_LIMIT_PER_SECOND=1
KIS_DATA_DIR=data/kis
REDIS_URL=redis://localhost:6379/0
OPENDART_API_KEY=
ECOS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
OPENAI_API_KEY=
ASYNC_ADAPTER=db           # db | kafka
