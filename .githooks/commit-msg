#!/bin/sh
# AGENTS.md - 커밋과 PR 에 AI 도구 기여 표시를 남기지 않는다.
# 사람이 잊거나 에이전트 기본 동작이 되살아나도 생산 지점에서 막는다.
# 활성화: git config core.hooksPath .githooks
set -e

msg_file=$1
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

# 주석(#) 줄은 커밋 메시지에 들어가지 않으므로 검사에서 제외한다.
body=$(grep -v '^#' "$msg_file" || true)

# 패턴을 줄 시작에 고정한다. 실제 기여 표시는 항상 독립된 trailer 줄로 들어오고,
# 이 규칙을 설명하는 산문은 문장 중간에 그 문자열을 언급한다. 앵커가 없으면 규칙을
# 문서화하는 커밋 자체가 거부되어 규칙을 적을 수 없게 된다.
#
# 사람 공동작성자는 통과시킨다. AI 계정만 막는다.
# 맨 이메일 하나만으로는 막지 않는다 - author 신원은 CI 의 author 검사가 담당한다.
pattern='^[[:space:]]*[Cc]o-[Aa]uthored-[Bb]y:.*\(Claude\|Codex\|Copilot\|Gemini\|Devin\|noreply@anthropic\|noreply@openai\)'
pattern="$pattern\|^[[:space:]]*🤖\{0,1\}[[:space:]]*Generated with \[\{0,1\}\(Claude\|Codex\|Copilot\|Cursor\)"
pattern="$pattern\|^[[:space:]]*Assisted-by:.*\(Claude\|Codex\|Copilot\|Gemini\)"

found=$(printf '%s\n' "$body" | grep -in "$pattern" || true)

if [ -n "$found" ]; then
  echo "commit-msg: AI 기여 표시가 커밋 메시지에 있어 거부합니다 (AGENTS.md)." >&2
  echo "$found" >&2
  echo "" >&2
  echo "해당 줄을 지우고 다시 커밋하십시오." >&2
  exit 1
fi

exit 0
