#!/bin/sh
# CONTRIBUTING.md - 커밋과 PR 에는 사람 기여자만 남긴다.
# 자동 생성 서명이나 서비스 계정 공동작성자 표시는 생산 지점에서 막는다.
# 활성화: git config core.hooksPath .githooks
set -e

msg_file=$1
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

# 주석(#) 줄은 커밋 메시지에 들어가지 않으므로 검사에서 제외한다.
body=$(grep -v '^#' "$msg_file" || true)

# 패턴을 줄 시작에 고정한다. 실제 표시는 항상 독립된 trailer 줄로 들어오고,
# 이 규칙을 설명하는 산문은 문장 중간에 그 문자열을 언급한다.
#
# 사람 공동작성자(실제 이메일 또는 GitHub 사용자별 주소 1234+id@users.noreply.github.com)는
# 통과시킨다. noreply@ 서비스 주소 공동작성자, 자동 생성 서명, Assisted-by 표시는 거부한다.
pattern='^[[:space:]]*[Cc]o-[Aa]uthored-[Bb]y:.*<no-\{0,1\}reply@'
pattern="$pattern\|^[[:space:]]*[^[:alnum:][:space:]]\{0,4\}[[:space:]]*Generated with \["
pattern="$pattern\|^[[:space:]]*Assisted-by:"

# 리터럴 두 글자 \n 뒤에 붙은 trailer 도 같은 패턴으로 잡도록 펼친 사본을 함께 검사한다.
unfolded=$(printf '%s\n' "$body" | sed 's/\\n/\n/g')
found=$(printf '%s\n%s\n' "$body" "$unfolded" | grep -in "$pattern" || true)

if [ -n "$found" ]; then
  echo "commit-msg: 사람 기여자가 아닌 서명이 커밋 메시지에 있어 거부합니다 (CONTRIBUTING.md)." >&2
  echo "$found" >&2
  echo "" >&2
  echo "해당 줄을 지우고 다시 커밋하십시오." >&2
  exit 1
fi

exit 0
