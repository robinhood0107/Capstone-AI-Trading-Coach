#!/bin/sh
set -eu

cd "$(git rev-parse --show-toplevel)"
python3 .github/scripts/check-publication-paths.py --staged

scanner=${GITLEAKS_BIN:-gitleaks}
if [ "$scanner" = gitleaks ] && ! command -v "$scanner" >/dev/null 2>&1; then
    scanner=$HOME/.local/bin/gitleaks
fi
if ! command -v "$scanner" >/dev/null 2>&1; then
    printf '%s\n' 'pre-commit: install Gitleaks or set GITLEAKS_BIN before committing.' >&2
    exit 1
fi
exec "$scanner" git --staged --redact=100 --no-banner --config .gitleaks.toml --exit-code 1
