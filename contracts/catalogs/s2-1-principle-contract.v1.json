                            "type": "string"
                          }
                        },
                        "required": [
                          "field",
                          "reason"
                        ],
                        "type": "object"
                      },
                      "maxItems": 64,
                      "minItems": 1,
                      "type": "array"
                    }
                  },
                  "required": [
                    "violations"
                  ],
                  "type": "object"
                },
                "message": {
                  "const": "Request validation failed."
