                  "const": {}
                },
                "message": {
                  "const": "Authentication is required."
                }
              },
              "required": [
                "code",
                "message",
                "details"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "const": "FORBIDDEN"
                },
                "details": {
                  "const": {}
                },
                "message": {
                  "const": "Access is denied."
                }
              },
              "required": [
                "code",
                "message",
                "details"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "const": "NOT_FOUND"
                },
                "details": {
                  "const": {}
                },
                "message": {
                  "const": "Resource was not found."
                }
              },
              "required": [
                "code",
                "message",
                "details"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "const": "CONFLICT"
                },
                "details": {
                  "additionalProperties": false,
                  "properties": {
                    "currentVersion": {
                      "maximum": 2147483647,
                      "minimum": 1,
                      "type": "integer"
                    },
                    "expectedVersion": {
                      "maximum": 2147483647,
                      "minimum": 1,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "expectedVersion",
                    "currentVersion"
                  ],
                  "type": "object"
                },
                "message": {
                  "const": "Resource conflict."
                }
              },
              "required": [
                "code",
                "message",
                "details"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "const": "VERSION_EXHAUSTED"
