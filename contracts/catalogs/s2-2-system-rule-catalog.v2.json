{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "bounds": {
    "abstentionMaxItems": 50,
    "codeMaxChars": 128,
    "concurrencyMax": 8,
    "disclosureEventMaxItems": 100,
    "idMaxChars": 128,
    "issueMaxItems": 15,
    "messageMaxChars": 1024,
    "perPortLogicalCallMax": 1,
    "positionMaxItems": 1000,
    "requestMaxBytes": 262144,
    "responseMaxBytes": 1048576,
    "sourceDeadlineMillis": 500,
    "sourceRefMaxItems": 100,
    "sourceRefPattern": "^[0-9a-f]{64}$",
    "totalDeadlineMillis": 900,
    "violationMaxItems": 15,
    "warningMaxItems": 50
  },
  "canonicalization": {
    "arrayOrder": "EXPLICIT_STABLE_SORT_KEYS",
    "charset": "UTF-8",
    "decimalFormat": "PLAIN_NO_EXPONENT",
    "id": "HASH-CANONICALIZATION-S22-V3",
    "jsonWhitespace": "NONE",
    "negativeZero": "ZERO",
    "objectKeyOrder": "LEXICOGRAPHIC",
    "scaleStorage": "EXPLICIT_CATALOG_FIELD",
    "semanticInputExcludedFields": [
      "requestId",
      "evaluationId",
      "retrievedAt",
      "traceId",
      "inputArrayOrder"
    ],
    "semanticInputIncludedFields": [
      "snapshotSchemaVersion",
      "actorUserId",
      "evaluationAsOf",
      "principle",
      "systemRuleCatalogVersion",
      "readinessPolicyVersion",
      "portfolio",
      "orderIntent",
      "metrics",
      "requestedOptionalComponents",
      "observedOptionalComponentEvidence",
      "disclosureEvidence",
      "provenanceRefs"
    ],
    "semanticMetricSnapshotVersion": "s2.2-metric-snapshot-v3",
    "snapshotArtifactIncludedFields": [
      "*"
    ],
    "trailingZeros": "REMOVE"
  },
  "catalogId": "s2-2-system-rule-catalog",
  "catalogVersion": 2,
  "portfolioPolicy": {
    "contextUnavailableDecision": "HOLD",
    "invalidSelectorHttpStatus": 400,
    "invalidSelectorPublicCode": "VALIDATION_ERROR",
    "modes": [
      "KIS_MOCK",
      "INTERNAL_PAPER"
    ],
    "noAutomaticFallback": true,
    "selectionAuthority": "SERVER_OWNER_SCOPED",
    "storageMapping": {
      "INTERNAL_PAPER": "PAPER",
      "KIS_MOCK": "KIS_MOCK"
    }
  },
  "readinessPolicyVersion": "s2-2-readiness-v2",
  "resultPolicy": {
    "actions": [
      "ALLOW",
      "WARN",
      "HOLD",
      "BLOCK"
    ],
    "precedence": [
      "BLOCK",
      "HOLD",
      "WARN",
      "ALLOW"
    ],
    "requiredSourceFailureContainer": "issues",
    "thresholdViolationContainer": "violations",
    "unavailableOptionalEvidenceContainers": [
      "warnings",
      "abstentions"
    ]
  },
  "rules": [
