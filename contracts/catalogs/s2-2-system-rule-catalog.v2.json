      "freshnessPolicy": "PORTFOLIO_60S",
      "maximum": 1,
      "metric": "asset_weight",
      "minimum": 0,
      "operator": "<=",
      "order": 1,
      "ownership": "PUBLIC_PRINCIPLE",
      "ruleId": "max_position_per_asset",
