                      "const": "FINNHUB_PERSONAL_LOCAL"
                    }
                  },
                  "required": [
                    "laneId"
                  ],
                  "type": "object"
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "laneId": {
                      "const": "SEC_OFFICIAL"
                    }
                  },
                  "required": [
                    "laneId"
                  ],
                  "type": "object"
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "laneId": {
                      "const": "FED_OFFICIAL"
                    }
                  },
                  "required": [
                    "laneId"
                  ],
                  "type": "object"
                },
                "maxContains": 1,
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "laneId": {
                      "const": "GDELT_OFFLINE_REFERENCE"
