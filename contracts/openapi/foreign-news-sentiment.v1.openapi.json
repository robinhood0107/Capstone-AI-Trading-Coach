                  "const": "AVAILABLE"
                }
              }
            },
            "then": {
              "properties": {
                "lanes": {
                  "contains": {
                    "properties": {
                      "state": {
                        "const": "AVAILABLE"
                      }
                    },
                    "required": [
                      "state"
                    ],
                    "type": "object"
                  }
                }
              }
