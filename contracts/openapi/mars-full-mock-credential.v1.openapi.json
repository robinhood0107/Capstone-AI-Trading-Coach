{
  "openapi": "3.1.1",
  "info": {"title": "MARS full KIS_MOCK credential storage", "version": "0.1.0-draft"},
  "servers": [{"url": "https://mars.royaljellynas.org"}],
  "paths": {
    "/api/v1/brokerage/mock/credential": {
      "get": {
        "operationId": "readMockBrokerCredentialSummary",
        "summary": "Read only masked owner credential status",
        "responses": {
          "200": {"description": "Masked current owner status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StatusEnvelope"}}}},
          "401": {"description": "Bearer session invalid"}
        },
        "security": [{"bearerAuth": []}]
      },
      "put": {
        "operationId": "putMockBrokerCredential",
        "summary": "Encrypt exactly three owner-provided KIS_MOCK values",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PutMockCredential"}}}},
        "responses": {
          "204": {"description": "Encrypted storage completed; connectivity and certification remain separate"},
          "400": {"description": "Invalid or additional fields"},
          "401": {"description": "Bearer session invalid"},
          "409": {"description": "Armed or pending reconciliation prevents rotation"}
        },
        "security": [{"bearerAuth": []}]
      },
      "delete": {
        "operationId": "disconnectMockBrokerCredential",
        "summary": "Stop new calls and remove the current owner's encrypted credential after reconciliation clears",
        "responses": {
          "200": {"description": "Pending reconciliation retains the encrypted credential", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DisconnectPending"}}}},
          "204": {"description": "No pending recovery; encrypted credential removed"},
          "400": {"description": "Request body or query is not allowed"},
          "401": {"description": "Bearer session invalid"},
          "409": {"description": "Credential changed concurrently"}
        },
        "security": [{"bearerAuth": []}]
      }
    },
    "/api/v1/brokerage/mock/credential/connect": {
      "post": {
        "operationId": "verifyMockBrokerCredentialConnection",
        "summary": "Verify the current owner's mock account with one read-only balance probe",
        "responses": {
          "204": {"description": "Current owner credential marked CONNECTED; mock order certification remains separate"},
          "400": {"description": "Request body or query is not allowed"},
          "401": {"description": "Bearer session invalid"},
          "409": {"description": "Credential missing, rotated, disconnecting, or checked within the previous 60 seconds"},
          "503": {"description": "Brokerage or provider read unavailable"}
        },
        "security": [{"bearerAuth": []}]
      }
    },
    "/api/v1/brokerage/mock/credential/certify": {
      "post": {
        "operationId": "certifyMockBrokerCredential",
        "summary": "Run the server-fixed one-share KIS_MOCK order, cancellation, execution, and balance reconciliation for the current owner",
        "responses": {
          "200": {"description": "Certification result or explicit recovery state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CertificationOutcomeEnvelope"}}}},
          "400": {"description": "Request body or query is not allowed"},
          "401": {"description": "Bearer session invalid"},
          "409": {"description": "Credential missing, not connected, currently certifying, or revision changed"},
          "503": {"description": "Certification service unavailable"}
        },
        "security": [{"bearerAuth": []}]
      }
    },
    "/api/v1/brokerage/mock/credential/certify/recovery-confirm": {
      "post": {
        "operationId": "acknowledgeMockBrokerCertificationRecovery",
        "summary": "Clear only the recovery lock after the authenticated owner confirms provider-side order reconciliation",
        "responses": {
          "204": {"description": "Recovery lock cleared; credential remains CONNECTED and uncertified"},
          "400": {"description": "Request body or query is not allowed"},
          "401": {"description": "Bearer session invalid"},
          "409": {"description": "No owner-bound recovery attempt is awaiting acknowledgement"}
        },
        "security": [{"bearerAuth": []}]
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}},
    "schemas": {
      "DisconnectPending": {
        "type": "object", "additionalProperties": false,
        "required": ["state"],
        "properties": {"state": {"type": "string", "const": "DISCONNECTING"}}
      },
      "PutMockCredential": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appKey", "appSecret", "accountNo"],
        "properties": {
          "appKey": {"type": "string", "minLength": 8, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$", "writeOnly": true},
          "appSecret": {"type": "string", "minLength": 8, "maxLength": 512, "pattern": "^[!-~]+$", "writeOnly": true},
          "accountNo": {"type": "string", "pattern": "^[0-9]{10}$", "writeOnly": true}
        }
      },
      "StatusEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["success", "requestId", "data", "warnings", "error"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "requestId": {"type": "string"},
          "data": {"$ref": "#/components/schemas/MockCredentialRead"},
          "warnings": {"type": "array", "items": {"type": "object"}},
          "error": {"type": "null"}
        }
      },
      "MockCredentialRead": {
        "type": "object",
        "additionalProperties": false,
        "required": ["registered", "credential"],
        "properties": {
          "registered": {"type": "boolean"},
          "credential": {"oneOf": [{"$ref": "#/components/schemas/MockCredentialSummary"}, {"type": "null"}]}
        }
      },
      "MockCredentialSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accountId", "state", "revision", "appKeyLast4", "accountNoLast4", "connected", "certified", "certificationStatus", "certificationFailureCode", "certificationSessionDate"],
        "properties": {
          "accountId": {"type": "string", "pattern": "^acct_[0-9a-f]{32}$"},
          "state": {"type": "string", "enum": ["STORED", "CONNECTED", "CERTIFIED", "DISCONNECTING"]},
          "revision": {"type": "integer", "minimum": 1},
          "appKeyLast4": {"type": "string", "pattern": "^[A-Za-z0-9_-]{4}$"},
          "accountNoLast4": {"type": "string", "pattern": "^[0-9]{4}$"},
          "connected": {"type": "boolean"},
          "certified": {"type": "boolean"},
          "certificationStatus": {"type": "string", "enum": ["NOT_STARTED", "RUNNING", "RECOVERY_REQUIRED", "PASS", "FAILED"]},
          "certificationFailureCode": {"type": ["string", "null"], "enum": ["MARKET_CLOSED", "QUOTE_INVALID", "BUYABLE_UNAVAILABLE", "PROVIDER_FAILED", "TEST_ORDER_RECOVERED", "TEST_ORDER_UNCERTAIN", "EXECUTION_FILLED", "BALANCE_CHANGED", null]},
          "certificationSessionDate": {"type": ["string", "null"], "format": "date"}
        }
      },
      "CertificationOutcome": {
        "type": "object", "additionalProperties": false,
        "required": ["status", "certificationId", "sessionDate", "quoteCalls", "brokerageCalls", "tokenCalls", "failureCode"],
        "properties": {
          "status": {"type": "string", "enum": ["PASS", "FAILED", "RECOVERY_REQUIRED"]},
          "certificationId": {"type": ["string", "null"], "pattern": "^cert_[0-9a-f]{32}$"},
          "sessionDate": {"type": ["string", "null"], "format": "date"},
          "quoteCalls": {"type": "integer", "minimum": 0, "maximum": 1},
          "brokerageCalls": {"type": "integer", "minimum": 0, "maximum": 7},
          "tokenCalls": {"type": "integer", "minimum": 0, "maximum": 1},
          "failureCode": {"type": ["string", "null"], "enum": ["MARKET_CLOSED", "QUOTE_INVALID", "BUYABLE_UNAVAILABLE", "PROVIDER_FAILED", "TEST_ORDER_RECOVERED", "TEST_ORDER_UNCERTAIN", "EXECUTION_FILLED", "BALANCE_CHANGED", null]}
        }
      },
      "CertificationOutcomeEnvelope": {
        "type": "object", "additionalProperties": false,
        "required": ["success", "requestId", "data", "warnings", "error"],
        "properties": {
          "success": {"type": "boolean", "const": true},
          "requestId": {"type": "string"},
          "data": {"$ref": "#/components/schemas/CertificationOutcome"},
          "warnings": {"type": "array", "items": {"type": "object"}},
          "error": {"type": "null"}
        }
      }
    }
  }
}
