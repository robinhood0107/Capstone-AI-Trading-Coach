  "info": {
    "title": "Decision Platform API",
    "version": "0.0.1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "DB-backed demo credential을 검증하고 internal userId를 subject로 쓰는 Bearer JWT를 발급한다.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            },
            "description": "인증 성공 / Authenticated"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "요청 JSON/필드 검증 실패 / Invalid request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "동일한 login 실패 envelope / Invalid credential"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "로그인 시도 제한 / Login attempt limit"
          }
        },
        "security": [],
        "summary": "데모 사용자 로그인 / Demo user login",
        "tags": [
          "auth-controller"
        ]
      }
    },
    "/api/v1/principle-presets": {
      "get": {
        "operationId": "listPrinciplePresets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrinciplePresetListData"
                }
              }
            },
            "description": "Preset catalog"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrinciplePresetListData"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrinciplePresetListData"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "원칙 프리셋 조회 / List Principle presets",
        "tags": [
          "principle-controller"
        ]
      }
    },
    "/api/v1/principles": {
      "get": {
        "operationId": "listPrinciples",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "maxLength": 2048,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "format": "int32",
              "maximum": 200,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "enum": [
                "UPDATED_AT_DESC",
                "UPDATED_AT_ASC"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleOwnerListData"
                }
              }
            },
            "description": "Owned Principle page"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleOwnerListData"
                }
              }
            },
            "description": "Validation error"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleOwnerListData"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleOwnerListData"
                }
              }
            },
            "description": "Forbidden"
          }
        },
        "summary": "사용자 원칙 목록 / List owned Principles",
        "tags": [
          "principle-controller"
        ]
      },
      "post": {
        "operationId": "createPrinciple",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrincipleCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Validation error"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Forbidden"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Payload too large"
          }
        },
        "summary": "사용자 원칙 생성 / Create an owned Principle",
        "tags": [
          "principle-controller"
        ]
      }
    },
    "/api/v1/principles/{principleId}": {
      "get": {
        "operationId": "getPrinciple",
        "parameters": [
          {
            "in": "path",
            "name": "principleId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Current Principle"
