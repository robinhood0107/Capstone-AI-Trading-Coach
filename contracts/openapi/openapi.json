              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Missing or cross-owner"
          }
        },
        "summary": "사용자 원칙 상세 / Get an owned Principle",
        "tags": [
          "principle-controller"
        ]
      },
