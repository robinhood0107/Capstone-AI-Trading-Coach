              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponsePrincipleCurrent"
                }
              }
            },
            "description": "Missing or cross-owner"
