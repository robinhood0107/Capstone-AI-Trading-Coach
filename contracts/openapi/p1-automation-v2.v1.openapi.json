  "info": {
    "title": "P1 Automation Policy v2 additive contract",
    "version": "1.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v2/automation/arm": {
      "post": {
        "operationId": "armAutomationV2",
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 16,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArmAutomationV2Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAutomationStatusV2"
                }
              }
            },
            "description": "Success"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/P1AutomationV2ErrorResponse"
                }
              }
            },
            "description": "Blocked by incomplete qualified risk balance"
          }
        }
      }
    },
    "/api/v2/automation/policy": {
      "put": {
        "operationId": "putAutomationPolicyV2",
        "parameters": [
          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 16,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutAutomationPolicyV2Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAutomationPolicyV2"
                }
              }
            },
            "description": "Success"
          }
        }
