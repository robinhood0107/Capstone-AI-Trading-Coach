          {
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 16,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArmAutomationV3Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAutomationStatusV3"
                }
              }
            },
            "description": "Success"
          },
          "409": {
            "description": "Automation V3 readiness blocker"
          }
        }
      }
    },
    "/api/v3/automation/policy": {
