  "info": {
    "title": "Owner stop and Ridge return overlay",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/risk/kill-switch": {
      "get": {
        "description": "관리자 전용 전역 비상정지. 조회·정지·해제 모두 현재 ADMIN 권한을 검증한다.",
        "operationId": "getKillSwitch",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24KillSwitchSuccessResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24RiskErrorResponse"
                }
              }
            },
            "description": "Authentication is required."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24RiskErrorResponse"
                }
              }
            },
            "description": "Risk authority is unavailable."
          }
        },
        "summary": "현재 GLOBAL Kill Switch의 sanitized 상태를 DB에서 직접 조회한다.",
        "tags": [
          "risk-controller"
        ],
        "x-required-role": "ADMIN"
      },
      "post": {
        "description": "관리자 전용 전역 비상정지. 조회·정지·해제 모두 현재 ADMIN 권한을 검증한다.",
        "operationId": "changeKillSwitch",
        "parameters": [
          {
            "description": "16-128 bounded ASCII identifier. Raw value is handled only by the idempotency filter.",
            "in": "header",
            "name": "X-Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 16,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/S24KillSwitchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24KillSwitchSuccessResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24RiskErrorResponse"
                }
              }
            },
            "description": "Invalid body or idempotency key."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24RiskErrorResponse"
                }
              }
            },
            "description": "Authentication is required."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24RiskErrorResponse"
                }
              }
            },
            "description": "Only a current ADMIN can resume."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24RiskErrorResponse"
                }
              }
            },
            "description": "Concurrent generation conflict."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/S24RiskErrorResponse"
                }
              }
            },
            "description": "Risk authority is unavailable."
          }
        },
        "summary": "Kill Switch를 변경한다. USER는 활성화만, ADMIN은 활성화와 해제가 가능하다.",
        "tags": [
          "risk-controller"
        ],
        "x-required-role": "ADMIN"
      }
    },
    "/api/v2/risk/kill-switch": {
      "get": {
        "description": "인증된 본인만 제어한다. 전역 중지는 해제하지 않으며 해제 후 자동 재무장하지 않는다.",
