          },
          "collectionStatus": {
            "enum": [
              "COMPLETE",
              "PARTIAL",
              "COLLECTION_FAILED",
              "NOT_COLLECTED"
            ],
            "type": "string"
          },
          "contentSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "documentId": {
            "pattern": "^news_doc_[0-9a-f]{32}$",
            "type": "string"
          },
          "documentVersionId": {
            "pattern": "^news_ver_[0-9a-f]{32}$",
            "type": "string"
          },
          "externalLlmAllowed": {
            "type": "boolean"
          },
          "firstSeenAt": {
            "format": "date-time",
            "type": "string"
          },
          "identityStatus": {
            "enum": [
              "VERIFIED",
              "PROVIDER_ID_CONFLICT",
              "URL_HASH_CONFLICT"
            ],
            "type": "string"
          },
          "language": {
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
            "type": "string"
          },
          "lookupAllowed": {
            "const": true
          },
          "promptUntrusted": {
            "const": true
          },
          "provider": {
            "enum": [
              "GDELT_GQG",
              "GDELT_GEMG",
              "FINNHUB_MARKET_NEWS"
            ],
            "type": "string"
          },
          "providerDocumentId": {
            "maxLength": 256,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "providerObservedAt": {
            "format": "date-time",
            "type": "string"
          },
          "publicationStatus": {
            "enum": [
              "VERIFIED",
              "MISSING",
              "CONFLICT"
            ],
            "type": "string"
          },
          "publishedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "ragRetrievalAllowed": {
            "const": true
          },
          "republicationOfDocumentId": {
            "pattern": "^news_doc_[0-9a-f]{32}$",
            "type": [
              "string",
              "null"
            ]
          },
          "rightsProfile": {
            "enum": [
              "GDELT_METADATA_QUOTE",
              "FINNHUB_PERSONAL_LOCAL"
            ],
            "type": "string"
          },
          "sourceId": {
            "pattern": "^src_[a-z0-9][a-z0-9_-]{2,95}$",
            "type": "string"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "versionSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "availableAt",
          "boundedPassage",
          "boundedQuote",
          "canonicalUrl",
          "collectionStatus",
          "contentSha256",
          "documentId",
