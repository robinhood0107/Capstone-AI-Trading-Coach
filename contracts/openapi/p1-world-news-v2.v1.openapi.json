      "OwnerPerformanceReport": {
        "additionalProperties": false,
        "properties": {
          "lastFailureAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "lastFailureCode": {
            "pattern": "^[A-Z0-9_]{1,96}$",
            "type": [
              "string",
              "null"
            ]
          },
          "lastRefreshStatus": {
            "enum": [
              "SUCCESS",
              "FAILED_LAST_SUCCESS_PRESERVED"
            ]
