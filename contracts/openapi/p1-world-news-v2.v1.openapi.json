          "report": {
            "additionalProperties": false,
            "properties": {
              "contractId": {
                "const": "owner-performance-report.v1"
              },
              "correctionOfReportId": {
                "pattern": "^perf_report_[0-9a-f]{24}$",
                "type": [
                  "string",
                  "null"
                ]
              },
              "costBps": {
                "maximum": 10000,
                "minimum": 0,
                "type": "integer"
              },
              "generatedAt": {
                "format": "date-time",
                "type": "string"
              },
              "modelAdoption": {
                "additionalProperties": false,
                "properties": {
                  "automaticActivation": {
                    "const": false
                  },
                  "blockers": {
                    "items": {
                      "pattern": "^[A-Z0-9_]{1,96}$",
                      "type": "string"
                    },
                    "maxItems": 8,
                    "type": "array"
                  },
                  "candidateId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "currentModel": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "performanceAccepted": {
                    "type": "boolean"
                  },
                  "predictionAccepted": {
                    "type": "boolean"
                  },
                  "state": {
                    "enum": [
                      "RESEARCH_EVALUATED",
                      "SHADOW_DAILY",
                      "ACCEPTANCE_REVIEWED",
                      "CURRENT_MODEL"
                    ]
                  }
                },
                "required": [
                  "automaticActivation",
                  "blockers",
                  "candidateId",
                  "currentModel",
                  "performanceAccepted",
                  "predictionAccepted",
                  "state"
                ],
                "type": "object"
              },
              "modelSha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "principleVersion": {
                "minimum": 1,
                "type": "integer"
              },
              "principleVersionId": {
                "pattern": "^pvr_[A-Za-z0-9_-]{8,96}$",
                "type": "string"
              },
              "reportId": {
                "pattern": "^perf_report_[0-9a-f]{24}$",
                "type": "string"
              },
              "reportVersion": {
                "minimum": 1,
                "type": "integer"
              },
              "sections": {
                "additionalProperties": false,
                "properties": {
                  "actualTrading": {
                    "additionalProperties": false,
                    "properties": {
                      "closedPositionCount": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "openPositionCount": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "realizedPnlKrw": {
                        "type": "integer"
                      },
                      "status": {
                        "enum": [
                          "NO_REALIZED_TRADES",
                          "REALIZED"
                        ]
                      },
                      "unrealizedStatus": {
                        "enum": [
                          "NONE",
                          "OPEN"
                        ]
                      }
                    },
                    "required": [
                      "closedPositionCount",
                      "openPositionCount",
                      "realizedPnlKrw",
                      "status",
                      "unrealizedStatus"
                    ],
                    "type": "object"
                  },
                  "fixedDailyForecast": {
                    "additionalProperties": false,
                    "properties": {
                      "bias": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "mae": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "pendingCount": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "realizedCount": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "rmse": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "status": {
                        "enum": [
                          "NOT_AVAILABLE",
                          "PARTIAL",
                          "REALIZED"
                        ]
                      },
                      "totalCount": {
                        "minimum": 0,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "bias",
                      "mae",
                      "pendingCount",
                      "realizedCount",
                      "rmse",
                      "status",
                      "totalCount"
                    ],
                    "type": "object"
                  },
                  "recalculatedBacktest": {
                    "additionalProperties": false,
                    "properties": {
                      "baselineNetReturn": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "guideNetReturn": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "status": {
                        "const": "RECALCULATED"
                      },
                      "strictNetReturn": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "baselineNetReturn",
                      "guideNetReturn",
                      "status",
                      "strictNetReturn"
                    ],
                    "type": "object"
                  }
                },
                "required": [
                  "actualTrading",
                  "fixedDailyForecast",
                  "recalculatedBacktest"
                ],
                "type": "object"
              },
              "sourceEnd": {
                "format": "date",
                "type": "string"
              },
              "sourceGenerationSha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "sourceStart": {
                "const": "2026-08-18"
              },
              "supersedesReportId": {
                "pattern": "^perf_report_[0-9a-f]{24}$",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "contractId",
              "correctionOfReportId",
              "costBps",
              "generatedAt",
              "modelAdoption",
              "modelSha256",
              "principleVersion",
              "principleVersionId",
              "reportId",
              "reportVersion",
              "sections",
              "sourceEnd",
              "sourceGenerationSha256",
              "sourceStart",
              "supersedesReportId"
            ],
            "type": "object"
          }
        },
        "required": [
          "lastFailureAt",
          "lastFailureCode",
          "lastRefreshStatus",
          "report"
        ],
        "type": "object"
      },
