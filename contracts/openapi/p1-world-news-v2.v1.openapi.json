      "WorldNewsV2Item": {
        "$id": "contracts/schemas/world-news-v2.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "publicationStatus": {
                  "const": "MISSING"
                }
              }
            },
            "then": {
              "properties": {
                "publishedAt": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "publicationStatus": {
                  "const": "VERIFIED"
                }
              }
            },
            "then": {
              "properties": {
                "publishedAt": {
                  "format": "date-time",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "rightsProfile": {
                  "const": "FINNHUB_PERSONAL_LOCAL"
                }
              }
            },
            "then": {
              "properties": {
                "externalLlmAllowed": {
                  "const": false
                }
              }
            }
          }
        ],
        "properties": {
          "availableAt": {
            "format": "date-time",
            "type": "string"
          },
          "boundedPassage": {
            "maxLength": 1200,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
          "boundedQuote": {
            "maxLength": 600,
            "minLength": 1,
            "type": [
              "string",
              "null"
            ]
          },
