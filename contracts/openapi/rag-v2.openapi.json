                    "canonicalUrl": {
                      "format": "uri",
                      "maxLength": 2048,
                      "pattern": "^https://",
                      "type": "string"
                    },
                    "citationKind": {
                      "const": "PUBLIC_WEB"
                    },
                    "locator": {
                      "additionalProperties": false,
                      "anyOf": [
                        {
                          "required": [
                            "page"
                          ]
                        },
                        {
                          "required": [
                            "slide"
                          ]
                        },
                        {
                          "required": [
                            "sheet"
                          ]
                        },
                        {
                          "required": [
                            "section"
                          ]
                        }
                      ],
                      "properties": {
                        "page": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "section": {
                          "maxLength": 300,
                          "minLength": 1,
                          "type": "string"
                        },
                        "sheet": {
                          "maxLength": 128,
                          "minLength": 1,
                          "type": "string"
                        },
                        "slide": {
                          "minimum": 1,
                          "type": "integer"
                        }
                      },
                      "required": [],
                      "type": "object"
                    },
                    "sourceId": {
                      "pattern": "^src_[a-z0-9][a-z0-9_-]{2,95}$",
                      "type": "string"
                    },
                    "title": {
                      "maxLength": 500,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "citationKind",
                    "sourceId",
                    "title",
                    "canonicalUrl",
                    "locator"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "citationKind": {
                      "const": "LOCAL_DOCUMENT"
                    },
                    "displayName": {
                      "maxLength": 160,
                      "minLength": 1,
                      "pattern": "^[^/\\\\:]+$",
                      "type": "string"
                    },
                    "documentId": {
                      "pattern": "^doc_[a-z0-9][a-z0-9_-]{10,95}$",
                      "type": "string"
                    },
                    "locator": {
                      "additionalProperties": false,
                      "anyOf": [
                        {
                          "required": [
                            "page"
                          ]
