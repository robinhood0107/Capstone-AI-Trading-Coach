{
  "components": {
    "schemas": {
      "RagV2Answer": {
        "$id": "contracts/schemas/s4-rag-v2-answer.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "answer": {
            "oneOf": [
              {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "answerId": {
            "oneOf": [
              {
                "pattern": "^rag_[A-Za-z0-9_-]{12,96}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "citationCoverage": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "citations": {
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "canonicalUrl": {
                      "format": "uri",
                      "maxLength": 2048,
                      "pattern": "^https://",
                      "type": "string"
                    },
                    "citationKind": {
                      "const": "PUBLIC_WEB"
                    },
                    "locator": {
                      "additionalProperties": false,
                      "anyOf": [
                        {
                          "required": [
                            "page"
                          ]
                        },
                        {
                          "required": [
                            "slide"
                          ]
                        },
                        {
                          "required": [
                            "sheet"
                          ]
                        },
                        {
                          "required": [
                            "section"
                          ]
                        }
                      ],
                      "properties": {
                        "page": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "section": {
                          "maxLength": 300,
                          "minLength": 1,
                          "type": "string"
                        },
                        "sheet": {
                          "maxLength": 128,
                          "minLength": 1,
                          "type": "string"
                        },
                        "slide": {
                          "minimum": 1,
                          "type": "integer"
                        }
                      },
                      "required": [],
                      "type": "object"
                    },
                    "sourceId": {
                      "pattern": "^src_[a-z0-9][a-z0-9_-]{2,95}$",
                      "type": "string"
                    },
                    "title": {
                      "maxLength": 500,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "citationKind",
                    "sourceId",
                    "title",
                    "canonicalUrl",
                    "locator"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "citationKind": {
                      "const": "LOCAL_DOCUMENT"
                    },
                    "displayName": {
                      "maxLength": 160,
                      "minLength": 1,
                      "pattern": "^[^/\\\\:]+$",
                      "type": "string"
                    },
                    "documentId": {
                      "pattern": "^doc_[a-z0-9][a-z0-9_-]{10,95}$",
                      "type": "string"
                    },
                    "locator": {
                      "additionalProperties": false,
                      "anyOf": [
                        {
                          "required": [
                            "page"
                          ]
                        },
                        {
                          "required": [
                            "slide"
                          ]
                        },
                        {
                          "required": [
                            "sheet"
                          ]
                        },
                        {
                          "required": [
                            "section"
                          ]
                        }
                      ],
                      "properties": {
                        "page": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "section": {
                          "maxLength": 300,
                          "minLength": 1,
                          "type": "string"
                        },
                        "sheet": {
                          "maxLength": 128,
                          "minLength": 1,
                          "type": "string"
                        },
                        "slide": {
                          "minimum": 1,
                          "type": "integer"
                        }
                      },
                      "required": [],
                      "type": "object"
                    }
                  },
                  "required": [
                    "citationKind",
                    "documentId",
                    "displayName",
                    "locator"
                  ],
                  "type": "object"
                }
              ]
            },
            "maxItems": 5,
            "type": "array"
          },
          "generationStatus": {
            "enum": [
              "ANSWERED",
              "RETRIEVAL_ONLY",
              "RETRIEVAL_FAILURE",
              "BLOCKED_SENSITIVE",
              "BLOCKED_ADVICE",
              "GENERATION_UNAVAILABLE"
            ]
          },
          "guardrailFlags": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array",
            "uniqueItems": true
          },
          "requestId": {
            "pattern": "^req_[A-Za-z0-9_-]{12,96}$",
            "type": "string"
          },
          "retrievalFailure": {
            "type": "boolean"
          }
        },
        "required": [
          "requestId",
          "answerId",
          "generationStatus",
          "answer",
          "citationCoverage",
          "citations",
          "retrievalFailure",
          "guardrailFlags"
        ],
        "title": "s4-rag-v2-answer",
        "type": "object"
      },
      "RagV2AskRequest": {
        "$id": "contracts/schemas/s4-rag-v2-ask-request.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "answerMode": {
            "enum": [
              "CONCISE",
              "DETAILED"
            ]
          },
          "question": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "relatedSymbols": {
            "items": {
              "pattern": "^[0-9]{6}$",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array",
            "uniqueItems": true
          },
          "topics": {
            "items": {
              "enum": [
                "API",
                "DATA",
                "FINANCIAL_ENGINEERING",
                "METHODOLOGY",
                "PRODUCT_RISK",
                "RISK"
              ]
            },
            "maxItems": 5,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "question",
          "answerMode"
        ],
        "title": "S4 RAG public ask request v2",
        "type": "object"
      },
      "RagV2CorpusStatus": {
        "$id": "contracts/schemas/s4-rag-v2-corpus-status.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "failureCode": {
            "oneOf": [
              {
                "enum": [
                  "DOWNLOAD_UNAVAILABLE",
                  "SOURCE_DRIFT",
                  "PARSER_FAILED",
                  "OCR_QUALITY_FAILED",
                  "EMBEDDING_FAILED",
                  "DISK_FULL",
                  "ACTIVATION_CONFLICT"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "privateOverlayState": {
            "enum": [
              "ABSENT",
              "BUILDING",
              "READY",
              "FAILED"
            ]
          },
          "progressPercent": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "publicCorpusVersion": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "state": {
            "enum": [
              "CORE_READY",
              "BUILDING",
              "FULL_READY",
              "FAILED"
            ]
          }
        },
        "required": [
          "state",
          "publicCorpusVersion",
          "privateOverlayState",
          "progressPercent",
          "failureCode"
        ],
        "title": "s4-rag-v2-corpus-status",
        "type": "object"
      },
      "RagV2Error": {
        "$id": "contracts/schemas/s4-rag-v2-error.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "CORPUS_NOT_READY",
              "RAG_VALIDATION_FAILED",
              "RAG_HISTORY_NOT_FOUND",
              "RAG_UNAVAILABLE"
            ]
          },
          "message": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "requestId": {
            "pattern": "^req_[A-Za-z0-9_-]{12,96}$",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "s4-rag-v2-error",
        "type": "object"
      },
      "RagV2HistoryDetail": {
