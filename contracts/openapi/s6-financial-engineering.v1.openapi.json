          "exerciseStyle": {
            "const": "EUROPEAN"
          },
          "multiplier": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "settlementType": {
            "const": "CASH"
          },
          "sourceHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "sourceUrl": {
            "format": "uri",
            "type": "string"
          },
          "termsId": {
            "type": "string"
          },
          "timezone": {
            "const": "Asia/Seoul"
          }
        },
        "required": [
          "termsId",
          "sourceUrl",
          "sourceHash",
          "multiplier",
          "exerciseStyle",
          "settlementType",
          "timezone"
        ],
        "type": "object"
      },
      "S64ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "properties": {
              "code": {
                "enum": [
                  "VALIDATION_ERROR",
                  "PYTHON_SERVICE_UNAVAILABLE"
                ]
