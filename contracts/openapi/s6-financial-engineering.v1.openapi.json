          "dividendYield": {
            "type": "number"
          },
          "riskFreeRate": {
            "type": "number"
          },
          "spot": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "valuationAt": {
            "format": "date-time",
            "type": "string"
          },
          "volatility": {
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "contractId",
          "valuationAt",
          "spot",
          "riskFreeRate",
          "dividendYield",
          "volatility"
        ],
        "type": "object"
      },
