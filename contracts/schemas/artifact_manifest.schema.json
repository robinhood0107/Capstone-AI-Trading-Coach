{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/artifact_manifest.schema.json",
  "title": "Artifact Manifest",
  "description": "Manifest for workspace artifact bundles exchanged under artifacts/{workspace}/{runId}/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "producerWorkspace", "schemaVersion", "createdAt", "universeId", "period", "timeframe", "files", "status"],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-run-\\d{3}$"
    },
    "producerWorkspace": {
      "type": "string",
      "enum": ["return-engine", "decision-platform"]
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "universeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "timeframe": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["1d", "60m"]
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "REJECTED"]
    }
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trainStart", "trainEnd", "testStart", "testEnd"],
      "properties": {
        "trainStart": {
          "type": "string",
          "format": "date"
        },
        "trainEnd": {
          "type": "string",
          "format": "date"
        },
        "testStart": {
          "type": "string",
          "format": "date"
        },
        "testEnd": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema", "rowCount", "sha256", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "pattern": "^contracts/schemas/[A-Za-z0-9_]+\\.schema\\.json$"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
