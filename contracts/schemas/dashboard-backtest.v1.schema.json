                  "enum": [
                    "REAL_ARTIFACT",
                    "SYNTHETIC_FAKE_E2E"
                  ]
                },
                "heatmap": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "month": {
                        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                        "type": "string"
                      },
                      "return": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "month",
                      "return"
                    ],
                    "type": "object"
                  },
                  "maxItems": 120,
                  "type": "array"
                },
                "metricCards": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "metric": {
                        "maxLength": 48,
                        "type": "string"
                      },
                      "value": {
                        "oneOf": [
                          {
                            "type": "number"
                          },
