                              "oneOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "var95": {
                              "oneOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "cagr",
                            "mdd",
                            "sharpe",
                            "sortino",
                            "var95",
                            "cvar95"
                          ],
                          "type": "object"
                        },
                        "strategy": {
                          "const": "Baseline"
