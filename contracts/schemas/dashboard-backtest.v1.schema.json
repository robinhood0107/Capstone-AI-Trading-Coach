                  "type": "string"
                },
                "runId": {
                  "pattern": "^(run|demo)_[A-Za-z0-9_-]{8,96}$",
                  "type": "string"
                },
                "strategies": {
                  "items": false,
                  "maxItems": 3,
                  "minItems": 3,
