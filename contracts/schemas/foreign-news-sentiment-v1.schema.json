{
  "$id": "contracts/schemas/foreign-news-sentiment-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "AVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "lanes": {
            "contains": {
              "properties": {
                "state": {
                  "const": "AVAILABLE"
                }
              },
              "required": [
                "state"
              ],
              "type": "object"
            }
          }
        }
      }
    }
  ],
  "properties": {
    "allowedUses": {
      "items": false,
      "maxItems": 1,
      "minItems": 1,
      "prefixItems": [
        {
          "const": "EXPLANATION_ONLY"
        }
      ],
      "type": "array"
    },
    "articleMetadataStored": {
      "const": false
    },
    "asOf": {
      "format": "date-time",
      "type": "string"
    },
    "contractId": {
      "const": "foreign-news-sentiment-v1"
    },
    "decisionAuthority": {
      "const": "NONE"
    },
    "lanes": {
      "allOf": [
        {
          "contains": {
            "properties": {
              "laneId": {
                "const": "FINNHUB_PERSONAL_LOCAL"
              }
            },
            "required": [
              "laneId"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "laneId": {
                "const": "SEC_OFFICIAL"
              }
            },
            "required": [
              "laneId"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "laneId": {
                "const": "FED_OFFICIAL"
              }
            },
            "required": [
              "laneId"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        },
        {
          "contains": {
            "properties": {
              "laneId": {
                "const": "GDELT_OFFLINE_REFERENCE"
              }
            },
            "required": [
              "laneId"
            ],
            "type": "object"
          },
          "maxContains": 1,
          "minContains": 1
        }
      ],
      "items": {
        "additionalProperties": false,
        "properties": {
          "laneId": {
            "enum": [
              "FINNHUB_PERSONAL_LOCAL",
              "SEC_OFFICIAL",
              "FED_OFFICIAL",
              "GDELT_OFFLINE_REFERENCE"
            ]
          },
          "state": {
            "enum": [
              "AVAILABLE",
              "ABSTAIN",
              "NOT_ACTIVATED"
            ]
          }
        },
        "required": [
          "laneId",
          "state"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "rawProviderDataStored": {
      "const": false
    },
    "riskDecisionHashIncluded": {
      "const": false
    },
    "s5FeatureEligible": {
      "const": false
    },
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "AVAILABLE",
        "ABSTAIN"
      ]
    },
    "symbol": {
      "pattern": "^[0-9A-Z._:-]{1,20}$",
      "type": "string"
    }
  },
  "required": [
    "contractId",
    "allowedUses",
    "articleMetadataStored",
    "asOf",
    "decisionAuthority",
    "lanes",
    "rawProviderDataStored",
    "riskDecisionHashIncluded",
    "s5FeatureEligible",
    "schemaVersion",
    "status",
    "symbol"
  ],
  "title": "foreign-news-sentiment-v1",
  "type": "object"
}
