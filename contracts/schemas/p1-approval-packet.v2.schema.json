{
  "$id": "contracts/schemas/p1-approval-packet.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedOperations": {
      "items": false,
      "maxItems": 6,
      "minItems": 6,
      "prefixItems": [
        {
          "const": "KRX_KOSPI_DAILY"
        },
        {
          "const": "KRX_KOSDAQ_DAILY"
        },
        {
          "const": "KIS_CURRENT_PRICE"
        },
        {
          "const": "KIS_DAILY_BAR"
        },
        {
          "const": "ECOS_POLICY_RATE_DAILY"
        },
        {
          "const": "ECOS_KRW_USD_DAILY"
        }
      ],
      "type": "array"
    },
    "approvalId": {
      "pattern": "^[A-Z0-9][A-Z0-9._-]{7,95}$",
      "type": "string"
    },
    "contractId": {
      "const": "p1-approval-packet.v2"
    },
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "headSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "issuerKeyId": {
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "physicalCallCap": {
      "enum": [
        6,
        7
      ]
    },
    "reasonCode": {
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
      "type": "string"
    },
    "signature": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "type": "string"
    },
    "target": {
      "additionalProperties": false,
      "properties": {
        "ecosFrom": {
          "format": "date",
          "type": "string"
        },
        "ecosTo": {
          "format": "date",
          "type": "string"
        },
        "sessionDate": {
          "format": "date",
          "type": "string"
        },
        "symbol": {
          "const": "005930"
        }
      },
      "required": [
        "ecosFrom",
        "ecosTo",
        "sessionDate",
        "symbol"
      ],
      "type": "object"
    },
    "treeSha": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "contractId",
    "approvalId",
    "nonce",
    "issuerKeyId",
    "allowedOperations",
    "physicalCallCap",
    "headSha",
    "treeSha",
    "expiresAt",
    "reasonCode",
    "target",
    "signature"
  ],
  "title": "p1-approval-packet.v2",
  "type": "object"
}
