{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/contracts/p1-public-rag-seed-manifest.v1.schema.json",
  "title": "P1 Public RAG Seed Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archiveSha256",
    "archiveSizeBytes",
    "contractId",
    "embeddingDimension",
    "expectedChunkCount",
    "expectedSourceCount",
    "formatVersion",
    "maxPartBytes",
    "parts",
    "pointer",
    "profileId",
    "sourceFlywaySchemaVersion",
    "tableColumns",
    "tableCounts",
    "tableOrder",
    "targetFlywaySchemaVersion"
  ],
  "properties": {
    "archiveSha256": { "$ref": "#/$defs/sha256" },
    "archiveSizeBytes": { "type": "integer", "minimum": 1 },
    "contractId": { "const": "p1-public-rag-seed.v1" },
    "embeddingDimension": { "const": 1024 },
    "expectedChunkCount": { "const": 7871 },
    "expectedSourceCount": { "const": 142 },
    "formatVersion": { "const": 1 },
    "maxPartBytes": { "const": 33554432 },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/part" }
    },
    "pointer": { "$ref": "#/$defs/pointer" },
    "profileId": { "const": "voyage_context_4_1024_v1" },
    "sourceFlywaySchemaVersion": { "const": "73" },
    "tableColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rag_v2_immutable_source_revisions",
        "rag_v2_immutable_oa_source_cards",
        "rag_v2_immutable_chunks",
        "rag_v2_immutable_component_generations",
        "rag_v2_immutable_generation_memberships",
        "rag_v2_immutable_generation_embeddings",
        "rag_v2_immutable_public_voyage_component_manifests",
        "rag_v2_immutable_public_voyage_component_evaluations",
        "rag_v2_immutable_public_bundle_pointers"
      ],
      "patternProperties": {
        "^rag_v2_immutable_[a-z0-9_]+$": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
        }
      }
    },
    "tableCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rag_v2_immutable_source_revisions",
        "rag_v2_immutable_oa_source_cards",
        "rag_v2_immutable_chunks",
        "rag_v2_immutable_component_generations",
        "rag_v2_immutable_generation_memberships",
        "rag_v2_immutable_generation_embeddings",
        "rag_v2_immutable_public_voyage_component_manifests",
        "rag_v2_immutable_public_voyage_component_evaluations",
        "rag_v2_immutable_public_bundle_pointers"
      ],
      "properties": {
        "rag_v2_immutable_source_revisions": { "const": 142 },
        "rag_v2_immutable_oa_source_cards": { "const": 112 },
        "rag_v2_immutable_chunks": { "const": 7871 },
        "rag_v2_immutable_component_generations": { "const": 2 },
        "rag_v2_immutable_generation_memberships": { "const": 7871 },
        "rag_v2_immutable_generation_embeddings": { "const": 7871 },
        "rag_v2_immutable_public_voyage_component_manifests": { "const": 2 },
        "rag_v2_immutable_public_voyage_component_evaluations": { "const": 2 },
        "rag_v2_immutable_public_bundle_pointers": { "const": 1 }
      }
    },
    "tableOrder": {
      "const": [
        "rag_v2_immutable_source_revisions",
        "rag_v2_immutable_oa_source_cards",
        "rag_v2_immutable_chunks",
        "rag_v2_immutable_component_generations",
        "rag_v2_immutable_generation_memberships",
        "rag_v2_immutable_generation_embeddings",
        "rag_v2_immutable_public_voyage_component_manifests",
        "rag_v2_immutable_public_voyage_component_evaluations",
        "rag_v2_immutable_public_bundle_pointers"
      ]
    },
    "targetFlywaySchemaVersion": { "const": "87" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "ordinal", "sha256", "sizeBytes"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^public-rag-seed\\.v1\\.jsonl\\.gz\\.part-[0-9]{4}$"
        },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 }
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embeddingProfileId",
        "exact30GenerationId",
        "oa112GenerationId",
        "pointerVersion",
        "state",
        "stateId"
      ],
      "properties": {
        "embeddingProfileId": { "const": "voyage_context_4_1024_v1" },
        "exact30GenerationId": { "type": "string", "pattern": "^rgr_[0-9a-f]{32}$" },
        "oa112GenerationId": { "type": "string", "pattern": "^rgr_[0-9a-f]{32}$" },
        "pointerVersion": { "type": "integer", "minimum": 1 },
        "state": { "const": "ACTIVE" },
        "stateId": { "const": "default" }
      }
    }
  }
}
