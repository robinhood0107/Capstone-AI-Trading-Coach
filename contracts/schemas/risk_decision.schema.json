        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "source"
      ],
      "type": "object"
    },
    "riskItem": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "metric": {
                    "const": "disclosure_risk_score"
                  }
                },
                "required": [
                  "metric"
                ]
              },
              {
                "properties": {
                  "source": {
                    "const": "OPENDART"
                  }
                },
                "required": [
                  "source"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "metric": {
                "const": "disclosure_risk_score"
              },
              "source": {
                "const": "OPENDART"
              },
              "value": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              }
            },
            "required": [
              "metric",
              "value",
              "severity",
              "source",
              "eventCodes",
              "mappingVersion",
              "sourceRefs"
            ]
          }
        }
      ],
      "properties": {
        "eventCodes": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "mappingVersion": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "metric": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "severity": {
          "enum": [
            "ALLOW",
            "WARN",
            "BLOCK"
          ]
        },
        "source": {
          "enum": [
            "OPENDART",
            "KIS",
            "NEWS",
            "MACRO",
            "INTERNAL"
          ]
        },
        "sourceRefs": {
          "items": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "severity",
        "source"
      ],
      "type": "object"
    },
    "violation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "ruleId": {
                "const": "high_volatility_guard"
              }
            },
            "required": [
              "ruleId"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "BLOCK"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ruleId": {
                "const": "hmm_risk_off_guard"
              }
            },
            "required": [
              "ruleId"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "WARN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ruleId": {
                "const": "mean_reversion_warning"
              }
            },
            "required": [
              "ruleId"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "WARN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ruleId": {
                "const": "etf_etn_risk_check"
              }
            },
            "required": [
              "ruleId"
            ]
          },
          "then": {
            "properties": {
              "severity": {
                "const": "WARN"
              }
            }
          }
        }
      ],
      "properties": {
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "metricValue": {
          "type": "number"
        },
        "ruleId": {
          "enum": [
            "max_position_per_asset",
            "max_gold_etf_etn_weight",
            "max_single_order_amount",
            "daily_loss_guard",
            "mdd_guard",
            "max_daily_orders",
            "negative_news_guard",
            "disclosure_risk_guard",
            "high_volatility_guard",
            "hmm_risk_off_guard",
            "mean_reversion_warning",
            "etf_etn_risk_check"
          ],
          "maxLength": 128,
          "type": "string"
        },
        "severity": {
          "enum": [
            "WARN",
            "BLOCK"
          ]
        },
        "threshold": {
          "type": "number"
        }
      },
      "required": [
        "ruleId",
        "severity",
        "message",
        "metricValue",
        "threshold"
      ],
      "type": "object"
    },
    "warning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "MODEL_ABSTAINED",
            "OPTIONAL_EVIDENCE_ERROR",
            "OPTIONAL_EVIDENCE_INCOMPLETE",
            "OPTIONAL_EVIDENCE_MISSING",
            "OPTIONAL_EVIDENCE_STALE"
          ],
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "ruleId": {
          "enum": [
            "max_position_per_asset",
            "max_gold_etf_etn_weight",
            "max_single_order_amount",
            "daily_loss_guard",
            "mdd_guard",
            "max_daily_orders",
            "negative_news_guard",
            "disclosure_risk_guard",
