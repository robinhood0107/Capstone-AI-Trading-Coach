      ],
      "type": "object"
    }
  },
  "$id": "contracts/schemas/risk_decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ALLOW"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "abstentions": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/abstention"
                },
                {
                  "properties": {
                    "disposition": {
                      "const": "NOT_APPLICABLE"
                    }
                  }
                }
              ]
            },
            "maxItems": 50,
            "type": "array"
          },
          "canSubmitOrder": {
            "const": true
          },
          "issues": {
            "maxItems": 0
          },
          "violations": {
            "maxItems": 0
          },
          "warnings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "WARN"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "warnings": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "abstentions": {
                "contains": {
                  "properties": {
                    "disposition": {
                      "const": "ABSTAIN"
                    }
                  },
                  "required": [
                    "disposition"
                  ],
                  "type": "object"
                },
                "minContains": 1
              }
            }
          }
        ],
        "not": {
          "properties": {
            "violations": {
              "contains": {
                "properties": {
                  "severity": {
                    "const": "BLOCK"
                  }
                },
                "required": [
                  "severity"
                ],
                "type": "object"
              },
              "minContains": 1
            }
          },
          "required": [
            "violations"
          ]
        },
        "properties": {
          "canSubmitOrder": {
            "const": true
          },
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "HOLD"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "not": {
          "properties": {
            "violations": {
              "contains": {
                "properties": {
                  "severity": {
                    "const": "BLOCK"
                  }
                },
                "required": [
                  "severity"
                ],
                "type": "object"
              },
              "minContains": 1
            }
          }
        },
        "properties": {
          "canSubmitOrder": {
            "const": false
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "BLOCK"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "canSubmitOrder": {
            "const": false
          },
          "violations": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "BLOCK"
                }
              },
              "required": [
                "severity"
              ],
              "type": "object"
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "properties": {
    "abstentions": {
      "items": {
        "$ref": "#/$defs/abstention"
      },
      "maxItems": 50,
      "type": "array"
    },
    "canSubmitOrder": {
      "type": "boolean"
    },
    "catalogVersion": {
      "const": 1
    },
    "decision": {
      "enum": [
        "ALLOW",
        "WARN",
        "HOLD",
        "BLOCK"
      ]
    },
    "decisionId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "evaluationId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "explanation": {
      "additionalProperties": false,
      "properties": {
        "citationIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "shortText": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "shortText",
        "citationIds"
      ],
      "type": "object"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/issue"
      },
      "maxItems": 14,
      "type": "array"
    },
    "mode": {
      "enum": [
        "GUIDE",
        "STRICT"
      ]
    },
    "portfolioSource": {
      "enum": [
        "KIS_MOCK",
        "INTERNAL_PAPER"
      ]
    },
    "principleVersion": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
    },
    "principleVersionId": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "readinessPolicyVersion": {
      "const": "s2-2-readiness-v1"
    },
    "riskItems": {
      "items": {
        "$ref": "#/$defs/riskItem"
      },
      "maxItems": 50,
      "type": "array"
    },
    "riskSummary": {
      "additionalProperties": false,
      "properties": {
        "cvar95": {
          "type": "number"
        },
        "hmmRegime": {
          "enum": [
            "NORMAL",
            "SIDEWAYS",
            "HIGH_VOLATILITY",
            "RISK_OFF",
            "RISK_ON"
          ]
        },
        "mdd": {
          "type": "number"
        },
        "regimeProbability": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "var95": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "schemaVersion": {
      "const": "s2-2-risk-decision/v1"
    },
    "semanticInputHash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "signalSummary": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "finalSignal": {
          "enum": [
            "BUY_STRONG",
            "BUY_WEAK",
            "BUY",
            "HOLD",
            "SELL",
            "SELL_WEAK",
            "SELL_STRONG"
          ]
        },
        "lightgbmSignal": {
          "enum": [
            "BUY",
            "SELL",
            "HOLD"
          ]
        },
        "lstmSignal": {
          "enum": [
            "BUY",
            "SELL",
            "HOLD"
          ]
        },
        "newsSentiment": {
          "maximum": 1,
          "minimum": -1,
          "type": "number"
        }
      },
      "type": "object"
    },
    "snapshotArtifactHash": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "validUntil": {
      "format": "date-time",
      "type": "string"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/violation"
      },
      "maxItems": 14,
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/warning"
      },
      "maxItems": 50,
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "evaluationId",
    "catalogVersion",
    "readinessPolicyVersion",
    "decision",
    "mode",
    "canSubmitOrder",
    "principleVersionId",
    "principleVersion",
    "portfolioSource",
    "semanticInputHash",
    "snapshotArtifactHash",
    "violations",
    "issues",
    "warnings",
    "abstentions",
    "riskItems"
  ],
  "title": "S2.2 offline risk evaluation result",
  "type": "object"
}
