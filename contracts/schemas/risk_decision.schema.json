{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/schemas/risk_decision.schema.json",
  "title": "Risk Decision",
  "description": "Decision API data payload produced by RiskEngine after combining order intent, principle, model signal, and risk context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "canSubmitOrder", "validUntil", "violations", "riskSummary", "signalSummary", "explanation"],
  "properties": {
    "decisionId": {
      "type": "string",
      "pattern": "^dec_[A-Za-z0-9_-]+$"
    },
    "decision": {
      "type": "string",
      "enum": ["ALLOW", "WARN", "BLOCK", "HOLD"]
    },
    "mode": {
      "type": "string",
      "enum": ["GUIDE", "STRICT"]
    },
    "canSubmitOrder": {
      "type": "boolean"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "violations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/violation"
      }
    },
    "riskItems": {
      "type": "array",
      "description": "RiskEngine이 소비한 부가 위험 지표의 근거 목록. disclosure_risk_score 같은 외부 원천 기반 지표가 어떤 event/source/mapping 버전으로 산출됐는지 결과 계약에 드러낸다. 범용 구조라 OpenDART 외 원천도 같은 형태로 표현한다.",
      "items": {
        "$ref": "#/$defs/riskItem"
      }
    },
    "riskSummary": {
      "$ref": "#/$defs/riskSummary"
    },
    "signalSummary": {
      "$ref": "#/$defs/signalSummary"
    },
    "explanation": {
      "$ref": "#/$defs/explanation"
    }
  },
  "$defs": {
    "riskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "value", "severity", "source"],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "description": "위험 지표 식별자. 예: disclosure_risk_score. Principle metric enum과 정렬한다."
        },
        "value": {
          "type": ["number", "null"]
        },
        "severity": {
          "type": "string",
          "enum": ["ALLOW", "WARN", "BLOCK"]
        },
        "source": {
          "type": "string",
          "enum": ["OPENDART", "KIS", "NEWS", "MACRO", "INTERNAL"],
          "description": "지표 원천 시스템. disclosure_risk_score는 OPENDART."
        },
        "eventCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "지표 산출에 기여한 구조화 이벤트 코드. 예: OPENDART:dfOcr. report_nm 문자열이 아니라 endpoint identity 기반이다."
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1,
          "description": "점수 mapping 버전. 같은 입력·같은 버전이면 같은 점수라는 재현성을 계약에 남긴다."
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "raw observation 또는 citation 참조 id. explanation.citationIds와 교차 추적 가능하다."
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "severity", "message", "metricValue", "threshold"],
      "properties": {
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["WARN", "BLOCK"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "metricValue": {
          "type": ["number", "null"]
        },
        "threshold": {
          "type": ["number", "null"]
        }
      }
    },
    "riskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mdd", "var95", "cvar95", "hmmRegime", "regimeProbability"],
      "properties": {
        "mdd": {
          "type": "number"
        },
        "var95": {
          "type": "number"
        },
        "cvar95": {
          "type": "number"
        },
        "hmmRegime": {
          "type": "string",
          "enum": ["NORMAL", "SIDEWAYS", "HIGH_VOLATILITY", "RISK_OFF", "RISK_ON"],
          "description": "P0 결정: API 5.1, 6.1, 8.1 예시의 HMM regime 표현을 함께 수용한다."
        },
        "regimeProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "signalSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finalSignal", "confidence", "lstmSignal", "lightgbmSignal", "newsSentiment"],
      "properties": {
        "finalSignal": {
          "type": "string",
          "enum": ["BUY_STRONG", "BUY_WEAK", "BUY", "HOLD", "SELL", "SELL_WEAK", "SELL_STRONG"],
          "description": "P0 결정: API 5.1의 BUY_WEAK와 Signal API의 BUY/HOLD/SELL 계열을 함께 수용한다."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lstmSignal": {
          "type": "string",
          "enum": ["BUY", "SELL", "HOLD"]
        },
        "lightgbmSignal": {
          "type": "string",
          "enum": ["BUY", "SELL", "HOLD"]
        },
        "newsSentiment": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shortText", "citationIds"],
      "properties": {
        "shortText": {
          "type": "string",
          "minLength": 1
        },
        "citationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
