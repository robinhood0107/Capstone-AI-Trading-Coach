          "enum": [
            "ABSTAIN",
            "NOT_APPLICABLE"
          ]
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "ruleId": {
          "enum": [
            "max_position_per_asset",
            "max_gold_etf_etn_weight",
            "max_single_order_amount",
            "daily_loss_guard",
            "mdd_guard",
            "max_daily_orders",
            "negative_news_guard",
            "disclosure_risk_guard",
            "high_volatility_guard",
            "data_freshness_guard",
            "hmm_risk_off_guard",
            "mean_reversion_warning",
            "etf_etn_risk_check",
            "ad_leading_room_guard"
          ],
          "maxLength": 128,
          "type": "string"
        }
      },
      "required": [
        "code",
        "component",
        "disposition",
        "message"
      ],
      "type": "object"
    },
    "issue": {
