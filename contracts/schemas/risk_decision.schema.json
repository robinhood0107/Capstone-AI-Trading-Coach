{
  "$defs": {
    "abstention": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "code": {
                "enum": [
                  "MODEL_ABSTAINED",
                  "OPTIONAL_EVIDENCE_ERROR",
                  "OPTIONAL_EVIDENCE_INCOMPLETE",
                  "OPTIONAL_EVIDENCE_MISSING",
                  "OPTIONAL_EVIDENCE_STALE"
                ]
              }
            }
          },
          "if": {
            "properties": {
              "disposition": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "const": "NOT_APPLICABLE_V1"
              }
            }
          }
        }
      ],
      "properties": {
        "code": {
          "enum": [
            "MODEL_ABSTAINED",
            "OPTIONAL_EVIDENCE_ERROR",
            "OPTIONAL_EVIDENCE_INCOMPLETE",
            "OPTIONAL_EVIDENCE_MISSING",
            "OPTIONAL_EVIDENCE_STALE",
            "NOT_APPLICABLE_V1"
