{
  "$id": "contracts/schemas/s2-4-kill-switch-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active": {
      "type": "boolean"
    },
    "changedAt": {
      "format": "date-time",
      "type": "string"
    },
    "reasonClass": {
      "enum": [
        "USER_MANUAL_STOP",
        "OPERATOR_MANUAL_STOP",
        "DATA_FRESHNESS_STOP",
        "BROKERAGE_FAILURE_STOP",
        "DEMO_SAFETY_STOP",
        "ADMIN_RESUME",
        "INITIAL_STATE"
      ]
    }
  },
  "required": [
    "active",
    "reasonClass",
    "changedAt"
  ],
  "title": "S2.4 sanitized Kill Switch state v1",
  "type": "object"
}
