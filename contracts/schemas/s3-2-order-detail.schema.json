{
  "$id": "contracts/schemas/s3-2-order-detail.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "brokerageMode": {
            "const": "KIS_MOCK"
          }
        },
        "required": [
          "brokerageMode"
        ]
      },
      "then": {
        "properties": {
          "orderId": {
            "pattern": "^ord_mock_[0-9a-f]{32}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "ACCEPTED",
              "CANCELLED",
              "CANCEL_REQUESTED",
              "FILLED",
              "PARTIALLY_FILLED",
              "PENDING_RECONCILIATION",
              "REJECTED",
              "SUBMITTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "brokerageMode": {
            "const": "INTERNAL_PAPER"
          }
        },
        "required": [
          "brokerageMode"
        ]
      },
      "then": {
        "properties": {
          "orderId": {
            "pattern": "^ord_paper_[0-9a-f]{32}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "ACCEPTED",
              "CANCELLED",
              "FILLED"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "accountId": {
      "pattern": "^acct_[0-9a-f]{32}$",
      "type": "string"
    },
    "brokerageMode": {
      "enum": [
        "KIS_MOCK",
        "INTERNAL_PAPER"
      ]
    },
    "decisionId": {
      "pattern": "^dec_[0-9a-f]{32}$",
      "type": "string"
    },
    "orderId": {
      "oneOf": [
        {
          "pattern": "^ord_mock_[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "pattern": "^ord_paper_[0-9a-f]{32}$",
          "type": "string"
        }
      ]
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "CANCELLED",
        "CANCEL_REQUESTED",
        "FILLED",
        "PARTIALLY_FILLED",
        "PENDING_RECONCILIATION",
        "REJECTED",
        "SUBMITTED"
      ]
    },
    "submittedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "orderId",
    "accountId",
    "brokerageMode",
    "status",
    "submittedAt",
    "decisionId"
  ],
  "title": "S3.2 shared brokerage order detail response v1",
  "type": "object"
}
