{
  "$id": "contracts/schemas/s3-2-paper-balance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accountId": {
      "pattern": "^acct_[0-9a-f]{32}$",
      "type": "string"
    },
    "asOf": {
      "format": "date-time",
      "type": "string"
    },
    "brokerageMode": {
      "const": "INTERNAL_PAPER"
    },
    "cashKrw": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "positions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "averagePriceKrw": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "marketValueKrw": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "quantity": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "type": "integer"
          },
          "symbol": {
            "pattern": "^[0-9A-Z._:-]{1,20}$",
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "quantity",
          "marketValueKrw",
          "averagePriceKrw"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "totalEquityKrw": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "valuationBasis": {
      "const": "LAST_FILL_PRICE_V1"
    }
  },
  "required": [
    "accountId",
    "brokerageMode",
    "cashKrw",
    "totalEquityKrw",
    "positions",
    "asOf",
    "valuationBasis"
  ],
  "title": "S3.2 INTERNAL_PAPER balance response v1",
  "type": "object"
}
