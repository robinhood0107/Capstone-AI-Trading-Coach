{
  "$id": "contracts/schemas/s3-3-fill-page.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "brokerageMode": {
                  "const": "INTERNAL_PAPER"
                }
              },
              "required": [
                "brokerageMode"
              ]
            },
            "then": {
              "properties": {
                "orderId": {
                  "pattern": "^ord_paper_[0-9a-f]{32}$",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "brokerageMode": {
                  "const": "KIS_MOCK"
                }
              },
              "required": [
                "brokerageMode"
              ]
            },
            "then": {
              "properties": {
                "orderId": {
                  "pattern": "^ord_mock_[0-9a-f]{32}$",
                  "type": "string"
                }
              }
            }
          }
        ],
        "properties": {
          "brokerageMode": {
            "enum": [
              "INTERNAL_PAPER",
              "KIS_MOCK"
            ]
          },
          "execRefHash": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "fillAmountKrw": {
            "maximum": 9223372036854775807,
            "minimum": 1,
            "type": "integer"
          },
          "fillPriceKrw": {
            "maximum": 9223372036854775807,
            "minimum": 1,
            "type": "integer"
          },
          "fillQuantity": {
            "maximum": 9223372036854775807,
            "minimum": 1,
            "type": "integer"
          },
          "filledAt": {
            "format": "date-time",
            "type": "string"
          },
          "orderId": {
            "oneOf": [
              {
                "pattern": "^ord_mock_[0-9a-f]{32}$",
                "type": "string"
              },
              {
                "pattern": "^ord_paper_[0-9a-f]{32}$",
                "type": "string"
              }
            ]
          },
          "side": {
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "symbol": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[0-9A-Z._:-]{1,20}$",
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "brokerageMode",
          "symbol",
          "side",
          "fillQuantity",
          "fillPriceKrw",
          "fillAmountKrw",
          "filledAt",
          "execRefHash"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "type": "array"
    },
    "nextCursor": {
      "oneOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "items",
    "nextCursor"
  ],
  "title": "S3.3 owner-scoped fill page v1",
  "type": "object"
}
