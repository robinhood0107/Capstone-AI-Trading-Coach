P1_API_PORT=18080
P1_SECRET_GID=1000
# spring 과 python 서비스는 하나의 이미지로 빌드된다(full-appctl 이 decision-platform.Dockerfile
# 하나만 빌드한다). 그래서 두 변수의 값이 같다. 옛 이름(capstone-spring-api /
# capstone-python-services)은 더 이상 빌드되지 않는다.
P1_SPRING_IMAGE=capstone-decision-platform:p1-local
P1_PYTHON_IMAGE=capstone-decision-platform:p1-local
P1_POSTGRES_IMAGE=capstone-postgres-pgvector:p1-local
P1_KAFKA_IMAGE=capstone-kafka:p1-local
P1_SECRETS_DIR=./.state/secrets
# Offline bundle import rewrites the four image values above to exact local digest references.
