{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone.local/contracts/p1-full-app-release-manifest.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "releaseVersion",
    "releaseStage",
    "commitSha",
    "treeSha",
    "platform",
    "images",
    "publicRagSeed",
    "modelAssets",
    "hardGates",
    "capabilities",
    "providerLiveReceipt",
    "supplyChain"
  ],
  "properties": {
    "contractId": {"const": "p1-full-app-release-manifest.v2"},
    "releaseVersion": {"const": "1.0.0"},
    "releaseStage": {"enum": ["CANDIDATE", "FINAL"]},
    "commitSha": {"$ref": "#/$defs/gitSha"},
    "treeSha": {"$ref": "#/$defs/gitSha"},
    "platform": {"const": "linux/amd64"},
    "images": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/image"}
    },
    "publicRagSeed": {"$ref": "#/$defs/publicRagSeed"},
    "modelAssets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/modelAsset"}
    },
    "hardGates": {"$ref": "#/$defs/hardGates"},
    "capabilities": {"$ref": "#/$defs/capabilities"},
    "providerLiveReceipt": {"$ref": "#/$defs/providerLiveReceipt"},
    "supplyChain": {"$ref": "#/$defs/supplyChain"}
  },
  "allOf": [
    {
      "if": {"properties": {"releaseStage": {"const": "FINAL"}}},
      "then": {
        "properties": {
          "hardGates": {
            "properties": {
              "P1_CORE": {"const": "PASS"},
              "PUBLIC_RAG_SEED": {"const": "PASS"},
              "OWNER_RAG_BACKEND": {"const": "PASS"},
              "BGE_OCR_CPU_INTEL": {"const": "PASS"},
              "PROVIDER_LIVE_READ": {"const": "PASS"},
              "TEAM_B_REAL_ARTIFACT": {"const": "PASS"},
              "SECURITY_RELEASE": {"const": "PASS"},
              "SUPPLY_CHAIN_RELEASE": {"const": "PASS"},
              "COMPOSE_E2E": {"const": "PASS"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "safePath": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,239}$"},
    "gateState": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "reference", "digest", "platform"],
      "properties": {
        "component": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "reference": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9./_:-]{0,199}@sha256:[0-9a-f]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "platform": {"const": "linux/amd64"}
      }
    },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "size": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "publicRagSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "archiveSha256", "sources", "chunks", "dimensions", "parts"],
      "properties": {
        "schemaVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "archiveSha256": {"$ref": "#/$defs/sha256"},
        "sources": {"const": 142},
        "chunks": {"const": 7871},
        "dimensions": {"const": 1024},
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/fileDigest"}
        }
      }
    },
    "modelAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "revision", "manifestSha256", "licenseEvidenceSha256"],
      "properties": {
        "component": {"enum": ["bge-m3", "paddleocr-vl-1.6"]},
        "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "licenseEvidenceSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "hardGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P1_CORE",
        "PUBLIC_RAG_SEED",
        "OWNER_RAG_BACKEND",
        "BGE_OCR_CPU_INTEL",
        "PROVIDER_LIVE_READ",
        "TEAM_B_REAL_ARTIFACT",
        "SECURITY_RELEASE",
        "SUPPLY_CHAIN_RELEASE",
        "COMPOSE_E2E"
      ],
      "properties": {
        "P1_CORE": {"$ref": "#/$defs/gateState"},
        "PUBLIC_RAG_SEED": {"$ref": "#/$defs/gateState"},
        "OWNER_RAG_BACKEND": {"$ref": "#/$defs/gateState"},
        "BGE_OCR_CPU_INTEL": {"$ref": "#/$defs/gateState"},
        "PROVIDER_LIVE_READ": {"$ref": "#/$defs/gateState"},
        "TEAM_B_REAL_ARTIFACT": {"$ref": "#/$defs/gateState"},
        "SECURITY_RELEASE": {"$ref": "#/$defs/gateState"},
        "SUPPLY_CHAIN_RELEASE": {"$ref": "#/$defs/gateState"},
        "COMPOSE_E2E": {"$ref": "#/$defs/gateState"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DASHBOARD_UI", "CUDA", "SEARXNG", "LIGHTGBM", "LIVE_ORDER"],
      "properties": {
        "DASHBOARD_UI": {"enum": ["READY", "PARTIAL_TEAM_A_ACTION_REQUIRED"]},
        "CUDA": {"enum": ["PASS", "PENDING_USER_HARDWARE_VERIFICATION"]},
        "SEARXNG": {"enum": ["READY", "KNOWN_DEGRADED_NONBLOCKING"]},
        "LIGHTGBM": {"const": "RESEARCH_ONLY_NOT_APPLICABLE"},
        "LIVE_ORDER": {"const": "FUTURE_NOT_IMPLEMENTED"}
      }
    },
    "providerLiveReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptSha256",
        "voyageQueryCalls",
        "googleGroundedVertexCalls",
        "kisTokenCalls",
        "kisDataCalls",
        "ecosCalls",
        "accountCalls",
        "balanceCalls",
        "orderCalls",
        "retries"
      ],
      "properties": {
        "receiptSha256": {"$ref": "#/$defs/sha256"},
        "voyageQueryCalls": {"type": "integer", "minimum": 0, "maximum": 1},
        "googleGroundedVertexCalls": {"type": "integer", "minimum": 0, "maximum": 1},
        "kisTokenCalls": {"type": "integer", "minimum": 0, "maximum": 1},
        "kisDataCalls": {"type": "integer", "minimum": 0, "maximum": 2},
        "ecosCalls": {"type": "integer", "minimum": 0, "maximum": 2},
        "accountCalls": {"const": 0},
        "balanceCalls": {"const": 0},
        "orderCalls": {"const": 0},
        "retries": {"const": 0}
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sbomSha256", "provenanceSha256", "signatureBundleSha256", "sourceArchiveSha256", "licenseSha256"],
      "properties": {
        "sbomSha256": {"$ref": "#/$defs/sha256"},
        "provenanceSha256": {"$ref": "#/$defs/sha256"},
        "signatureBundleSha256": {"$ref": "#/$defs/sha256"},
        "sourceArchiveSha256": {"$ref": "#/$defs/sha256"},
        "licenseSha256": {"const": "0d96a4ff68ad6d4b6f1f30f713b18d5184912ba8dd389f86aa7710db079abcb0"}
      }
    }
  }
}
