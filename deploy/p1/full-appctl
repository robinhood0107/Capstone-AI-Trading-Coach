up_app() {
  local models=0 mock=0
  while (($#)); do
    case $1 in
      --models) models=1 ;;
      --mock) mock=1 ;;
      *) die UNEXPECTED_ARGUMENT ;;
    esac
    shift
  done
  if ((mock)); then
    mock_certified || die KIS_MOCK_NOT_CERTIFIED
  fi
  export P1_KIS_MOCK_ONLINE_ENABLED=$([[ $mock == 1 ]] && printf true || printf false)
  export P1_KIS_OFFLINE=$([[ $mock == 1 ]] && printf 0 || printf 1)
  # Runtime availability and order authorization remain separate gates.
  export P1_AUTOMATION_RUNTIME_ENABLED=$([[ $mock == 1 ]] && printf true || printf false)
  require_command openssl
  require_command python3
  [[ -n $DOCKER_BIN ]] || die MISSING_COMMAND_docker
  "$DOCKER_BIN" compose version >/dev/null 2>&1 || die DOCKER_COMPOSE_UNAVAILABLE
  build_core_images
  initialize_state
  build_team_images
  compose --profile preview --profile models config --quiet
  run_initializers
  if ((models)); then
    compose --profile models pull bge-m3 paddleocr-vl
    compose --profile models run --rm --no-deps paddleocr-vl-model-fetch
    compose --profile models up -d --wait bge-m3 paddleocr-vl
  else
    # Preserve model volumes while removing inactive containers.
    compose --profile models stop bge-m3 paddleocr-vl >/dev/null 2>&1 || true
    compose --profile models rm --force bge-m3 paddleocr-vl >/dev/null 2>&1 || true
  fi
  # The daily collector runs only with the automation profile.
  if ((mock)); then
    compose --profile automation up -d --wait market-data-daily
  else
    compose --profile automation stop market-data-daily >/dev/null 2>&1 || true
    compose --profile automation rm --force market-data-daily >/dev/null 2>&1 || true
  fi
  # Stop the preview immediately before binding the production host ports.
  stop_old_preview_containers
  compose up -d --wait actor-authority decision-platform experience-dashboard
  local calendar_seed
  # Calendar seed failures are reported without taking down the core stack.
  calendar_seed=$(compose --profile owner run --rm --no-deps calendar-offline-seed 2>&1 \
    | grep -E '^P1_CALENDAR_OFFLINE_SEED=' | tail -1) || calendar_seed=''
  printf '%s\n' "${calendar_seed:-P1_CALENDAR_OFFLINE_SEED=NO_OUTPUT}"
  # An already populated calendar is a healthy state.
  case $calendar_seed in
    P1_CALENDAR_OFFLINE_SEED=SEEDED*) printf 'CAPSTONE_TRADING_CALENDAR=SEEDED\n' ;;
    P1_CALENDAR_OFFLINE_SEED=NO_SESSIONS*alreadyPresent=0\ *)
      printf 'CAPSTONE_TRADING_CALENDAR=UNAVAILABLE\n' ;;
    P1_CALENDAR_OFFLINE_SEED=NO_SESSIONS*) printf 'CAPSTONE_TRADING_CALENDAR=PRESENT\n' ;;
    *) printf 'CAPSTONE_TRADING_CALENDAR=UNAVAILABLE\n' ;;
  esac
  unset calendar_seed
  # Source registration is reported separately from core startup.
  local rag_sources_seed
  rag_sources_seed=$(compose --profile owner run --rm --no-deps rag-source-register 2>&1 \
    | grep -E '"sourceCount"' | tail -1) || rag_sources_seed=''
  if [[ -n $rag_sources_seed ]]; then
    printf 'CAPSTONE_RAG_SOURCE_REGISTRY=REGISTERED\n'
  else
    printf 'CAPSTONE_RAG_SOURCE_REGISTRY=UNAVAILABLE\n'
  fi
  unset rag_sources_seed
  replay_history
  # A failed public-price refresh is recorded as stale and never calls KIS orders.
  local daily_refresh
  daily_refresh=$(compose --profile owner run --rm --no-deps market-data-cli \
    python -m app.data.market_data.yfinance_daily_cli 2>&1 \
    | grep -E '^P1_MARKET_DATA_YF_REFRESH=' | tail -1) || daily_refresh=''
  printf '%s\n' "${daily_refresh:-P1_MARKET_DATA_YF_REFRESH=NO_OUTPUT}"
  case $daily_refresh in
    P1_MARKET_DATA_YF_REFRESH=ADOPTED*|P1_MARKET_DATA_YF_REFRESH=UP_TO_DATE*)
      printf 'CAPSTONE_MARKET_DATA_DAILY=FRESH\n' ;;
    *)
      printf 'CAPSTONE_MARKET_DATA_DAILY=STALE\n' ;;
  esac
  unset daily_refresh
  local scenario_materialization
  scenario_materialization=$(compose --profile owner run --rm --no-deps owner-scenario-materializer 2>&1 \
    | tail -1) || scenario_materialization=''
  if [[ $scenario_materialization == *'"providerCalls":0'* && $scenario_materialization == *'"sessions":104'* ]]; then
    printf 'CAPSTONE_OWNER_SCENARIOS=MATERIALIZED\n'
  else
    printf 'CAPSTONE_OWNER_SCENARIOS=UNAVAILABLE\n'
  fi
  unset scenario_materialization
  # Preserve the stored automation intent across KIS Mock restarts.
  local desired_automation=0
  load_active_mode
  ((mock)) && desired_automation=$AUTOMATION
  save_active_mode "$models" "$mock" "$desired_automation"
  # Base stack: five services; models add two and mock adds one.
  local expected=5
  ((models)) && expected=$((expected + 2))
  ((mock)) && expected=$((expected + 1))
  local running
  running=$(compose ps --status running --services | wc -l | tr -d ' ')
  [[ $running == "$expected" ]] || die "CONTAINER_COUNT_EXPECTED_${expected}_OBSERVED_${running}"
  remove_old_preview_containers
  printf 'CAPSTONE_UP=PASS\nCAPSTONE_PERSISTENT_CONTAINERS=%s\n' "$running"
  printf 'CAPSTONE_DASHBOARD_URL=http://127.0.0.1:%s\n' "${P1_DASHBOARD_PORT:-3000}"
  printf 'CAPSTONE_API_URL=http://127.0.0.1:%s\n' "${P1_API_PORT:-18080}"
  if ((mock)); then
    printf 'KIS_BROKERAGE_MODE=KIS_MOCK\n'
  else
    printf 'KIS_BROKERAGE_MODE=PROVIDER_FREE\n'
  fi
  reconcile_automation_intent "$desired_automation"
}

reconcile_automation_intent() {
  local desired=${1:-0} output status=0
  if ((desired == 0)); then
    printf 'CAPSTONE_AUTOMATION_RECONCILED=DISARMED_BY_INTENT\n'
    return 0
  fi
  output=$(mock_start 2>&1) || status=$?
  if ((status == 0)); then
    printf '%s\n' "$output"
    printf 'CAPSTONE_AUTOMATION_RECONCILED=ARMED\n'
    return 0
  fi
  printf '%s\n' "${output:-(no output)}"
  printf 'CAPSTONE_AUTOMATION_RECONCILED=BLOCKED\n'
  return 0
}

