#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd -P)
STATE_DIR=${P1_STATE_DIR:-$SCRIPT_DIR/.state-app}
SECRETS_DIR=$STATE_DIR/secrets
RUNTIME_ENV=$STATE_DIR/runtime.env
ACTIVE_MODE=$STATE_DIR/active-mode.env
COMPOSE_FILE=$SCRIPT_DIR/compose.yml
PROJECT_NAME=${P1_PROJECT_NAME:-capstone-p1}
P1CTL=$SCRIPT_DIR/p1ctl
RELEASE_GUARD=$SCRIPT_DIR/release_guard.py
MOCK_CERTIFICATION_GUARD=$SCRIPT_DIR/mock_certification_guard.py
DOCKER_BIN=/usr/bin/docker
[[ -x $DOCKER_BIN ]] || DOCKER_BIN=$(command -v docker 2>/dev/null || true)

die() { printf 'CAPSTONE_ERROR=%s\n' "$1" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "MISSING_COMMAND_$1"; }

usage() {
  cat <<'EOF'
Usage:
  ./capstone up [--models] [--mock]
  ./capstone status|logs|smoke|down|doctor
  ./capstone mock <configure|doctor|certify|readiness|start|stop> [--symbol 005930] [--quantity 1]
  ./capstone artifact <validate|import> <bundle-directory> --manifest-sha256 <sha256>
  ./capstone team-a acceptance

Default `up` starts five persistent containers. `--models` adds the official
BGE-M3 and llama.cpp PaddleOCR-VL runtimes for a total of seven. Brokerage is
provider-free unless the owner explicitly selects `--mock` after certification.
EOF
}

compose() {
  [[ -n $DOCKER_BIN ]] || die MISSING_COMMAND_docker
  enable_rag_by_default
  export P1_OPERATOR_UID=${P1_OPERATOR_UID:-$(id -u)}
  export P1_KIS_MOCK_RUNTIME_DIR=${P1_KIS_MOCK_RUNTIME_DIR:-$STATE_DIR/mock}
  local args=("$DOCKER_BIN" compose --project-name "$PROJECT_NAME")
  if [[ -f $RUNTIME_ENV && ! -L $RUNTIME_ENV ]]; then
    args+=(--env-file "$RUNTIME_ENV")
  else
    export P1_SECRET_GID=${P1_SECRET_GID:-$(id -g)}
    export P1_SECRETS_DIR=${P1_SECRETS_DIR:-$SECRETS_DIR}
    export P1_SPRING_IMAGE=${P1_SPRING_IMAGE:-capstone-decision-platform:p1-local}
    export P1_PYTHON_IMAGE=${P1_PYTHON_IMAGE:-capstone-decision-platform:p1-local}
  fi
  args+=(-f "$COMPOSE_FILE")
  "${args[@]}" "$@"
}

write_state() {
  local relative=$1 mode=$2
  python3 "$RELEASE_GUARD" state-write "$STATE_DIR" "$relative" "$mode"
}

append_state() {
  local relative=$1 mode=$2
  python3 "$RELEASE_GUARD" state-append "$STATE_DIR" "$relative" "$mode"
}

state_ready() {
  [[ -f $RUNTIME_ENV && ! -L $RUNTIME_ENV && -d $SECRETS_DIR && ! -L $SECRETS_DIR ]]
}

build_core_images() {
  "$DOCKER_BIN" build -f "$SCRIPT_DIR/docker/decision-platform.Dockerfile" \
    -t capstone-decision-platform:p1-local "$REPO_ROOT"
  "$DOCKER_BIN" build -f "$SCRIPT_DIR/docker/postgres-pgvector.Dockerfile" \
    -t capstone-postgres-pgvector:p1-local "$REPO_ROOT"
}

build_team_images() {
  compose --profile preview build experience-dashboard return-engine-preview-prepare
}

initialize_state() {
  if ! state_ready; then
    P1_STATE_DIR=$STATE_DIR \
      P1_PROJECT_NAME=$PROJECT_NAME \
      P1_SPRING_IMAGE=capstone-decision-platform:p1-local \
      P1_PYTHON_IMAGE=capstone-decision-platform:p1-local \
      "$P1CTL" init
  fi
  upgrade_state
  P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$PROJECT_NAME "$P1CTL" verify >/dev/null
}

upgrade_state() {
  # 5/7 container layout 이전에 생성된 state를 지우거나 key를 회전하지 않는다.
  # 새 brokerage channel에 필요한 서로 독립적인 값만 atomic하게 보강한다.
  if ! grep -q '^BROKERAGE_GRPC_SHARED_SECRET=' "$SECRETS_DIR/spring.env"; then
    printf 'BROKERAGE_GRPC_SHARED_SECRET=%s\n' "$(openssl rand -hex 32)" \
      | append_state secrets/spring.env 0640
  fi
  if [[ ! -e $SECRETS_DIR/return-inference.env ]]; then
    local return_inference_secret
    return_inference_secret=$(sed -n 's/^RETURN_INFERENCE_GRPC_SHARED_SECRET=//p' "$SECRETS_DIR/spring.env")
    [[ $return_inference_secret =~ ^[0-9a-f]{64}$ ]] \
      || return_inference_secret=$(openssl rand -hex 32)
    printf 'RETURN_INFERENCE_GRPC_SHARED_SECRET=%s\n' "$return_inference_secret" \
      | write_state secrets/return-inference.env 0640
    unset return_inference_secret
  fi
  if [[ ! -e $SECRETS_DIR/kis-mock.env ]]; then
    printf '%s\n' \
      'KIS_MOCK_CONFIGURED=false' \
      'KIS_MOCK_APP_KEY=DISABLED00' \
      'KIS_MOCK_APP_SECRET=DISABLED00' \
      'KIS_MOCK_ACCOUNT_NO=00000000-00' \
      'KIS_MOCK_BOUND_ACCOUNT_ID=acct_00000000000000000000000000000000' \
      "KIS_MOCK_ORDER_REFERENCE_KEY=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n')" \
      'KIS_BROKERAGE_TOKEN_P_PHYSICAL_CAP=1' \
      'KIS_BROKERAGE_PHYSICAL_CAP=32' \
      | write_state secrets/kis-mock.env 0640
  fi
  local reference_key
  reference_key=$(sed -n 's/^KIS_MOCK_ORDER_REFERENCE_KEY=//p' "$SECRETS_DIR/kis-mock.env")
  if [[ ! $reference_key =~ ^[A-Za-z0-9_-]{43}=$ ]]; then
    # 과거 생성물은 base64 padding을 지워 44자 Fernet key 조건을 만족하지 못한다. credential은
    # 건드리지 않고 이 key만 재발급한다. 아직 참조 중인 주문이 없을 때만 안전하다.
    sed "s|^KIS_MOCK_ORDER_REFERENCE_KEY=.*|KIS_MOCK_ORDER_REFERENCE_KEY=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n')|" \
      "$SECRETS_DIR/kis-mock.env" | write_state secrets/kis-mock.env 0640
  fi
  unset reference_key
  if [[ ! -e $SECRETS_DIR/artifact-import.env ]]; then
    local worker_password
    worker_password=$(sed -n 's/^POSTGRES_WORKER_PASSWORD=//p' "$SECRETS_DIR/spring.env")
    [[ $worker_password =~ ^[0-9a-f]{64}$ ]] || die ARTIFACT_IMPORT_WORKER_SECRET_MISSING
    printf 'P1_ARTIFACT_IMPORT_DATABASE_DSN=postgresql://decision_worker:%s@postgres:5432/capstone_p1?sslmode=disable\n' "$worker_password" \
      | write_state secrets/artifact-import.env 0640
    unset worker_password
  fi
  if [[ ! -e $SECRETS_DIR/team-a-acceptance.env ]]; then
    local postgres_password
    postgres_password=$(sed -n 's/^POSTGRES_PASSWORD=//p' "$SECRETS_DIR/postgres.env")
    [[ $postgres_password =~ ^[0-9a-f]{64}$ ]] || die TEAM_A_ACCEPTANCE_DATABASE_SECRET_MISSING
    printf 'P1_TEAM_A_ACCEPTANCE_DATABASE_DSN=postgresql://postgres:%s@postgres:5432/capstone_p1?sslmode=disable\n' "$postgres_password" \
      | write_state secrets/team-a-acceptance.env 0640
    unset postgres_password
  fi
  local automation_runtime_password
  automation_runtime_password=$(sed -n 's/^POSTGRES_AUTOMATION_RUNTIME_PASSWORD=//p' "$SECRETS_DIR/postgres.env")
  if [[ ! $automation_runtime_password =~ ^[0-9a-f]{64}$ ]]; then
    automation_runtime_password=$(openssl rand -hex 32)
    printf 'POSTGRES_AUTOMATION_RUNTIME_PASSWORD=%s\n' "$automation_runtime_password" \
      | append_state secrets/postgres.env 0640
  fi
  if ! grep -q '^POSTGRES_AUTOMATION_RUNTIME_PASSWORD=' "$SECRETS_DIR/role-bootstrap.env"; then
    printf 'POSTGRES_AUTOMATION_RUNTIME_PASSWORD=%s\n' "$automation_runtime_password" \
      | append_state secrets/role-bootstrap.env 0640
  fi
  if [[ ! -e $SECRETS_DIR/automation-runtime.env ]]; then
    printf 'P1_AUTOMATION_DATABASE_DSN=postgresql://decision_automation_runtime:%s@postgres:5432/capstone_p1?sslmode=disable\nAUTOMATION_RUNTIME_SHARED_SECRET=%s\nP1_AUTOMATION_OWNER_USER_ID=usr_demo_user\n' \
      "$automation_runtime_password" "$(openssl rand -hex 32)" \
      | write_state secrets/automation-runtime.env 0640
  fi
  if ! grep -q '^P1_AUTOMATION_OWNER_USER_ID=' "$SECRETS_DIR/automation-runtime.env"; then
    printf 'P1_AUTOMATION_OWNER_USER_ID=usr_demo_user\n' \
      | append_state secrets/automation-runtime.env 0640
  fi
  if [[ ! -e $SECRETS_DIR/rag-v2.env ]]; then
    # RAG v2 질의 경로는 두 역할을 나눠 쓴다. Spring이 decision_app으로 인가하고 Python writer가
    # decision_rag_writer로 사용량을 예약한다. 그래서 여기 DSN은 rag writer 역할이어야 한다.
    # VOYAGE_API_KEY는 생성하지 않는다. KIS credential과 같은 취급으로 운영자가 직접 넣는다.
    local rag_writer_password rag_query_password
    rag_writer_password=$(sed -n 's/^POSTGRES_RAG_WRITER_PASSWORD=//p' "$SECRETS_DIR/postgres.env")
    rag_query_password=$(sed -n 's/^POSTGRES_RAG_QUERY_PASSWORD=//p' "$SECRETS_DIR/postgres.env")
    [[ $rag_writer_password =~ ^[0-9a-f]{64}$ ]] || die RAG_V2_QUERY_WRITER_SECRET_MISSING
    [[ $rag_query_password =~ ^[0-9a-f]{64}$ ]] || die RAG_V2_QUERY_READER_SECRET_MISSING
    printf 'RAG_V2_QUERY_DATABASE_DSN=postgresql://decision_rag_query:%s@postgres:5432/capstone_p1?sslmode=disable\nRAG_V2_VOYAGE_QUERY_WRITER_DSN=postgresql://decision_rag_writer:%s@postgres:5432/capstone_p1?sslmode=disable\nRAG_V2_GRPC_SHARED_SECRET=%s\n' \
      "$rag_query_password" "$rag_writer_password" "$(openssl rand -hex 32)" \
      | write_state secrets/rag-v2.env 0640
    unset rag_writer_password rag_query_password
  fi
  # 이미 만들어진 상태에도 Strong LLM 공유 비밀을 덧붙인다. 없던 배포가 그대로 켜지면
  # 부팅에서 닫히고, 그 실패 원인이 "파일 하나가 빠졌다"가 되어 읽기 어려워진다.
  if ! grep -q '^STRONG_LLM_GRPC_SHARED_SECRET=' "$SECRETS_DIR/rag-v2.env"; then
    printf 'STRONG_LLM_GRPC_SHARED_SECRET=%s\n' "$(openssl rand -hex 32)" \
      | append_state secrets/rag-v2.env 0640
  fi
  if [[ ! -e $SECRETS_DIR/automation-gate-author.env ]]; then
    local replay_authorizer_password
    replay_authorizer_password=$(sed -n 's/^POSTGRES_REPLAY_AUTHORIZER_PASSWORD=//p' "$SECRETS_DIR/postgres.env")
    [[ $replay_authorizer_password =~ ^[0-9a-f]{64}$ ]] || die AUTOMATION_GATE_AUTHOR_SECRET_MISSING
    printf 'P1_AUTOMATION_GATE_AUTHOR_DSN=postgresql://decision_replay_authorizer:%s@postgres:5432/capstone_p1?sslmode=disable\n' \
      "$replay_authorizer_password" | write_state secrets/automation-gate-author.env 0640
    unset replay_authorizer_password
  fi
  unset automation_runtime_password
  install -d -m 0700 "$STATE_DIR/artifacts"
  install -d -m 0700 "$STATE_DIR/mock"
  if ! grep -q '^P1_OPERATOR_UID=' "$RUNTIME_ENV"; then
    printf 'P1_OPERATOR_UID=%s\n' "$(id -u)" | append_state runtime.env 0600
  fi
  if ! grep -q '^P1_KIS_MOCK_RUNTIME_DIR=' "$RUNTIME_ENV"; then
    printf 'P1_KIS_MOCK_RUNTIME_DIR=%s\n' "$STATE_DIR/mock" | append_state runtime.env 0600
  fi
  # RAG v2 로컬 루트는 비어 있어도 된다. 마운트만 항상 성립하게 두고, 실제 leaf가 없으면
  # RAG v2를 켰을 때 entrypoint가 닫는다. 운영자가 다른 경로를 쓰려면 이 값을 바꾼다.
  install -d -m 0700 "$STATE_DIR/rag-v2-root"
  if ! grep -q '^P1_RAG_RUNTIME_DIR=' "$RUNTIME_ENV"; then
    printf 'P1_RAG_RUNTIME_DIR=%s\n' "$STATE_DIR/rag-v2-root" | append_state runtime.env 0600
  fi
  local approval_files=0 approval_file
  for approval_file in kis-mock-approval-private.pem kis-mock-approval-public.pem kis-mock-approval-trust-policy.json p1-provider-claim.dsn; do
    [[ ! -e $SECRETS_DIR/$approval_file ]] || approval_files=$((approval_files + 1))
  done
  [[ $approval_files == 0 || $approval_files == 4 ]] || die KIS_MOCK_APPROVAL_STATE_PARTIAL
  if [[ $approval_files == 0 ]]; then
    local approval_tmp public_digest replay_password
    approval_tmp=$(mktemp -d)
    openssl genpkey -algorithm ED25519 -out "$approval_tmp/private.pem" >/dev/null 2>&1
    openssl pkey -in "$approval_tmp/private.pem" -pubout -out "$approval_tmp/public.pem" >/dev/null 2>&1
    # 서명용 개인키는 owner-only 0600만 허용된다. compose secret은 원본 mode를 그대로
    # 마운트하므로 0640으로 만들면 packet reader가 bounded owner-only 검사에서 거부한다.
    write_state secrets/kis-mock-approval-private.pem 0600 < "$approval_tmp/private.pem"
    write_state secrets/kis-mock-approval-public.pem 0640 < "$approval_tmp/public.pem"
    public_digest=$(sha256sum "$approval_tmp/public.pem" | awk '{print $1}')
    printf '{"contractId":"p1-approval-trust-root.v1","issuerKeyId":"CAPSTONE.KISMOCK.V1","publicKeyPath":"/run/secrets/kis_mock_approval_public","publicKeySha256":"%s"}' "$public_digest" \
      | write_state secrets/kis-mock-approval-trust-policy.json 0640
    replay_password=$(sed -n 's/^POSTGRES_REPLAY_PASSWORD=//p' "$SECRETS_DIR/postgres.env")
    [[ -n $replay_password ]] || die KIS_MOCK_APPROVAL_REPLAY_SECRET_MISSING
    printf 'postgresql://decision_replay:%s@postgres:5432/capstone_p1?sslmode=disable' "$replay_password" \
      | write_state secrets/p1-provider-claim.dsn 0600
    unset replay_password
    rm -rf -- "$approval_tmp"
  fi
}

run_initializers() {
  compose up -d --wait postgres redis
  compose run --rm --no-deps role-bootstrap
  compose run --rm --no-deps migrate
  compose run --rm --no-deps seed-import
  compose run --rm --no-deps identity-bootstrap
  compose --profile preview run --rm --no-deps dashboard-preview-seed
  compose --profile preview run --rm --no-deps return-engine-preview-prepare
}

save_active_mode() {
  local models=$1 mock=$2 automation=$3
  printf 'MODELS=%s\nMOCK=%s\nAUTOMATION=%s\n' "$models" "$mock" "$automation" \
    | write_state active-mode.env 0600
}

load_active_mode() {
  MODELS=0
  MOCK=0
  AUTOMATION=0
  if [[ -f $ACTIVE_MODE && ! -L $ACTIVE_MODE ]]; then
    while IFS='=' read -r key value; do
      [[ $value == 0 || $value == 1 ]] || die ACTIVE_MODE_INVALID
      case $key in
        MODELS) MODELS=$value ;;
        MOCK) MOCK=$value ;;
        AUTOMATION) AUTOMATION=$value ;;
        *) die ACTIVE_MODE_INVALID ;;
      esac
    done < "$ACTIVE_MODE"
  fi
}

remove_old_preview_containers() {
  "$DOCKER_BIN" compose --project-name capstone-p1-preview -f "$COMPOSE_FILE" \
    --profile preview --profile models down --remove-orphans >/dev/null 2>&1 || true
}

stop_old_preview_containers() {
  local ids=()
  mapfile -t ids < <("$DOCKER_BIN" ps --quiet --filter label=com.docker.compose.project=capstone-p1-preview)
  if ((${#ids[@]})); then
    "$DOCKER_BIN" stop "${ids[@]}" >/dev/null
  fi
}

# RAG는 재료가 있는 기계에서 저절로 켜진다.
#
# 예전에는 기본값이 꺼짐이라 `./capstone up`만 하면 corpus는 FULL_READY라고 답하면서도 질문에는
# 답도 인용도 오지 않았다. 그것이 이 화면의 첫인상이었다.
#
# 그렇다고 compose 기본값을 켜짐으로 바꿀 수는 없다. entrypoint는 켜져 있는데 로컬 루트나
# 키가 없으면 부팅을 닫는다. 그러면 코퍼스를 아직 받지 않은 기계에서 스택 전체가 뜨지 않는다.
# "조용히 fixture로 되돌아가지 않는다"는 그 성질은 명시적으로 켠 요청에 대한 것이라 그대로 둔다.
#
# 그래서 기본값을 여기서 정한다. 이 기계에 재료가 실제로 있으면 켜고, 없으면 끈 채로 뜨며
# 무엇이 없어서 꺼졌는지 말한다. 운영자가 환경변수로 직접 켠 경우에는 손대지 않는다 - 그때는
# 재료가 없으면 부팅이 닫히는 편이 맞다.
# 활성화 패킷에 박히는 코드 바인딩 넷을 지금 트리에서 만든다.
#
# 이 값들의 뜻은 "이 패킷을 저술한 코드 상태가 무엇이었나"다. 운영자가 손으로 붙여 넣게 하면
# 배포마다 한 번 더 손이 가고, 무엇보다 그 값이 실제로 도는 코드와 어긋나도 아무도 모른다.
# 실제 상태에서 뽑으면 그 어긋남이 생기지 않는다. 이미 정해 둔 값이 있으면 손대지 않는다.
bind_vertex_code_state() {
  command -v git >/dev/null 2>&1 || return 1
  local head tree
  head=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null) || return 1
  tree=$(git -C "$REPO_ROOT" rev-parse 'HEAD^{tree}' 2>/dev/null) || return 1
  export P1_RAG_V2_VERTEX_HEAD_COMMIT=${P1_RAG_V2_VERTEX_HEAD_COMMIT:-$head}
  export P1_RAG_V2_VERTEX_TREE_DIGEST=${P1_RAG_V2_VERTEX_TREE_DIGEST:-$(printf '%s' "$tree" | sha256sum | cut -d' ' -f1)}
  export P1_RAG_V2_VERTEX_CI_DIGEST=${P1_RAG_V2_VERTEX_CI_DIGEST:-$(sha256sum "$REPO_ROOT/.github/workflows/contracts-ci.yml" | cut -d' ' -f1)}
  export P1_RAG_V2_VERTEX_SECURITY_DIGEST=${P1_RAG_V2_VERTEX_SECURITY_DIGEST:-$(sha256sum "$SCRIPT_DIR/docker/secret-entrypoint.sh" | cut -d' ' -f1)}
}

enable_rag_by_default() {
  [[ -z ${P1_RAG_DEFAULT_DECIDED:-} ]] || return 0
  export P1_RAG_DEFAULT_DECIDED=1
  # 이 경로는 compose가 읽는 runtime.env에 있다. 그 파일을 통째로 불러오면 여기의 판단이
  # 배포 전체의 환경에 섞이므로 필요한 한 줄만 읽는다.
  local root=${P1_RAG_RUNTIME_DIR:-}
  [[ -n $root ]] || root=$(sed -n 's/^P1_RAG_RUNTIME_DIR=//p' "$RUNTIME_ENV" 2>/dev/null || true)
  local missing=()
  [[ -n ${P1_RAG_V2_ENABLED:-} ]] && return 0
  [[ -n $root && -d $root ]] || missing+=(runtime-root)
  [[ -f $root/control/pre-s5-voyage-query-runtime.json ]] || missing+=(voyage-query-runtime)
  [[ -f $root/artifacts/voyage-context-4/tokenizer.json ]] || missing+=(tokenizer)
  grep -q '^VOYAGE_API_KEY=.' "$SECRETS_DIR/rag-v2.env" 2>/dev/null || missing+=(voyage-key)
  if ((${#missing[@]})); then
    export P1_RAG_V2_ENABLED=false
    printf 'CAPSTONE_RAG_DEFAULT=OFF_MISSING_%s\n' "$(IFS=,; printf '%s' "${missing[*]}")"
    return 0
  fi
  export P1_RAG_V2_ENABLED=true
  # 생성까지 켜려면 서비스계정과 자동 저술 정책이 더 있어야 한다. 둘 중 하나라도 없으면
  # 검색은 켜고 생성만 닫는다. 그때 화면은 인용은 보여 주고 답만 비어 있다.
  if [[ -z ${P1_RAG_V2_VERTEX_ENABLED:-} ]] &&
     [[ -f $SECRETS_DIR/pre-s5-vertex-service-account.json ]] &&
     [[ -f $root/control/pre-s5-vertex-auto-activation-policy.json ]] &&
     bind_vertex_code_state; then
    export P1_RAG_V2_VERTEX_ENABLED=true
    export P1_RAG_V2_VERTEX_AUTO_ACTIVATION_ENABLED=${P1_RAG_V2_VERTEX_AUTO_ACTIVATION_ENABLED:-true}
    printf 'CAPSTONE_RAG_DEFAULT=ON_WITH_GENERATION\n'
  else
    printf 'CAPSTONE_RAG_DEFAULT=ON_RETRIEVAL_ONLY\n'
  fi
}

up_app() {
  local models=0 mock=0
  while (($#)); do
    case $1 in
      --models) models=1 ;;
      --mock) mock=1 ;;
      *) die UNEXPECTED_ARGUMENT ;;
    esac
    shift
  done
  if ((mock)); then
    mock_certified || die KIS_MOCK_NOT_CERTIFIED
  fi
  export P1_KIS_MOCK_ONLINE_ENABLED=$([[ $mock == 1 ]] && printf true || printf false)
  export P1_KIS_OFFLINE=$([[ $mock == 1 ]] && printf 0 || printf 1)
  export P1_AUTOMATION_RUNTIME_ENABLED=false
  require_command openssl
  require_command python3
  [[ -n $DOCKER_BIN ]] || die MISSING_COMMAND_docker
  "$DOCKER_BIN" compose version >/dev/null 2>&1 || die DOCKER_COMPOSE_UNAVAILABLE
  build_core_images
  initialize_state
  build_team_images
  compose --profile preview --profile models config --quiet
  run_initializers
  if ((models)); then
    compose --profile models pull bge-m3 paddleocr-vl
    compose --profile models run --rm --no-deps paddleocr-vl-model-fetch
    compose --profile models up -d --wait bge-m3 paddleocr-vl
  else
    # 모드 전환 시 모델 volume은 보존하되 정지 컨테이너도 남기지 않는다.
    compose --profile models stop bge-m3 paddleocr-vl >/dev/null 2>&1 || true
    compose --profile models rm --force bge-m3 paddleocr-vl >/dev/null 2>&1 || true
  fi
  # 기존 preview와 host port가 같아 cut-over 직전에만 중지한다. volume은 건드리지 않는다.
  stop_old_preview_containers
  compose up -d --wait actor-authority decision-platform experience-dashboard
  save_active_mode "$models" "$mock" 0
  local expected=5
  ((models)) && expected=7
  local running
  running=$(compose ps --status running --services | wc -l | tr -d ' ')
  [[ $running == "$expected" ]] || die "CONTAINER_COUNT_EXPECTED_${expected}_OBSERVED_${running}"
  remove_old_preview_containers
  printf 'CAPSTONE_UP=PASS\nCAPSTONE_PERSISTENT_CONTAINERS=%s\n' "$running"
  printf 'CAPSTONE_DASHBOARD_URL=http://127.0.0.1:%s\n' "${P1_DASHBOARD_PORT:-3000}"
  printf 'CAPSTONE_API_URL=http://127.0.0.1:%s\n' "${P1_API_PORT:-18080}"
  if ((mock)); then
    printf 'KIS_BROKERAGE_MODE=KIS_MOCK\n'
  else
    printf 'KIS_BROKERAGE_MODE=PROVIDER_FREE\n'
  fi
}

