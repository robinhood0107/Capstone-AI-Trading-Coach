enable_rag_by_default() {
  [[ -z ${P1_RAG_DEFAULT_DECIDED:-} ]] || return 0
  export P1_RAG_DEFAULT_DECIDED=1
  # Read only the runtime root; importing the full env would leak unrelated settings.
  local root=${P1_RAG_RUNTIME_DIR:-}
  [[ -n $root ]] || root=$(sed -n 's/^P1_RAG_RUNTIME_DIR=//p' "$RUNTIME_ENV" 2>/dev/null || true)
  # Compose resolves this path relative to deploy/p1.
  [[ $root != /* ]] && root=$SCRIPT_DIR/$root
  local missing=()
  [[ -n ${P1_RAG_V2_ENABLED:-} ]] && return 0
  [[ -n $root && -d $root ]] || missing+=(runtime-root)
  [[ -f $root/control/pre-s5-voyage-query-runtime.json ]] || missing+=(voyage-query-runtime)
  [[ -f $root/artifacts/voyage-context-4/tokenizer.json ]] || missing+=(tokenizer)
  grep -q '^VOYAGE_API_KEY=.' "$SECRETS_DIR/rag-v2.env" 2>/dev/null || missing+=(voyage-key)
  if ((${#missing[@]})); then
    export P1_RAG_V2_ENABLED=false
    printf 'CAPSTONE_RAG_DEFAULT=OFF_MISSING_%s\n' "$(IFS=,; printf '%s' "${missing[*]}")"
    return 0
  fi
  export P1_RAG_V2_ENABLED=true
  # Retrieval can run without enabling external generation.
  if [[ -z ${P1_RAG_V2_VERTEX_ENABLED:-} ]] &&
     [[ -f $SECRETS_DIR/pre-s5-vertex-service-account.json ]] &&
     [[ -f $root/control/pre-s5-vertex-auto-activation-policy.json ]] &&
     bind_vertex_code_state; then
