artifact_import() {
  local bundle=${1:-} manifest_sha=${2:-} bundle_parent bundle_name
  [[ $# == 2 ]] || die ARTIFACT_IMPORT_ARGUMENTS
  [[ $bundle == /* && $bundle != */ && -d $bundle && ! -L $bundle ]] || die ARTIFACT_IMPORT_BUNDLE_ROOT
  [[ $manifest_sha =~ ^[0-9a-f]{64}$ ]] || die ARTIFACT_IMPORT_MANIFEST_SHA256
  state_ready || die RUN_CAPSTONE_UP_FIRST
  upgrade_state
  compose ps --status running --services | grep -qx postgres || die ARTIFACT_IMPORT_POSTGRES_NOT_RUNNING
  bundle_parent=${bundle%/*}; [[ -n $bundle_parent ]] || bundle_parent=/
  bundle_name=${bundle##*/}
  [[ $bundle_name != . && $bundle_name != .. ]] || die ARTIFACT_IMPORT_BUNDLE_ROOT
  export P1_ARTIFACT_BUNDLE_PARENT=$bundle_parent
  export P1_ARTIFACT_BUNDLE_NAME=$bundle_name
  export P1_ARTIFACT_ARCHIVE_DIR=$STATE_DIR/artifacts
  export P1_ARTIFACT_MANIFEST_SHA256=$manifest_sha
  compose --profile owner run --rm --no-deps artifact-importer
  author_automation_gate >/dev/null 2>&1 || true
}

artifact_validate() {
  local bundle=${1:-} manifest_sha=${2:-} bundle_parent bundle_name result
  [[ $# == 2 ]] || die ARTIFACT_VALIDATE_ARGUMENTS
  [[ $bundle == /* && $bundle != */ && -d $bundle && ! -L $bundle ]] \
    || die ARTIFACT_VALIDATE_BUNDLE_ROOT
  [[ $manifest_sha =~ ^[0-9a-f]{64}$ ]] || die ARTIFACT_VALIDATE_MANIFEST_SHA256
  bundle_parent=${bundle%/*}; [[ -n $bundle_parent ]] || bundle_parent=/
  bundle_name=${bundle##*/}
  [[ $bundle_parent != / && $bundle_parent != *','* && $bundle_parent != *$'\n'* ]] \
    || die ARTIFACT_VALIDATE_BUNDLE_PARENT
  [[ $bundle_name != . && $bundle_name != .. ]] || die ARTIFACT_VALIDATE_BUNDLE_ROOT
  [[ -n $DOCKER_BIN ]] || die MISSING_COMMAND_docker
  "$DOCKER_BIN" image inspect capstone-decision-platform:p1-local >/dev/null 2>&1 \
    || die RUN_CAPSTONE_UP_FIRST
  result=$("$DOCKER_BIN" run --rm --pull never --network none --read-only \
    --cap-drop ALL --security-opt no-new-privileges:true \
    --pids-limit 64 --memory 1g --cpus 1.0 \
    --tmpfs /tmp:size=64m,mode=1777 \
    --user "$(id -u):$(id -g)" \
    --env PROVIDER_LIVE_CALLS_ENABLED=false --env KIS_OFFLINE=1 \
    --mount "type=bind,src=$bundle_parent,dst=/owner,readonly" \
    --entrypoint python capstone-decision-platform:p1-local \
    -m app.p1_owner.importer \
    --bundle-root "/owner/$bundle_name" \
    --manifest-sha256 "$manifest_sha" \
    --archive-parent /tmp/archive \
    --validate-only) || die TEAM_B_ARTIFACT_VALIDATION_FAILED
  printf '%s\nTEAM_B_LOCAL_VALIDATION=PASS\nPROVIDER_CALLS=0\n' "$result"
}

command=${1:-}
[[ -n $command ]] || { usage >&2; exit 1; }
shift
case $command in
  up) up_app "$@" ;;
  doctor) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; doctor ;;
  status) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; status ;;
  logs) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; logs ;;
  smoke) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; smoke ;;
  down) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; down ;;
  mock)
    subcommand=${1:-}; [[ -n $subcommand ]] || die MOCK_COMMAND_REQUIRED; shift
    case $subcommand in
      configure) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_configure ;;
      doctor) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_doctor || die KIS_MOCK_NOT_READY ;;
      certify) mock_certify "$@" ;;
      readiness) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_readiness ;;
      start) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_start ;;
      stop) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_stop ;;
      *) die UNKNOWN_MOCK_COMMAND ;;
    esac
    ;;
  artifact)
    subcommand=${1:-}; [[ -n $subcommand ]] || die ARTIFACT_COMMAND_REQUIRED; shift
    case $subcommand in
      validate|import)
        bundle=${1:-}; shift || true
        [[ ${1:-} == --manifest-sha256 ]] || die ARTIFACT_MANIFEST_ARGUMENT_REQUIRED
        shift
        [[ $# == 1 ]] || die ARTIFACT_ARGUMENTS
        if [[ $subcommand == validate ]]; then
          artifact_validate "$bundle" "${1:-}"
        else
          artifact_import "$bundle" "${1:-}"
        fi
        ;;
      *) die UNKNOWN_ARTIFACT_COMMAND ;;
    esac
    ;;
  team-a)
    subcommand=${1:-}; [[ -n $subcommand ]] || die TEAM_A_COMMAND_REQUIRED; shift
    case $subcommand in
      acceptance) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; team_a_acceptance ;;
      *) die UNKNOWN_TEAM_A_COMMAND ;;
    esac
    ;;
  preview|start) up_app "$@" ;;
  stop) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; down ;;
  -h|--help|help) usage ;;
  *) usage >&2; die UNKNOWN_COMMAND ;;
esac
