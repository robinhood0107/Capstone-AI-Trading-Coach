# Compute signals in the application container and persist them through the isolated seed role.
replay_history() {
  local start=${P1_HISTORY_REPLAY_START:-2026-08-18}
  local end=${P1_HISTORY_REPLAY_END:-}
  if [[ -z $end ]]; then
    end=$(date -d 'yesterday' +%F 2>/dev/null || date +%F)
  fi
  # The non-root seed container requires group-readable replay input.
  install -d -m 0750 -g "${P1_SECRET_GID:-$(id -g)}" "$STATE_DIR/replay" 2>/dev/null \
    || install -d -m 0750 "$STATE_DIR/replay"
  local signals=$STATE_DIR/replay/signals.json
  # compose exec bypasses the entrypoint, so load only the required runtime secrets.
  if ! compose exec -T decision-platform sh -c \
      'set -a; . /run/secrets/automation_runtime_env; . /run/secrets/return_inference_env; set +a;
       exec python -m app.p1_owner.history_replay_signals --start "$0" --end "$1" --out -' \
      "$start" "$end" > "$signals" 2>/dev/null; then
    rm -f "$signals"
    printf 'CAPSTONE_HISTORY_REPLAY=SIGNALS_UNAVAILABLE\n'
    return 0
  fi
  chmod 0640 "$signals"
  local seeded
  seeded=$(compose --profile owner run --rm --no-deps history-replay-seed 2>&1 \
    | grep -E '^P1_HISTORY_REPLAY=' | tail -1) || seeded=''
  if [[ -n $seeded ]]; then
    printf '%s\n' "$seeded"
    printf 'CAPSTONE_HISTORY_REPLAY=SEEDED\n'
  else
    printf 'CAPSTONE_HISTORY_REPLAY=UNAVAILABLE\n'
  fi
}

mock_configure() {
  state_ready || die RUN_CAPSTONE_UP_FIRST
  install -d -m 0700 "$STATE_DIR/mock"
  local app_key app_secret account_no
  read -r -s -p 'KIS 모의투자 App Key: ' app_key; printf '\n'
  read -r -s -p 'KIS 모의투자 App Secret: ' app_secret; printf '\n'
  read -r -s -p 'KIS 모의투자 계좌번호(하이픈 제외): ' account_no; printf '\n'
  [[ $app_key =~ ^[^[:space:]]{8,256}$ && $app_secret =~ ^[^[:space:]]{8,512}$ && $account_no =~ ^[0-9]{10}$ ]] \
    || die KIS_MOCK_CREDENTIAL_FORMAT
  account_no="${account_no:0:8}-${account_no:8:2}"
  local bound_account reference_key
  # 바인딩 계좌 id 는 자동운용이 쓰는 계좌와 같아야 한다. 무작위로 만들면 그 id 가 DB 어디에도
  # 없어 두 경계가 서로 다른 계좌를 요구하는 교착이 된다 - Spring 의 getOwnedBuyable 은
  # findOwnedBalance 로 자기 저장소에 있는 계좌를 찾고(없으면 OrderNotFound), python 게이트웨이는
  # KIS_MOCK_BOUND_ACCOUNT_ID 에 묶인 계좌만 받는다(아니면 PERMISSION_DENIED). 실측으로 그
  # 교착 때문에 ORDER_SIZING 이 매번 닫혔고, KIS_MOCK 자동매매가 한 번도 주문에 도달하지 못했다.
  #
  # 이 id 는 KIS 자격증명이 아니다. app key/secret/계좌번호와 무관한 식별자이므로 여기서
  # 운용 계좌에 맞춰도 자격증명 재발급이 필요하지 않다.
  bound_account=$(compose exec -T postgres psql -U postgres -d capstone_p1 -At \
    -c 'select account_id from automation_control limit 1' 2>/dev/null | tr -d '[:space:]')
  if [[ ! $bound_account =~ ^acct_[0-9a-f]{32}$ ]]; then
    die KIS_MOCK_BOUND_ACCOUNT_REQUIRES_AUTOMATION_CONTROL
  fi
  reference_key=$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n')
  printf 'KIS_MOCK_CONFIGURED=true\nKIS_MOCK_APP_KEY=%s\nKIS_MOCK_APP_SECRET=%s\nKIS_MOCK_ACCOUNT_NO=%s\nKIS_MOCK_BOUND_ACCOUNT_ID=%s\nKIS_MOCK_ORDER_REFERENCE_KEY=%s\nKIS_BROKERAGE_TOKEN_P_PHYSICAL_CAP=1\nKIS_BROKERAGE_PHYSICAL_CAP=32\n' \
    "$app_key" "$app_secret" "$account_no" "$bound_account" "$reference_key" \
    | write_state secrets/kis-mock.env 0640
  unset app_key app_secret account_no reference_key
  printf 'KIS_MOCK_CONFIGURE=PASS\nKIS_MOCK_BOUND_ACCOUNT_ID=%s\n' "$bound_account"
}

