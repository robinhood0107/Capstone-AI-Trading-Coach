#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd -P)
P1CTL=$SCRIPT_DIR/p1ctl
STATE_DIR=${P1_STATE_DIR:-$SCRIPT_DIR/.state}
STAGE_FILE=$STATE_DIR/full-app-stage
SEED_MANIFEST=$SCRIPT_DIR/seed/public-rag/public-rag-seed.v1.manifest.json
FULL_COMPOSE=$SCRIPT_DIR/compose.yml
FULL_PROJECT_NAME=${P1_PROJECT_NAME:-capstone-p1-full-app}
DEGRADED_PROJECT_NAME=${P1_PROJECT_NAME:-capstone-p1-offline-demo}
PREVIEW_PROJECT_NAME=${P1_PREVIEW_PROJECT_NAME:-capstone-p1-preview}
PREVIEW_STATE_DIR=${P1_PREVIEW_STATE_DIR:-$SCRIPT_DIR/.state-preview}
COMPOSE_PROJECT_NAME=$FULL_PROJECT_NAME
DOCKER_BIN=/usr/bin/docker
[[ -x $DOCKER_BIN ]] || DOCKER_BIN=$(command -v docker 2>/dev/null || true)
RETURN_MANIFEST=$REPO_ROOT/workspaces/return-engine/artifacts/p1-return-engine-manifest.v1.json
DASHBOARD_LOCK=$REPO_ROOT/workspaces/experience-dashboard/package-lock.json
DASHBOARD_DOCKERFILE=$REPO_ROOT/workspaces/experience-dashboard/Dockerfile

die() { printf 'CAPSTONE_ERROR=%s\n' "$1" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "MISSING_COMMAND_$1"; }

usage() {
  cat <<'EOF'
Usage: ./capstone <install|start|preview|stop|status|doctor|backup|restore|verify> [--degraded]

The default lane is the full P1 application and fails closed while a required artifact is absent.
Only install, start, doctor, and verify accept --degraded. `preview` builds and starts the
received Team A/B preview plus the full backend, but grants no release authority. Degraded mode runs the preserved
provider-free Core lane and never implies a full-app release gate PASS.
EOF
}

ensure_state_boundary() {
  require_command python3
  if [[ ! -e $STATE_DIR ]]; then
    python3 "$SCRIPT_DIR/release_guard.py" state-init "$STATE_DIR" || die STATE_INIT
  fi
  python3 "$SCRIPT_DIR/release_guard.py" state-check "$STATE_DIR" || die STATE_BOUNDARY
}

record_stage() {
  ensure_state_boundary
  printf '%s\n' "$1" | python3 "$SCRIPT_DIR/release_guard.py" state-write "$STATE_DIR" full-app-stage 0600
}

is_regular() {
  [[ -f $1 && ! -L $1 ]]
}

full_compose() {
  [[ -n $DOCKER_BIN ]] || die MISSING_COMMAND_docker
  local args=("$DOCKER_BIN" compose --project-name "$COMPOSE_PROJECT_NAME")
  if state_initialized; then
    args+=(--env-file "$STATE_DIR/runtime.env")
  else
    export P1_SECRET_GID=${P1_SECRET_GID:-$(id -g)}
    export P1_SECRETS_DIR=${P1_SECRETS_DIR:-$STATE_DIR/secrets}
  fi
  args+=(-f "$FULL_COMPOSE")
  "${args[@]}" "$@"
}

model_runtime_preflight() {
  local missing=0
  if [[ -z $DOCKER_BIN ]] || ! "$DOCKER_BIN" compose version >/dev/null 2>&1; then
    printf 'CAPSTONE_FULL_BLOCKER=DOCKER_COMPOSE_UNAVAILABLE\n' >&2
    return 1
  fi
  if ! is_regular "$FULL_COMPOSE" || ! full_compose config --quiet; then
    printf 'CAPSTONE_FULL_BLOCKER=MODEL_RUNTIME_COMPOSE_INVALID\n' >&2
    missing=1
  fi
  ((missing == 0))
}

install_model_runtimes() {
  model_runtime_preflight || die MODEL_RUNTIME_PREFLIGHT
  full_compose pull bge-m3 paddleocr-vl
  record_stage MODEL_RUNTIME_IMAGES_PULLED
  printf 'CAPSTONE_MODEL_RUNTIME_IMAGES=PULLED_OFFICIAL\n'
}

build_preview_core_images() {
  "$DOCKER_BIN" build -f "$SCRIPT_DIR/docker/spring-api.Dockerfile" \
    -t capstone-spring-api:p1-local "$REPO_ROOT"
  "$DOCKER_BIN" build -f "$SCRIPT_DIR/docker/python-services.Dockerfile" \
    -t capstone-python-services:p1-local "$REPO_ROOT"
  "$DOCKER_BIN" build -f "$SCRIPT_DIR/docker/postgres-pgvector.Dockerfile" \
    -t capstone-postgres-pgvector:p1-local "$REPO_ROOT"
}

full_preflight() {
  local missing=0
  require_command python3
  local return_present=1
  if ! model_runtime_preflight; then
    missing=1
  fi
  if ! is_regular "$SEED_MANIFEST"; then
    printf 'CAPSTONE_FULL_BLOCKER=PUBLIC_RAG_SEED_MANIFEST_MISSING\n' >&2
    missing=1
  elif ! "$SCRIPT_DIR/verify-public-rag-seed" "$SEED_MANIFEST" >/dev/null; then
    printf 'CAPSTONE_FULL_BLOCKER=PUBLIC_RAG_SEED_INTEGRITY_FAILED\n' >&2
    missing=1
  fi
  if ! is_regular "$RETURN_MANIFEST"; then
    printf 'CAPSTONE_FULL_BLOCKER=TEAM_B_REAL_ARTIFACT_MISSING\n' >&2
    missing=1
    return_present=0
  fi
  if ((return_present)) && ! python3 "$REPO_ROOT/contracts/verify_p1_full_app_assets.py" \
    --return-manifest "$RETURN_MANIFEST" --repository-root "$REPO_ROOT"; then
    printf 'CAPSTONE_FULL_BLOCKER=TEAM_B_ASSET_INTEGRITY_FAILED\n' >&2
    missing=1
  fi
  if ! is_regular "$DASHBOARD_LOCK" || ! is_regular "$DASHBOARD_DOCKERFILE"; then
    printf 'CAPSTONE_FULL_CAPABILITY=DASHBOARD_UI_PARTIAL_TEAM_A_ACTION_REQUIRED\n' >&2
  fi
  if ((missing)); then
    record_stage BLOCKED_REQUIRED_ARTIFACTS
    return 1
  fi
  printf 'CAPSTONE_PUBLIC_RAG_SEED_STATIC=PASS\n'
  printf 'CAPSTONE_MODEL_RUNTIMES=OFFICIAL_COMPOSE_PINNED\n'
  printf 'CAPSTONE_FULL_PREFLIGHT=STATIC_ASSET_INTEGRITY_PASS\n'
}

degraded_doctor() {
  require_command docker
  require_command openssl
  require_command python3
  docker compose version >/dev/null 2>&1 || die DOCKER_COMPOSE_UNAVAILABLE
  printf 'CAPSTONE_DEGRADED_DOCTOR=PASS\n'
  printf 'CAPSTONE_RELEASE_AUTHORITY=NONE\n'
}

state_initialized() {
  [[ -f $STATE_DIR/runtime.env && ! -L $STATE_DIR/runtime.env ]]
}

selected_project_name() {
  if [[ -f $STAGE_FILE && ! -L $STAGE_FILE ]] && grep -q '^DEGRADED_' "$STAGE_FILE"; then
    printf '%s\n' "$DEGRADED_PROJECT_NAME"
  else
    printf '%s\n' "$FULL_PROJECT_NAME"
  fi
}

install_degraded() {
  if ! state_initialized; then
    P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$DEGRADED_PROJECT_NAME "$P1CTL" init
  else
    P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$DEGRADED_PROJECT_NAME "$P1CTL" verify >/dev/null
  fi
  record_stage DEGRADED_INSTALLED
  printf 'CAPSTONE_INSTALL=DEGRADED_CORE_ONLY\n'
  printf 'CAPSTONE_RELEASE_AUTHORITY=NONE\n'
}

install_full() {
  install_model_runtimes
  full_preflight || die FULL_INSTALL_BLOCKED_REQUIRED_ARTIFACTS
  if ! state_initialized; then
    P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$FULL_PROJECT_NAME "$P1CTL" init
  fi
  P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$FULL_PROJECT_NAME "$P1CTL" verify >/dev/null
  full_compose config --quiet
  record_stage FULL_INSTALLED_NOT_STARTED
  printf 'CAPSTONE_INSTALL=FULL_ASSETS_VERIFIED\n'
}

start_degraded() {
  state_initialized || die NOT_INSTALLED
  P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$DEGRADED_PROJECT_NAME "$P1CTL" up db
  record_stage DEGRADED_RUNNING
  printf 'CAPSTONE_START=DEGRADED_CORE_ONLY\n'
  printf 'CAPSTONE_RELEASE_AUTHORITY=NONE\n'
}

start_full() {
  full_preflight || die FULL_START_BLOCKED_REQUIRED_ARTIFACTS
  state_initialized || die NOT_INSTALLED
  P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$FULL_PROJECT_NAME "$P1CTL" verify >/dev/null
  full_compose up -d --force-recreate --wait
  record_stage FULL_SEED_AND_CORE_RUNNING
  printf 'CAPSTONE_START=FULL_SEED_AND_CORE_RUNNING\n'
}

start_preview() {
  # Existing historical state/volumes may have a different secret schema. Preview gets a
  # reproducible isolated state and project while continuing to use this one compose file.
  STATE_DIR=$PREVIEW_STATE_DIR
  STAGE_FILE=$STATE_DIR/full-app-stage
  COMPOSE_PROJECT_NAME=$PREVIEW_PROJECT_NAME
  model_runtime_preflight || die PREVIEW_MODEL_RUNTIME_PREFLIGHT
  build_preview_core_images
  is_regular "$SEED_MANIFEST" || die PUBLIC_RAG_SEED_MANIFEST_MISSING
  "$SCRIPT_DIR/verify-public-rag-seed" "$SEED_MANIFEST" >/dev/null || die PUBLIC_RAG_SEED_INTEGRITY_FAILED
  if ! state_initialized; then
    P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$PREVIEW_PROJECT_NAME "$P1CTL" init
  fi
  P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$PREVIEW_PROJECT_NAME "$P1CTL" verify >/dev/null
  full_compose --profile preview config --quiet
  full_compose --profile preview build experience-dashboard return-engine-preview-run
  full_compose --profile preview up -d --force-recreate --wait experience-dashboard team-b-received-artifact
  record_stage PREVIEW_RUNNING_NOT_RELEASE
  printf 'CAPSTONE_PREVIEW=RUNNING\n'
  printf 'CAPSTONE_DASHBOARD_URL=http://127.0.0.1:%s\n' "${P1_DASHBOARD_PORT:-3000}"
  printf 'CAPSTONE_TEAM_B_PREVIEW_URL=http://127.0.0.1:%s/artifact\n' "${P1_TEAM_B_PREVIEW_PORT:-18090}"
  printf 'TEAM_B_REAL_ARTIFACT_MISSING=TRUE\n'
  printf 'CAPSTONE_RELEASE_AUTHORITY=NONE\n'
}

show_status() {
  if [[ -f $STAGE_FILE && ! -L $STAGE_FILE ]]; then
    printf 'CAPSTONE_INSTALL_STAGE=%s\n' "$(<"$STAGE_FILE")"
  else
    printf 'CAPSTONE_INSTALL_STAGE=NOT_INSTALLED\n'
  fi
  if state_initialized; then
    P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME="$(selected_project_name)" "$P1CTL" status
  fi
  if [[ -n $DOCKER_BIN ]] && "$DOCKER_BIN" compose version >/dev/null 2>&1; then
    full_compose --profile preview ps
  fi
}

stop_full() {
  state_initialized || die NOT_INSTALLED
  P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME="$(selected_project_name)" "$P1CTL" stop
  full_compose --profile preview stop
  record_stage FULL_STOPPED_VOLUMES_PRESERVED
  printf 'CAPSTONE_MODEL_CACHE_VOLUMES_PRESERVED=TRUE\n'
}

mode=full
command=${1:-}
[[ -n $command ]] || { usage >&2; exit 1; }
shift
if [[ ${1:-} == --degraded ]]; then
  mode=degraded
  shift
fi
[[ $# == 0 ]] || die UNEXPECTED_ARGUMENTS

case $command in
  install) [[ $mode == degraded ]] && install_degraded || install_full ;;
  start) [[ $mode == degraded ]] && start_degraded || start_full ;;
  preview) [[ $mode == full ]] || die DEGRADED_NOT_ACCEPTED; start_preview ;;
  stop) [[ $mode == full ]] || die DEGRADED_NOT_ACCEPTED; stop_full ;;
  status) [[ $mode == full ]] || die DEGRADED_NOT_ACCEPTED; show_status ;;
  doctor) [[ $mode == degraded ]] && degraded_doctor || full_preflight ;;
  backup) [[ $mode == full ]] || die DEGRADED_NOT_ACCEPTED; P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME="$(selected_project_name)" "$P1CTL" backup ;;
  restore)
    [[ $mode == full ]] || die DEGRADED_NOT_ACCEPTED
    printf 'CAPSTONE_RESTORE=BLOCKED_G7_ATOMIC_RESTORE_NOT_IMPLEMENTED\n' >&2
    exit 1
    ;;
  verify)
    if [[ $mode == degraded ]]; then
      degraded_doctor
      state_initialized || die NOT_INSTALLED
      P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$DEGRADED_PROJECT_NAME "$P1CTL" verify
    else
      full_preflight
      state_initialized || die NOT_INSTALLED
      P1_STATE_DIR=$STATE_DIR P1_PROJECT_NAME=$FULL_PROJECT_NAME "$P1CTL" verify
    fi
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; die UNKNOWN_COMMAND ;;
esac
