  certification_session=$(python3 - "$receipt" <<'PY'
import json, pathlib, sys
from datetime import datetime
from zoneinfo import ZoneInfo
value=json.loads(pathlib.Path(sys.argv[1]).read_bytes())
timestamp=datetime.fromisoformat(value["timestamp"].removesuffix("Z")+"+00:00")
print(timestamp.astimezone(ZoneInfo("Asia/Seoul")).date().isoformat())
PY
)
  head=$(git -C "$REPO_ROOT" rev-parse HEAD)
