mock_certify() {
  local symbol= quantity=
  while (($#)); do
    case $1 in
      --symbol) symbol=${2:-}; shift ;;
      --quantity) quantity=${2:-}; shift ;;
      *) die UNEXPECTED_ARGUMENT ;;
    esac
    shift
  done
  [[ $symbol == 005930 && $quantity == 1 ]] || die KIS_MOCK_CERTIFICATION_SCOPE
  state_ready || die NOT_INITIALIZED
  # XKRX 휴장일과 09:10~15:00 수동 실행창을 credential/transport 생성보다 먼저 닫는다.
  compose run --rm --no-deps --entrypoint python decision-platform \
    -m app.brokerage.kis_mock_certification_gate || return $?
  mock_doctor >/dev/null || die KIS_MOCK_NOT_CONFIGURED
  # 인증을 CI에 묶던 네 조건(clean worktree·브랜치 접두사·HEAD==origin·PR 초록)은
  # 제거했다. 남은 것은 거래시간 창, --symbol/--quantity scope, 물리 호출 캡이다.
  # 영수증은 그대로 만들어지고 자동운용 arm의 열쇠 역할도 그대로지만, 이 인증이
  # 검증된 코드에서 나왔다는 주장은 더 이상 하지 않는다. 영수증이 말하는 것은
  # 그 시각 KIS 모의 원장에서 왕복이 실제로 일어났다는 사실뿐이다.
  require_command gh
  local branch head pr_json
  branch=$(git -C "$REPO_ROOT" symbolic-ref --quiet --short HEAD) \
    || die KIS_MOCK_CERTIFICATION_DETACHED_HEAD
  head=$(git -C "$REPO_ROOT" rev-parse HEAD)
  pr_json=$(gh pr view --json number,state,isDraft,headRefName,baseRefName,headRefOid,statusCheckRollup) \
    || die KIS_MOCK_CERTIFICATION_PR_UNAVAILABLE
  rm -f -- "$STATE_DIR/mock/certification-request.json" \
    "$STATE_DIR/mock/execution-approval.json" "$STATE_DIR/mock/certification.json"
  # approval latch reader는 owner-only 파일만 받는데 kis-mock.env는 decision-platform과
  # 공유하느라 group-readable이어야 한다. API credential은 빼고 latch 두 값만 별도 파일로 준다.
  grep -E '^(KIS_MOCK_BOUND_ACCOUNT_ID|KIS_MOCK_ORDER_REFERENCE_KEY)=' "$SECRETS_DIR/kis-mock.env" \
    | write_state mock/approval-latch.env 0600
  P1_PR_JSON=$pr_json P1_BRANCH=$branch P1_HEAD=$head python3 - <<'PY' \
    | write_state mock/certification-request.json 0600
import hashlib, json, os
raw=json.loads(os.environ["P1_PR_JSON"])
required={
  "Contract schema validation",
  "Spring OpenAPI drift",
  "Kotlin ktlint and build",
  "Python quality gates",
  "Repo hygiene",
  "P1 full-app security gates",
}
security_evidence={
  "deepScan":"NOT_RUN_USER_SCOPED_OUT",
  "headSha":os.environ["P1_HEAD"],
  "requiredChecks":sorted(required),
  "status":"NOT_VERIFIED",
}
security_digest=hashlib.sha256(
  json.dumps(security_evidence, sort_keys=True, separators=(",", ":")).encode()
).hexdigest()
request={
  "branch":os.environ["P1_BRANCH"],
  "commitSha":os.environ["P1_HEAD"],
  "pullRequest":raw["number"],
  "quantity":1,
  "requiredChecks":sorted(required),
  "securityEvidenceDigest":security_digest,
  "symbol":"005930",
}
# certification CLI는 canonical_json_bytes와 byte 단위로 비교한다. canonical form은 끝에
# 개행을 포함하므로 여기서도 개행을 남긴다.
print(json.dumps(request, sort_keys=True, separators=(",", ":")))
PY
  compose up -d --wait postgres redis
  compose --profile owner run --rm --no-deps kis-mock-certification-runner \
    python -m app.brokerage.kis_mock_certification_cli author
  compose --profile owner run --rm --no-deps kis-mock-certification-runner
  mock_certified >/dev/null || die KIS_MOCK_CERTIFICATION_RECEIPT_INVALID
  author_automation_gate >/dev/null 2>&1 || true
  printf 'KIS_MOCK_CERTIFICATION=PASS\nKIS_LIVE_BROKERAGE=DISABLED\n'
}

author_automation_gate() {
  local receipt=$STATE_DIR/mock/certification.json
