  if [[ $action == stage ]]; then
    state_ready || die NOT_INITIALIZED
    upgrade_state
    compose ps --status running --services | grep -qx postgres || die MARKET_DATA_POSTGRES_NOT_RUNNING
  fi
  compose --profile owner run --rm --no-deps \
    --user "$(id -u):$(id -g)" -e "P1_OPERATOR_UID=$(id -u)" \
    -v "$parent:/owner-input:ro" market-data-cli \
    python -m app.data.market_data.automation_bootstrap_cli "$action" \
      --archive-root "/owner-input/$name" --expected-manifest-sha256 "$expected"
}

after_hours_replay() {
  local manifest_sha=${1:-}
  [[ $manifest_sha =~ ^[0-9a-f]{64}$ ]] || die AFTER_HOURS_REPLAY_MANIFEST_SHA256
  if [[ $PROJECT_NAME != capstone-p1-after-hours-replay ]]; then
    [[ $PROJECT_NAME == capstone-p1 && ${P1_AFTER_HOURS_REPLAY_READONLY_CURRENT:-false} == true ]] \
      || die AFTER_HOURS_REPLAY_PROJECT_ISOLATION
  fi
  state_ready || die NOT_INITIALIZED
  upgrade_state
  compose ps --status running --services | grep -qx postgres || die AFTER_HOURS_REPLAY_POSTGRES_NOT_RUNNING
  export P1_AFTER_HOURS_OUTPUT_ROOT=$STATE_DIR/artifacts/after-hours-replay
  export P1_AFTER_HOURS_OBSERVED_ANCHOR_ROOT=$REPO_ROOT/artifacts/decision-platform/live-rehearsal
  export P1_AFTER_HOURS_OBSERVED_ANCHOR_MANIFEST=$REPO_ROOT/contracts/catalogs/p1-after-hours-observed-anchors.v1.json
  install -d -m 0700 "$P1_AFTER_HOURS_OUTPUT_ROOT"
  compose --profile owner run --rm --no-deps \
    --user "$(id -u):$(id -g)" -e "P1_OPERATOR_UID=$(id -u)" \
    -e P1_AFTER_HOURS_HISTORICAL_REPLAY_E2E=1 \
    -e PYTHONPATH=/app:/app/workspaces/decision-platform/python-services \
    -v "$REPO_ROOT/workspaces/decision-platform/python-services/tests:/app/workspaces/decision-platform/python-services/tests:ro" \
    after-hours-replay \
    python -m tests.e2e.after_hours_historical_replay_e2e \
      --manifest-sha256 "$manifest_sha" \
      --out /replay-output/after-hours-historical-replay-e2e.json \
      --replay-output-root /replay-output \
      --observed-anchor-root /observed-anchors \
      --observed-anchor-manifest /observed-anchor-manifest.json
}

command=${1:-}
[[ -n $command ]] || { usage >&2; exit 1; }
shift
case $command in
  up) up_app "$@" ;;
  doctor) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; doctor ;;
  status) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; status ;;
  logs) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; logs ;;
  smoke) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; smoke ;;
  down) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; down ;;
  mock)
    subcommand=${1:-}; [[ -n $subcommand ]] || die MOCK_COMMAND_REQUIRED; shift
    case $subcommand in
      configure) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_configure ;;
      doctor) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_doctor || die KIS_MOCK_NOT_READY ;;
      certify) mock_certify "$@" ;;
      readiness) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_readiness ;;
      gate-author) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; author_automation_gate ;;
      start) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_start ;;
      stop) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; mock_stop ;;
      *) die UNKNOWN_MOCK_COMMAND ;;
    esac
    ;;
  credential)
    subcommand=${1:-}; [[ -n $subcommand ]] || die CREDENTIAL_COMMAND_REQUIRED; shift
    case $subcommand in
      rotate) credential_rotate "$@" ;;
      *) die UNKNOWN_CREDENTIAL_COMMAND ;;
    esac
    ;;
  artifact)
    subcommand=${1:-}; [[ -n $subcommand ]] || die ARTIFACT_COMMAND_REQUIRED; shift
    case $subcommand in
      validate|import)
        bundle=${1:-}; shift || true
        [[ ${1:-} == --manifest-sha256 ]] || die ARTIFACT_MANIFEST_ARGUMENT_REQUIRED
        shift
        [[ $# == 1 ]] || die ARTIFACT_ARGUMENTS
        if [[ $subcommand == validate ]]; then
          artifact_validate "$bundle" "${1:-}"
        else
          artifact_import "$bundle" "${1:-}"
        fi
        ;;
      *) die UNKNOWN_ARTIFACT_COMMAND ;;
    esac
    ;;
  market-data)
    subcommand=${1:-}; [[ -n $subcommand ]] || die MARKET_DATA_COMMAND_REQUIRED; shift
    case $subcommand in
      inventory) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; market_data_inventory ;;
      refresh) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; market_data_daily_refresh ;;
      universe)
        action=${1:-}; [[ $action == refresh ]] || die MARKET_DATA_UNIVERSE_ACTION_REQUIRED; shift
        [[ ${1:-} == --as-of ]] || die MARKET_DATA_END_ARGUMENT_REQUIRED
        shift; as_of=${1:-}; shift || true
        [[ ${1:-} == --output-root ]] || die MARKET_DATA_OUTPUT_ARGUMENT_REQUIRED
        shift; [[ $# == 1 ]] || die MARKET_DATA_UNIVERSE_REFRESH_ARGUMENTS
        market_data_universe_refresh "$as_of" "${1:-}"
        ;;
      bootstrap)
        action=${1:-}; [[ -n $action ]] || die MARKET_DATA_BOOTSTRAP_ACTION_REQUIRED; shift
        case $action in
          plan)
            [[ ${1:-} == --universe-manifest ]] || die MARKET_DATA_UNIVERSE_ARGUMENT_REQUIRED
            shift; manifest=${1:-}; shift || true
            [[ ${1:-} == --end-session ]] || die MARKET_DATA_END_ARGUMENT_REQUIRED
            shift; end_session=${1:-}; shift || true
            session_count=756
            if [[ ${1:-} == --session-count ]]; then
              shift; session_count=${1:-}; shift || true
            fi
            [[ $# == 0 ]] || die MARKET_DATA_PLAN_ARGUMENTS
            market_data_bootstrap_plan "$manifest" "$end_session" "$session_count"
            ;;
          run)
            [[ ${1:-} == --packet ]] || die MARKET_DATA_PACKET_ARGUMENT_REQUIRED
            shift; packet=${1:-}; shift || true
            [[ ${1:-} == --universe-manifest ]] || die MARKET_DATA_UNIVERSE_ARGUMENT_REQUIRED
            shift; manifest=${1:-}; shift || true
            [[ ${1:-} == --end-session ]] || die MARKET_DATA_END_ARGUMENT_REQUIRED
            shift; end_session=${1:-}; shift || true
            session_count=756
            if [[ ${1:-} == --session-count ]]; then
              shift; session_count=${1:-}; shift || true
            fi
            [[ ${1:-} == --output-root ]] || die MARKET_DATA_OUTPUT_ARGUMENT_REQUIRED
            shift; [[ $# == 1 ]] || die MARKET_DATA_RUN_ARGUMENTS
            market_data_bootstrap_run "$packet" "$manifest" "$end_session" "$session_count" "${1:-}"
            ;;
          validate|stage)
            archive=${1:-}; shift || true
            [[ ${1:-} == --manifest-sha256 ]] || die MARKET_DATA_MANIFEST_ARGUMENT_REQUIRED
            shift; [[ $# == 1 ]] || die MARKET_DATA_ARCHIVE_ARGUMENTS
            market_data_bootstrap_archive "$action" "$archive" "${1:-}"
            ;;
          *) die UNKNOWN_MARKET_DATA_BOOTSTRAP_ACTION ;;
        esac
        ;;
      *) die UNKNOWN_MARKET_DATA_COMMAND ;;
    esac
    ;;
  team-a)
    subcommand=${1:-}; [[ -n $subcommand ]] || die TEAM_A_COMMAND_REQUIRED; shift
    case $subcommand in
      acceptance) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; team_a_acceptance ;;
      *) die UNKNOWN_TEAM_A_COMMAND ;;
    esac
    ;;
  test)
    subcommand=${1:-}; [[ -n $subcommand ]] || die TEST_COMMAND_REQUIRED; shift
    case $subcommand in
      after-hours-replay)
        [[ ${1:-} == --manifest-sha256 ]] || die AFTER_HOURS_REPLAY_MANIFEST_ARGUMENT_REQUIRED
        shift; [[ $# == 1 ]] || die AFTER_HOURS_REPLAY_ARGUMENTS
        after_hours_replay "${1:-}"
        ;;
      *) die UNKNOWN_TEST_COMMAND ;;
    esac
    ;;
  preview|start) up_app "$@" ;;
  stop) [[ $# == 0 ]] || die UNEXPECTED_ARGUMENT; down ;;
  -h|--help|help) usage ;;
  *) usage >&2; die UNKNOWN_COMMAND ;;
esac
