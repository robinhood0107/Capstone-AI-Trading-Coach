replace_env_value() {
  local file=$1 key=$2 value=$3 line name
  grep -q "^${key}=" "$file" || die CREDENTIAL_ROTATION_ENV_KEY_MISSING
  while IFS= read -r line || [[ -n $line ]]; do
    name=${line%%=*}
    if [[ $name == "$key" ]]; then
      printf '%s=%s\n' "$key" "$value"
    else
      printf '%s\n' "$line"
    fi
  done < "$file"
}

credential_rotate() (
  local target=${1:-} password_file=${2:-} user_id bundle_name password_name bundle_key
  local rotation_dir bundle_file rotation_env spring_image migration_password separation_key bundle
  [[ $# == 2 ]] || die CREDENTIAL_ROTATION_ARGUMENTS
  [[ $password_file == /* && -f $password_file && ! -L $password_file ]] \
    || die CREDENTIAL_ROTATION_PASSWORD_FILE
  [[ $(stat -c '%a' "$password_file") =~ ^(400|600|640)$ ]] \
    || die CREDENTIAL_ROTATION_PASSWORD_FILE_MODE
  case $target in
    user)
      user_id=usr_demo_user
      bundle_name=demo-user.bundle
      password_name=demo-user.password
      bundle_key=DEMO_USER_CREDENTIAL_BUNDLE
      ;;
    admin)
      user_id=usr_demo_admin
      bundle_name=demo-admin.bundle
      password_name=demo-admin.password
      bundle_key=DEMO_ADMIN_CREDENTIAL_BUNDLE
      ;;
    *) die CREDENTIAL_ROTATION_TARGET ;;
  esac
  state_ready || die NOT_INITIALIZED
  upgrade_state
  compose ps --status running --services | grep -qx postgres || die CREDENTIAL_ROTATION_POSTGRES_NOT_RUNNING
  python3 - "$password_file" "$target" <<'PY' || exit 1
import sys
from pathlib import Path

raw = Path(sys.argv[1]).read_text(encoding="utf-8").rstrip("\r\n")
folded = raw.casefold()
blocked = {
    "123456789012345", "1234567890123456", "qwertyuiop12345",
    "passwordpassword", "letmeinletmein123", "welcome123456789",
}
fragments = ("capstone", "trading", "coach", "password", "passwd", "demo-user", "demo-admin")
if not 15 <= len(raw) <= 64 or len(raw.encode("utf-8")) > 72:
    raise SystemExit("CAPSTONE_ERROR=CREDENTIAL_ROTATION_PASSWORD_LENGTH")
if folded in blocked or any(fragment in folded for fragment in fragments):
    raise SystemExit("CAPSTONE_ERROR=CREDENTIAL_ROTATION_PASSWORD_BLOCKLIST")
PY

  rotation_dir=$(mktemp -d "$STATE_DIR/credential-rotation.XXXXXX")
  trap 'rm -rf -- "$rotation_dir"' EXIT
  bundle_file=$rotation_dir/new.bundle
  rotation_env=$rotation_dir/rotation.env
  spring_image=$(sed -n 's/^P1_SPRING_IMAGE=//p' "$RUNTIME_ENV")
  [[ -n $spring_image ]] || die CREDENTIAL_ROTATION_IMAGE_MISSING

  "$DOCKER_BIN" run --rm --network none --read-only --cap-drop ALL \
    --security-opt no-new-privileges --user "$(id -u):$(id -g)" \
    --tmpfs /tmp:rw,noexec,nosuid,size=16m \
    --mount "type=bind,src=$password_file,dst=/input/password,readonly" \
    --mount "type=bind,src=$SECRETS_DIR/demo-credential-separation.key,dst=/input/separation-key,readonly" \
    --mount "type=bind,src=$rotation_dir,dst=/output" \
    --entrypoint java \
    -e "DEMO_CREDENTIAL_USER_ID=$user_id" \
    -e DEMO_CREDENTIAL_PASSWORD_FILE=/input/password \
    -e DEMO_CREDENTIAL_SEPARATION_KEY_FILE=/input/separation-key \
    -e DEMO_CREDENTIAL_BUNDLE_OUTPUT=/output/new.bundle \
    "$spring_image" -Dloader.main=com.capstone.decision.infrastructure.security.DemoCredentialBundleAuthor \
    -cp /app/app.jar org.springframework.boot.loader.launch.PropertiesLauncher >/dev/null

  migration_password=$(sed -n 's/^POSTGRES_MIGRATION_PASSWORD=//p' "$SECRETS_DIR/migration.env")
  separation_key=$(sed -n 's/^DEMO_CREDENTIAL_SEPARATION_KEY=//p' "$SECRETS_DIR/migration.env")
  bundle=$(<"$bundle_file")
  [[ -n $migration_password && -n $separation_key && -n $bundle ]] \
    || die CREDENTIAL_ROTATION_INPUT_MISSING
  printf '%s\n' \
    'POSTGRES_HOST=127.0.0.1' \
    'POSTGRES_PORT=5432' \
    'POSTGRES_DB=capstone_p1' \
    "POSTGRES_MIGRATION_PASSWORD=$migration_password" \
    "DEMO_CREDENTIAL_USER_ID=$user_id" \
    'DEMO_CREDENTIAL_ROTATION_ACTOR=operator-cli' \
    "DEMO_CREDENTIAL_BUNDLE=$bundle" \
    "DEMO_CREDENTIAL_SEPARATION_KEY=$separation_key" > "$rotation_env"
  chmod 0600 "$rotation_env"

  "$DOCKER_BIN" run --rm --network "container:${PROJECT_NAME}-postgres-1" --read-only \
    --cap-drop ALL --security-opt no-new-privileges --env-file "$rotation_env" \
    --entrypoint java "$spring_image" \
    -Dloader.main=com.capstone.decision.infrastructure.security.DemoCredentialRotation \
    -cp /app/app.jar org.springframework.boot.loader.launch.PropertiesLauncher >/dev/null

  printf '%s' "$bundle" | write_state "secrets/$bundle_name" 0640
  replace_env_value "$SECRETS_DIR/migration.env" "$bundle_key" "$bundle" \
    | write_state secrets/migration.env 0640
  replace_env_value "$SECRETS_DIR/bootstrap.env" "$bundle_key" "$bundle" \
    | write_state secrets/bootstrap.env 0640
  replace_env_value "$SECRETS_DIR/spring.env" "$bundle_key" "$bundle" \
    | write_state secrets/spring.env 0640
  printf '%s' "$(<"$password_file")" | write_state "secrets/$password_name" 0640
  if [[ $target == user ]]; then
    replace_env_value "$SECRETS_DIR/automation-runtime.env" P1_AUTOMATION_OWNER_PASSWORD "$(<"$password_file")" \
      | write_state secrets/automation-runtime.env 0640
  fi
  compose up -d --force-recreate --no-deps --wait decision-platform
  printf 'CAPSTONE_CREDENTIAL_ROTATION=PASS\nTARGET=%s\nSESSIONS_INVALIDATED=YES\n' "$target"
)

