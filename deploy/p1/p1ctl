#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
STATE_DIR=${P1_STATE_DIR:-$SCRIPT_DIR/.state}
SECRETS_DIR=$STATE_DIR/secrets
RUNTIME_ENV=$STATE_DIR/runtime.env
ADAPTER_FILE=$STATE_DIR/adapter
DB_COMPOSE=$SCRIPT_DIR/compose.db.yml
KAFKA_COMPOSE=$SCRIPT_DIR/compose.kafka.yml
OFFLINE_DB_COMPOSE=$SCRIPT_DIR/compose.offline.db.yml
OFFLINE_KAFKA_COMPOSE=$SCRIPT_DIR/compose.offline.kafka.yml
RELEASE_ENV=$SCRIPT_DIR/release.env
RELEASE_MANIFEST=$SCRIPT_DIR/../../release-manifest.json
RELEASE_GUARD=$SCRIPT_DIR/release_guard.py

die() { printf 'P1_ERROR=%s\n' "$1" >&2; exit 1; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "missing_$1"; }
random_secret() { openssl rand -hex 32; }
base64url_key() { openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'; }
state_relative() {
  [[ $1 == "$STATE_DIR/"* ]] || die state_path
  printf '%s\n' "${1#"$STATE_DIR/"}"
}
state_write_file() {
  local path=$1 mode=$2
  python3 "$RELEASE_GUARD" state-write "$STATE_DIR" "$(state_relative "$path")" "$mode"
}
write_line() {
  printf '%s=%s\n' "$1" "$2" | python3 "$RELEASE_GUARD" state-append "$STATE_DIR" "$(state_relative "$3")" 0640
}
docker_bind_source() {
  local source=$1 endpoint
  endpoint=$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true)
  if [[ $endpoint == npipe://* ]]; then
    require_command wslpath
    wslpath -w "$source"
  else
    printf '%s\n' "$source"
  fi
}
PROJECT_NAME=${P1_PROJECT_NAME:-capstone-p1-offline-demo}
[[ $PROJECT_NAME =~ ^[a-z0-9][a-z0-9_-]{2,62}$ ]] || die invalid_project_name

load_release_images() {
  [[ -e $RELEASE_ENV ]] || return 0
  [[ -f $RELEASE_ENV && ! -L $RELEASE_ENV && $(stat -c '%s' "$RELEASE_ENV") -le 1024 ]] || die release_env_boundary
  local seen='|' key value count=0
  while IFS='=' read -r key value || [[ -n $key$value ]]; do
    case $key in
      P1_SPRING_IMAGE)
        [[ $value =~ ^ghcr\.io/robinhood0107/capstone-spring-api@sha256:[0-9a-f]{64}$ ]] || die release_image_reference
        ;;
      P1_PYTHON_IMAGE)
        [[ $value =~ ^ghcr\.io/robinhood0107/capstone-python-services@sha256:[0-9a-f]{64}$ ]] || die release_image_reference
        ;;
      P1_POSTGRES_IMAGE)
        [[ $value =~ ^ghcr\.io/robinhood0107/capstone-postgres-pgvector@sha256:[0-9a-f]{64}$ ]] || die release_image_reference
        ;;
      P1_KAFKA_IMAGE)
        [[ $value =~ ^ghcr\.io/robinhood0107/capstone-kafka@sha256:[0-9a-f]{64}$ ]] || die release_image_reference
        ;;
      *) die release_env_key ;;
    esac
    [[ $seen != *"|$key|"* ]] || die release_env_duplicate
    seen="$seen$key|"
    export "$key=$value"
    count=$((count + 1))
  done < "$RELEASE_ENV"
  [[ $count == 3 || $count == 4 ]] || die release_env_inventory
  [[ $seen == *'|P1_SPRING_IMAGE|'* && $seen == *'|P1_PYTHON_IMAGE|'* && $seen == *'|P1_POSTGRES_IMAGE|'* ]] || die release_env_inventory
  [[ $count == 3 || $seen == *'|P1_KAFKA_IMAGE|'* ]] || die release_env_inventory
}

compose() {
  local mode=${1:?mode}; shift
  local files=(-f "$DB_COMPOSE")
  if [[ $mode == kafka ]]; then files+=(-f "$KAFKA_COMPOSE"); fi
  if [[ -f $RELEASE_ENV ]]; then files+=(-f "$OFFLINE_DB_COMPOSE"); fi
  if [[ $mode == kafka && -f $RELEASE_ENV ]]; then files+=(-f "$OFFLINE_KAFKA_COMPOSE"); fi
  docker compose --project-name "$PROJECT_NAME" --env-file "$RUNTIME_ENV" "${files[@]}" "$@"
}

require_state() {
  python3 "$RELEASE_GUARD" state-check "$STATE_DIR" || die state_boundary
  [[ -d $STATE_DIR && -f $RUNTIME_ENV && -d $SECRETS_DIR ]] || die not_initialized
  [[ ! -L $STATE_DIR && ! -L $SECRETS_DIR && ! -L $RUNTIME_ENV ]] || die state_symlink
  [[ $(stat -c '%a' "$STATE_DIR") == 700 ]] || die state_mode
  [[ $(stat -c '%a' "$SECRETS_DIR") == 700 ]] || die secrets_mode
  [[ $(stat -c '%a' "$RUNTIME_ENV") == 600 ]] || die runtime_env_mode
}

verify_runtime_env() {
  local expected_secrets seen='|' key value count=0 api_port='' secret_gid=''
  expected_secrets=$(docker_bind_source "$SECRETS_DIR")
  while IFS='=' read -r key value || [[ -n $key$value ]]; do
    [[ $seen != *"|$key|"* ]] || die runtime_env_duplicate
    case $key in
      P1_SECRETS_DIR) [[ $value == "$expected_secrets" ]] || die runtime_env_secrets_path ;;
      P1_SECRET_GID) secret_gid=$value ;;
      P1_API_PORT) api_port=$value ;;
      P1_SPRING_IMAGE)
        [[ $value == capstone-spring-api:p1-local || $value =~ ^ghcr\.io/robinhood0107/capstone-spring-api@sha256:[0-9a-f]{64}$ ]] || die runtime_env_image
        ;;
      P1_PYTHON_IMAGE)
        [[ $value == capstone-python-services:p1-local || $value =~ ^ghcr\.io/robinhood0107/capstone-python-services@sha256:[0-9a-f]{64}$ ]] || die runtime_env_image
        ;;
      P1_POSTGRES_IMAGE)
        [[ $value == capstone-postgres-pgvector:p1-local || $value =~ ^ghcr\.io/robinhood0107/capstone-postgres-pgvector@sha256:[0-9a-f]{64}$ ]] || die runtime_env_image
        ;;
      P1_KAFKA_IMAGE)
        [[ $value == capstone-kafka:p1-local || $value =~ ^ghcr\.io/robinhood0107/capstone-kafka@sha256:[0-9a-f]{64}$ ]] || die runtime_env_image
        ;;
      *) die runtime_env_key ;;
    esac
    seen="$seen$key|"
    count=$((count + 1))
  done < "$RUNTIME_ENV"
  [[ $count == 7 ]] || die runtime_env_inventory
  [[ $secret_gid == "$(id -g)" ]] || die runtime_env_secret_gid
  [[ $api_port =~ ^[0-9]{4,5}$ && $api_port -ge 1024 && $api_port -le 65535 ]] || die runtime_env_api_port
}

author_bundle() {
  local image=$1 user_id=$2 password_file=$3 output=$4
  local secrets_mount
  secrets_mount=$(docker_bind_source "$SECRETS_DIR")
  docker run --rm --network none --read-only --cap-drop ALL --security-opt no-new-privileges \
    --user "$(id -u):$(id -g)" --tmpfs /tmp:rw,noexec,nosuid,size=16m \
    --mount "type=bind,src=$secrets_mount,dst=/secrets" \
    --entrypoint java \
    -e "DEMO_CREDENTIAL_USER_ID=$user_id" \
    -e "DEMO_CREDENTIAL_PASSWORD_FILE=/secrets/$(basename "$password_file")" \
    -e DEMO_CREDENTIAL_SEPARATION_KEY_FILE=/secrets/demo-credential-separation.key \
    -e "DEMO_CREDENTIAL_BUNDLE_OUTPUT=/secrets/$(basename "$output")" \
    "$image" -Dloader.main=com.capstone.decision.infrastructure.security.DemoCredentialBundleAuthor \
    -cp /app/app.jar org.springframework.boot.loader.launch.PropertiesLauncher >/dev/null
}

verify_release_boundary() {
  [[ -f $RELEASE_ENV ]] || return 0
  "$SCRIPT_DIR/verify-release" "$SCRIPT_DIR/../.." >/dev/null
}

accept_release() {
  [[ -f $RELEASE_ENV ]] || return 0
  python3 "$RELEASE_GUARD" release-accept "$STATE_DIR" "$RELEASE_MANIFEST" || die release_rollback_or_collision
}

init_state() {
  require_command docker
  require_command openssl
  require_command python3
  verify_release_boundary
  python3 "$RELEASE_GUARD" state-init "$STATE_DIR" || die state_init
  local spring_image=${P1_SPRING_IMAGE:-capstone-spring-api:p1-local}
  docker image inspect "$spring_image" >/dev/null 2>&1 || die spring_image_missing

  local user_password admin_password separation_key broker_token broker_digest
  user_password=$(random_secret)
  admin_password=$(random_secret)
  separation_key=$(base64url_key)
  broker_token=$(random_secret)
  broker_digest=$(printf '%s' "$broker_token" | sha256sum | awk '{print $1}')
  printf '%s' "$user_password" | state_write_file "$SECRETS_DIR/demo-user.password" 0640
  printf '%s' "$admin_password" | state_write_file "$SECRETS_DIR/demo-admin.password" 0640
  printf '%s' "$separation_key" | state_write_file "$SECRETS_DIR/demo-credential-separation.key" 0640
  openssl rand 32 | state_write_file "$SECRETS_DIR/rag-history-kek-v1.key" 0640
  author_bundle "$spring_image" usr_demo_user "$SECRETS_DIR/demo-user.password" "$SECRETS_DIR/demo-user.bundle"
  author_bundle "$spring_image" usr_demo_admin "$SECRETS_DIR/demo-admin.password" "$SECRETS_DIR/demo-admin.bundle"
  local authored_bundle
  authored_bundle=$(<"$SECRETS_DIR/demo-user.bundle")
  printf "%s" "$authored_bundle" | state_write_file "$SECRETS_DIR/demo-user.bundle" 0640
  authored_bundle=$(<"$SECRETS_DIR/demo-admin.bundle")
  printf "%s" "$authored_bundle" | state_write_file "$SECRETS_DIR/demo-admin.bundle" 0640
  unset authored_bundle

  declare -A db
  local role
  for role in APP MIGRATION COLLECTOR DISCLOSURE_READER MARKET_WRITER PORTFOLIO_WRITER RISK_WRITER \
    FILL_WRITER RAG_WRITER RAG_ADMIN RAG_QUERY SIGNAL_WRITER SIGNAL_SCHEDULER SIGNAL_ADMIN WORKER REPLAY \
    OUTBOX_PUBLISHER POISON_RECORDER IDENTITY AUTH REPLAY_AUTHORIZER DEMO; do
    db[$role]=$(random_secret)
  done
  local postgres_password redis_password grpc_secret partition_key
  postgres_password=$(random_secret)
  redis_password=$(random_secret)
  grpc_secret=$(random_secret)
  partition_key=$(random_secret)
  local kafka_admin_password kafka_publisher_password kafka_worker_password poison_recorder_secret
  kafka_admin_password=$(random_secret)
  kafka_publisher_password=$(random_secret)
  kafka_worker_password=$(random_secret)
  poison_recorder_secret=$(random_secret)
  local kafka_private_der_b64 kafka_public_der_b64 kafka_private_key kafka_public_key
  kafka_private_der_b64=$(openssl genpkey -algorithm ED25519 | openssl pkey -outform DER | base64 -w0)
  kafka_public_der_b64=$(printf '%s' "$kafka_private_der_b64" | base64 -d | openssl pkey -inform DER -pubout -outform DER | base64 -w0)
  kafka_private_key=$(printf '%s' "$kafka_private_der_b64" | tr '+/' '-_' | tr -d '=')
  kafka_public_key=$(printf '%s' "$kafka_public_der_b64" | tr '+/' '-_' | tr -d '=')
  local actor_capability_secret actor_private_der_b64 actor_public_der_b64 actor_private_key actor_public_key
  actor_capability_secret=$(random_secret)
  actor_private_der_b64=$(openssl genpkey -algorithm ED25519 | openssl pkey -outform DER | base64 -w0)
  actor_public_der_b64=$(printf '%s' "$actor_private_der_b64" | base64 -d | openssl pkey -inform DER -pubout -outform DER | base64 -w0)
  actor_private_key=$(printf '%s' "$actor_private_der_b64" | tr '+/' '-_' | tr -d '=')
  actor_public_key=$(printf '%s' "$actor_public_der_b64" | tr '+/' '-_' | tr -d '=')

  printf '' | state_write_file "$SECRETS_DIR/postgres.env" 0640
  write_line POSTGRES_PASSWORD "$postgres_password" "$SECRETS_DIR/postgres.env"
  for role in "${!db[@]}"; do write_line "POSTGRES_${role}_PASSWORD" "${db[$role]}" "$SECRETS_DIR/postgres.env"; done
  LC_ALL=C sort -o "$SECRETS_DIR/postgres.env" "$SECRETS_DIR/postgres.env"
  printf '' | state_write_file "$SECRETS_DIR/role-bootstrap.env" 0640
  write_line POSTGRES_ADMIN_USER postgres "$SECRETS_DIR/role-bootstrap.env"
  write_line POSTGRES_PASSWORD "$postgres_password" "$SECRETS_DIR/role-bootstrap.env"
  write_line POSTGRES_AUTH_PASSWORD "${db[AUTH]}" "$SECRETS_DIR/role-bootstrap.env"
  write_line POSTGRES_OUTBOX_PUBLISHER_PASSWORD "${db[OUTBOX_PUBLISHER]}" "$SECRETS_DIR/role-bootstrap.env"
  write_line POSTGRES_POISON_RECORDER_PASSWORD "${db[POISON_RECORDER]}" "$SECRETS_DIR/role-bootstrap.env"
  printf 'REDIS_PASSWORD=%s\n' "$redis_password" | state_write_file "$SECRETS_DIR/redis.env" 0640

  local user_bundle admin_bundle
  user_bundle=$(<"$SECRETS_DIR/demo-user.bundle")
  admin_bundle=$(<"$SECRETS_DIR/demo-admin.bundle")
  printf '' | state_write_file "$SECRETS_DIR/migration.env" 0640
  write_line DEMO_CREDENTIAL_SEPARATION_KEY "$separation_key" "$SECRETS_DIR/migration.env"
  write_line DEMO_USER_CREDENTIAL_BUNDLE "$user_bundle" "$SECRETS_DIR/migration.env"
  write_line DEMO_ADMIN_CREDENTIAL_BUNDLE "$admin_bundle" "$SECRETS_DIR/migration.env"
  write_line POSTGRES_MIGRATION_PASSWORD "${db[MIGRATION]}" "$SECRETS_DIR/migration.env"
  write_line BROKERAGE_DB_CAPABILITY_TOKEN_SHA256 "$broker_digest" "$SECRETS_DIR/migration.env"
  printf '' | state_write_file "$SECRETS_DIR/bootstrap.env" 0640
  write_line POSTGRES_MIGRATION_PASSWORD "${db[MIGRATION]}" "$SECRETS_DIR/bootstrap.env"
  write_line DEMO_CREDENTIAL_SEPARATION_KEY "$separation_key" "$SECRETS_DIR/bootstrap.env"
  write_line DEMO_USER_CREDENTIAL_BUNDLE "$user_bundle" "$SECRETS_DIR/bootstrap.env"
  write_line DEMO_ADMIN_CREDENTIAL_BUNDLE "$admin_bundle" "$SECRETS_DIR/bootstrap.env"

  printf '' | state_write_file "$SECRETS_DIR/spring.env" 0640
  write_line POSTGRES_APP_PASSWORD "${db[APP]}" "$SECRETS_DIR/spring.env"
  write_line POSTGRES_WORKER_PASSWORD "${db[WORKER]}" "$SECRETS_DIR/spring.env"
  write_line POSTGRES_AUTH_PASSWORD "${db[AUTH]}" "$SECRETS_DIR/spring.env"
  write_line ACTOR_CAPABILITY_SHARED_SECRET "$actor_capability_secret" "$SECRETS_DIR/spring.env"
  write_line ACTOR_CAPABILITY_PUBLIC_KEY "$actor_public_key" "$SECRETS_DIR/spring.env"
  printf '' | state_write_file "$SECRETS_DIR/actor-capability-authority.env" 0640
  write_line POSTGRES_IDENTITY_PASSWORD "${db[IDENTITY]}" "$SECRETS_DIR/actor-capability-authority.env"
  write_line ACTOR_CAPABILITY_SHARED_SECRET "$actor_capability_secret" "$SECRETS_DIR/actor-capability-authority.env"
  write_line ACTOR_CAPABILITY_PRIVATE_KEY "$actor_private_key" "$SECRETS_DIR/actor-capability-authority.env"
  write_line ACTOR_CAPABILITY_PUBLIC_KEY "$actor_public_key" "$SECRETS_DIR/actor-capability-authority.env"
  write_line REDIS_PASSWORD "$redis_password" "$SECRETS_DIR/spring.env"
  write_line JWT_ISSUER capstone-p1-offline-demo "$SECRETS_DIR/spring.env"
  write_line JWT_AUDIENCE capstone-p1-offline-demo-users "$SECRETS_DIR/spring.env"
  write_line BROKERAGE_DB_CAPABILITY_TOKEN "$broker_token" "$SECRETS_DIR/spring.env"
  write_line BROKERAGE_DB_CAPABILITY_TOKEN_SHA256 "$broker_digest" "$SECRETS_DIR/spring.env"
  write_line DEMO_CREDENTIAL_SEPARATION_KEY "$separation_key" "$SECRETS_DIR/spring.env"
  write_line DEMO_USER_CREDENTIAL_BUNDLE "$user_bundle" "$SECRETS_DIR/spring.env"
  write_line DEMO_ADMIN_CREDENTIAL_BUNDLE "$admin_bundle" "$SECRETS_DIR/spring.env"
  write_line ASYNC_PARTITION_HMAC_KEY "$partition_key" "$SECRETS_DIR/spring.env"
  write_line ASYNC_WORKER_GRPC_SHARED_SECRET "$grpc_secret" "$SECRETS_DIR/spring.env"
  local key
  for key in JWT_SECRET LOGIN_SCOPE_HMAC_KEY PRINCIPLE_CURSOR_HMAC_KEY DECISION_IDEMPOTENCY_SCOPE_HMAC_KEY \
    DECISION_GRPC_SHARED_SECRET BROKERAGE_IDEMPOTENCY_SCOPE_HMAC_KEY RAG_IDEMPOTENCY_SCOPE_HMAC_KEY RAG_REQUEST_FINGERPRINT_HMAC_KEY \
    RAG_PROVIDER_USAGE_HMAC_KEY RAG_RATE_LIMIT_HMAC_KEY RAG_HISTORY_CURSOR_HMAC_KEY ASYNC_CURSOR_HMAC_KEY; do
    write_line "$key" "$(random_secret)" "$SECRETS_DIR/spring.env"
  done

  printf '' | state_write_file "$SECRETS_DIR/python.env" 0640
  write_line ASYNC_WORKER_DATABASE_DSN "postgresql://decision_worker:${db[WORKER]}@postgres:5432/capstone_p1?sslmode=disable" "$SECRETS_DIR/python.env"
  write_line ASYNC_PARTITION_HMAC_KEY "$partition_key" "$SECRETS_DIR/python.env"
  write_line ASYNC_WORKER_GRPC_SHARED_SECRET "$grpc_secret" "$SECRETS_DIR/python.env"
  write_line KAFKA_SASL_USERNAME p1_async_worker "$SECRETS_DIR/python.env"
  write_line KAFKA_SASL_PASSWORD "$kafka_worker_password" "$SECRETS_DIR/python.env"
  write_line KAFKA_ENVELOPE_PUBLIC_KEY "$kafka_public_key" "$SECRETS_DIR/python.env"
  write_line POISON_RECORDER_URL http://127.0.0.1:18082/internal/kafka/poison-receipts "$SECRETS_DIR/python.env"
  write_line POISON_RECORDER_SHARED_SECRET "$poison_recorder_secret" "$SECRETS_DIR/python.env"
  printf '' | state_write_file "$SECRETS_DIR/kafka-publisher.env" 0640
  write_line OUTBOX_PUBLISHER_DATABASE_DSN "postgresql://decision_outbox_publisher:${db[OUTBOX_PUBLISHER]}@postgres:5432/capstone_p1?sslmode=disable" "$SECRETS_DIR/kafka-publisher.env"
  write_line KAFKA_SASL_USERNAME p1_outbox_publisher "$SECRETS_DIR/kafka-publisher.env"
  write_line KAFKA_SASL_PASSWORD "$kafka_publisher_password" "$SECRETS_DIR/kafka-publisher.env"
  write_line KAFKA_ENVELOPE_PRIVATE_KEY "$kafka_private_key" "$SECRETS_DIR/kafka-publisher.env"
  printf '' | state_write_file "$SECRETS_DIR/poison-recorder.env" 0640
  write_line POISON_RECORDER_DATABASE_DSN "postgresql://decision_poison_recorder:${db[POISON_RECORDER]}@postgres:5432/capstone_p1?sslmode=disable" "$SECRETS_DIR/poison-recorder.env"
  write_line POISON_RECORDER_SHARED_SECRET "$poison_recorder_secret" "$SECRETS_DIR/poison-recorder.env"
  printf '' | state_write_file "$SECRETS_DIR/kafka-admin.env" 0640
  write_line KAFKA_SASL_USERNAME p1_kafka_admin "$SECRETS_DIR/kafka-admin.env"
  write_line KAFKA_SASL_PASSWORD "$kafka_admin_password" "$SECRETS_DIR/kafka-admin.env"
  printf '%s\n' \
    'KafkaServer {' \
    '  org.apache.kafka.common.security.plain.PlainLoginModule required' \
    "  username=\"p1_kafka_admin\"" \
    "  password=\"$kafka_admin_password\"" \
    "  user_p1_kafka_admin=\"$kafka_admin_password\"" \
    "  user_p1_outbox_publisher=\"$kafka_publisher_password\"" \
    "  user_p1_async_worker=\"$kafka_worker_password\";" \
    '};' | state_write_file "$SECRETS_DIR/kafka-broker-jaas.conf" 0640
  printf '' | state_write_file "$SECRETS_DIR/demo.env" 0640
  write_line P1_DEMO_DATABASE_DSN "postgresql://decision_demo:${db[DEMO]}@postgres:5432/capstone_p1?sslmode=disable" "$SECRETS_DIR/demo.env"
  write_line ASYNC_PARTITION_HMAC_KEY "$partition_key" "$SECRETS_DIR/demo.env"
  local compose_secrets_dir
  compose_secrets_dir=$(docker_bind_source "$SECRETS_DIR")
  printf '%s\n' \
    "P1_SECRETS_DIR=$compose_secrets_dir" \
    "P1_SECRET_GID=$(id -g)" \
    "P1_API_PORT=${P1_API_PORT:-18080}" \
    "P1_SPRING_IMAGE=$spring_image" \
    "P1_PYTHON_IMAGE=${P1_PYTHON_IMAGE:-capstone-python-services:p1-local}" \
    "P1_POSTGRES_IMAGE=${P1_POSTGRES_IMAGE:-capstone-postgres-pgvector:p1-local}" \
    "P1_KAFKA_IMAGE=${P1_KAFKA_IMAGE:-capstone-kafka:p1-local}" \
    | state_write_file "$RUNTIME_ENV" 0600
  chmod 640 "$SECRETS_DIR"/*
  accept_release
  printf 'P1_INITIALIZED=TRUE\nP1_LOGIN_PASSWORD_FILES=%s,%s\n' \
    "$SECRETS_DIR/demo-user.password" "$SECRETS_DIR/demo-admin.password"
}

verify_state() {
  require_state
  verify_runtime_env
  local expected=(actor-capability-authority.env bootstrap.env demo-admin.bundle demo-admin.password demo-credential-separation.key demo.env demo-user.bundle \
    demo-user.password kafka-admin.env kafka-broker-jaas.conf kafka-publisher.env migration.env poison-recorder.env \
    postgres.env python.env rag-history-kek-v1.key redis.env role-bootstrap.env spring.env)
  local actual
  actual=$(find "$SECRETS_DIR" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' | LC_ALL=C sort)
  [[ $actual == "$(printf '%s\n' "${expected[@]}" | LC_ALL=C sort)" ]] || die secret_inventory
  while IFS= read -r file; do
    [[ ! -L $file && -f $file && $(stat -c '%a' "$file") == 640 ]] || die secret_boundary
  done < <(find "$SECRETS_DIR" -mindepth 1 -maxdepth 1 -print)
  compose db config --quiet
  compose kafka config --quiet
  local image arch
  while IFS= read -r image; do
    arch=$(docker image inspect "$image" --format '{{.Architecture}}')
    [[ $arch == amd64 ]] || die image_architecture
  done < <(sed -n 's/^P1_\(SPRING\|PYTHON\|POSTGRES\)_IMAGE=//p' "$RUNTIME_ENV")
  printf 'P1_VERIFY=PASS\n'
}

up_mode() {
  local mode=${1:-}
  [[ $mode == db || $mode == kafka ]] || die invalid_mode
  require_state
  verify_state >/dev/null
  local running
  running=$(compose kafka ps --status running --services 2>/dev/null || true)
  if grep -qx spring-api <<<"$running"; then die stop_before_adapter_switch; fi
  if [[ $mode == db ]]; then
    compose kafka rm -f -s kafka kafka-topic-init >/dev/null
  fi
  verify_release_boundary
  accept_release
  compose "$mode" up -d --force-recreate
  printf '%s\n' "$mode" | state_write_file "$ADAPTER_FILE" 0600
  printf 'P1_UP=%s\n' "$mode"
}

smoke() {
  require_command curl
  require_command python3
  require_state
  [[ -f $ADAPTER_FILE && ! -L $ADAPTER_FILE && $(stat -c '%a' "$ADAPTER_FILE") == 600 ]] || die adapter_state
  local mode
  mode=$(<"$ADAPTER_FILE")
  [[ $mode == db || $mode == kafka ]] || die adapter_state
  local base="http://127.0.0.1:$(sed -n 's/^P1_API_PORT=//p' "$RUNTIME_ENV")"
  local attempt status=000
  for attempt in {1..60}; do
    status=$(curl --silent --output /dev/null --write-out '%{http_code}' "$base/actuator/health" || true)
    [[ $status == 200 ]] && break
    sleep 2
  done
  [[ $status == 200 ]] || die health_timeout
  P1_BASE_URL=$base P1_USER_PASSWORD_FILE="$SECRETS_DIR/demo-user.password" python3 - <<'PY'
import json, os, urllib.request
password = open(os.environ["P1_USER_PASSWORD_FILE"], encoding="utf-8").read()
request = urllib.request.Request(
    os.environ["P1_BASE_URL"] + "/api/v1/auth/login",
    data=json.dumps({"username": "demo-user", "password": password}).encode(),
    headers={"Content-Type": "application/json"},
)
with urllib.request.urlopen(request, timeout=5) as response:
    body = json.load(response)
if response.status != 200:
    raise SystemExit("P1_ERROR=login_status")
if body.get("data", {}).get("user", {}).get("userId") != "usr_demo_user":
    raise SystemExit("P1_ERROR=login_user")
if body["data"]["user"].get("role") != "USER":
    raise SystemExit("P1_ERROR=login_role")
token = body["data"].get("accessToken")
if not isinstance(token, str) or not token:
    raise SystemExit("P1_ERROR=login_token")
PY
  compose "$mode" --profile smoke run --rm --no-deps -e "P1_SMOKE_MODE=${mode^^}" synthetic-async-smoke
  printf 'P1_SMOKE=PASS ADAPTER=%s\n' "${mode^^}"
}

stop_services() {
  require_state
  compose kafka stop
  printf 'P1_STOPPED_VOLUMES_PRESERVED=TRUE\n'
}

logs_redacted() {
  require_state
  compose kafka logs --no-color --tail 500 | sed -E \
    -e 's/(Bearer )[A-Za-z0-9._~-]+/\1[REDACTED]/g' \
    -e 's#(postgresql://[^:/[:space:]]+:)[^@/[:space:]]+@#\1[REDACTED]@#Ig' \
    -e 's/(password|secret|token|account|credential|bundle|hmac|jwt|private[_-]?key|kek|dsn)([=:][^ ,}]*)/\1=[REDACTED]/Ig' \
    -e 's/\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}/[BCRYPT_REDACTED]/g'
}

load_release_images

case ${1:-} in
  init) [[ $# == 1 ]] || die unexpected_arguments; init_state ;;
  verify) [[ $# == 1 ]] || die unexpected_arguments; verify_state ;;
  up) [[ $# == 2 ]] || die unexpected_arguments; up_mode "$2" ;;
  smoke) [[ $# == 1 ]] || die unexpected_arguments; smoke ;;
  status) [[ $# == 1 ]] || die unexpected_arguments; require_state; compose kafka ps ;;
  logs) [[ ${2:-} == --redacted && $# == 2 ]] || die logs_requires_redacted; logs_redacted ;;
  stop) [[ $# == 1 ]] || die unexpected_arguments; stop_services ;;
  backup) exec "$SCRIPT_DIR/backup" ;;
  restore-test) exec "$SCRIPT_DIR/restore-test" ;;
  *) die usage_init_verify_up_smoke_status_logs_stop_backup_restore_test ;;
esac
