# Independent MARS DEMO release. Pin the image with the digest from its release manifest.
MARS_DEMO_VERSION=2.0.0
MARS_DEMO_IMAGE_DIGEST=
MARS_DEMO_PORT=3001
MARS_DEMO_SECRETS_DIR=/volume1/docker/mars-demo/demo-secrets

# DEMO-only Agent limits. SQLite daily counters persist across redeploys in mars-demo_state.
MARS_DEMO_AGENT_PER_SESSION_DAILY_LIMIT=5
MARS_DEMO_AGENT_GLOBAL_DAILY_LIMIT=50
MARS_DEMO_AGENT_MAX_CONCURRENT=1
MARS_DEMO_AGENT_MAX_INPUT_CHARS=1500
# Conservative UTF-8 request-byte ceiling, also bounded against the provider token budget.
MARS_DEMO_AGENT_MAX_INPUT_TOKENS=24576
MARS_DEMO_AGENT_MAX_CONTEXT_CHARS=4000
MARS_DEMO_AGENT_MAX_OUTPUT_TOKENS=512
MARS_DEMO_AGENT_SESSION_REQUESTS_PER_MINUTE=3
MARS_DEMO_AGENT_GLOBAL_REQUESTS_PER_MINUTE=15
MARS_DEMO_AGENT_TIMEOUT_MS=45000

# Pricing basis reviewed 2026-09-30; recheck whenever the model or provider rate changes.
MARS_DEMO_AGENT_MODEL=gemini-2.5-flash
MARS_DEMO_VERTEX_LOCATION=us-central1
MARS_DEMO_VERTEX_PROJECT_ID=
MARS_DEMO_AGENT_INPUT_USD_PER_MILLION_TOKENS=0.30
MARS_DEMO_AGENT_OUTPUT_USD_PER_MILLION_TOKENS=2.50
MARS_DEMO_AGENT_PRICING_REVIEWED_AT=2026-09-30

# Migration: v2 does not read legacy MARS_DEMO_AI_DAILY_HARD_CAP_USD.
# Remove that old shared-cost setting from the retired stack; v2 uses count/token limits and exposes a computed daily cost bound.
