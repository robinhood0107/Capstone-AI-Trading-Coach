#!/usr/bin/env python3
"""Host-side content-free integrity check for the committed public RAG Seed parts."""

from __future__ import annotations

import hashlib
import json
import os
import stat
import sys
from pathlib import Path
from typing import NoReturn


def fail(marker: str) -> NoReturn:
    raise SystemExit(f"PUBLIC_RAG_SEED_VERIFY={marker}")


def regular_file(path: Path, maximum: int) -> os.stat_result:
    try:
        metadata = path.lstat()
    except OSError:
        fail("FILE_MISSING")
    if (
        not stat.S_ISREG(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_size < 1
        or metadata.st_size > maximum
    ):
        fail("FILE_BOUNDARY")
    return metadata


def digest_file(path: Path, archive: object) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        while block := handle.read(1024 * 1024):
            digest.update(block)
            archive.update(block)  # type: ignore[attr-defined]
    return digest.hexdigest()


def main() -> None:
    if len(sys.argv) != 2:
        fail("USAGE")
    manifest_path = Path(sys.argv[1]).absolute()
    regular_file(manifest_path, 1024 * 1024)
    try:
        payload = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        fail("MANIFEST_JSON")
    required = {
        "contractId": "p1-public-rag-seed.v1",
        "sourceFlywaySchemaVersion": "73",
        "targetFlywaySchemaVersion": "87",
        "expectedSourceCount": 142,
        "expectedChunkCount": 7871,
        "embeddingDimension": 1024,
        "maxPartBytes": 33_554_432,
    }
    if not isinstance(payload, dict) or any(payload.get(key) != value for key, value in required.items()):
        fail("MANIFEST_CONTRACT")
    parts = payload.get("parts")
    if not isinstance(parts, list) or len(parts) != 2:
        fail("PART_INVENTORY")
    archive = hashlib.sha256()
    archive_size = 0
    for ordinal, item in enumerate(parts, 1):
        if not isinstance(item, dict) or item.get("ordinal") != ordinal:
            fail("PART_ORDER")
        expected_name = f"public-rag-seed.v1.jsonl.gz.part-{ordinal:04d}"
        if item.get("file") != expected_name:
            fail("PART_NAME")
        path = manifest_path.parent / expected_name
        metadata = regular_file(path, 33_554_432)
        if metadata.st_size != item.get("sizeBytes"):
            fail("PART_SIZE")
        if digest_file(path, archive) != item.get("sha256"):
            fail("PART_SHA256")
        archive_size += metadata.st_size
    if archive_size != payload.get("archiveSizeBytes"):
        fail("ARCHIVE_SIZE")
    if archive.hexdigest() != payload.get("archiveSha256"):
        fail("ARCHIVE_SHA256")
    print("PUBLIC_RAG_SEED_VERIFY=PASS")


if __name__ == "__main__":
    main()
