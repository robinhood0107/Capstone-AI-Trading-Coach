{
  "schemaVersion": "1.0.0",
  "consentVersion": "S8_USER_TEST_CONSENT_V1",
  "freeTextEnabled": false,
  "tasks": [
    {
      "id": "retired-capability",
      "prompt": "현재 교차시장 capability와 주문 권한을 고르세요.",
      "responseType": "SINGLE_CHOICE",
      "options": ["RETIRED_NOT_APPLICABLE_NO_ORDER_AUTHORITY", "WARN_ONLY_AUTO_BUY", "LIVE_ORDER_ENABLED"]
    },
    {
      "id": "evidence-classification",
      "prompt": "historical evidence에 적용할 분류를 모두 고르세요.",
      "responseType": "MULTI_CHOICE_MAX_4",
      "options": ["CONFIRMED_FACT", "REPORTED_CLAIM", "MARKET_INTERPRETATION", "HYPOTHESIS"]
    },
    {
      "id": "uncertainty",
      "prompt": "CONTRADICTS 또는 미해소 불확실성을 식별했나요?",
      "responseType": "BOOLEAN"
    },
    {
      "id": "timing-limit",
      "prompt": "LATE, stale, unavailable이 성과 또는 원인 확정이 아님을 설명할 수 있나요?",
      "responseType": "BOOLEAN"
    },
    {
      "id": "usability",
      "prompt": "안전 상태를 이해하기 쉬웠나요?",
      "responseType": "INTEGER_1_TO_7"
    },
    {
      "id": "confidence",
      "prompt": "답변에 얼마나 확신하나요?",
      "responseType": "INTEGER_1_TO_5"
    },
    {
      "id": "improvement-tags",
      "prompt": "개선이 필요한 영역을 최대 3개 고르세요.",
      "responseType": "MULTI_CHOICE_MAX_3",
      "options": ["NAVIGATION", "TERMINOLOGY", "EVIDENCE", "TIMING", "ACCESSIBILITY", "NONE"]
    }
  ]
}
