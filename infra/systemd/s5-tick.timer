[Unit]
Description=S5 autonomous tick schedule (RETIRED; do not enable)

[Timer]
# Historical schedule retained for audit reproduction only.
OnBootSec=5min
# tick 하나가 한 단계를 끝내므로 짧게 돌 이유가 없다. rate limit 대기가 tick 경계로 흡수된다.
OnUnitActiveSec=30min
# tick이 겹치면 run lock에서 하나가 죽는다. 시간을 흩어 그 충돌을 줄인다.
RandomizedDelaySec=2min
Persistent=true
Unit=s5-tick.service

[Install]
WantedBy=timers.target
