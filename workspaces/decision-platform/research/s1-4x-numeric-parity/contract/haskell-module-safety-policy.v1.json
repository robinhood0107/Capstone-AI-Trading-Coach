    "stackageSnapshotUri": "https://raw.githubusercontent.com/commercialhaskell/stackage-snapshots/master/lts/24/50.yaml",
    "stackageCabalRevisionSha256": "3ec12de580ee31ceac89b314fd00b5057ed40198c0b3d9e9dafa54c1941e6942",
    "stackageCabalRevisionSize": 8804,
    "pantryTreeSha256": "12839cef1252eaa894d6a9adafaa2e1cdb449f03c343f765294e033c813261fc",
    "sourceSha256RequiredAtGate2": true,
    "upstreamTransitiveAllowlistRequiredFields": [
