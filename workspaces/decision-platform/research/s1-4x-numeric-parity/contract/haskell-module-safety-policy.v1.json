    "upstreamTransitiveEdgesMayExist": true,
    "candidateDirectUnsafeOrPrimopUseCount": 0
  },
  "candidateGraphInvariants": {
    "candidateDirectForeignImportCount": 0,
    "candidateDirectUnsafeImportCount": 0,
    "candidateHomeCoreToShellEdgeCount": 0,
    "candidateTrustworthyDeclarationCount": 0,
    "candidateUnsafeDeclarationCount": 0,
    "unclassifiedModuleCount": 0,
    "newUnknownUpstreamTransitiveEdgeCount": 0
  },
  "resultEdgePartitions": [
    "candidateDirectImports",
    "candidateHomeModuleEdges",
    "upstreamTransitiveEdges"
  ],
  "resultEdgeCategoryContract": {
    "candidateDirectImportsRequiredCategoryFields": [
      "fromCategory"
    ],
    "candidateHomeModuleEdgesRequiredCategoryFields": [
      "fromCategory",
      "toCategory"
    ],
    "embeddedCategoriesMustMatchModuleInventory": true,
    "coreCategories": [
      "safe-scalar",
      "audited-pure-vector"
    ],
    "shellCategories": [
      "io-shell",
      "test",
      "benchmark"
    ],
    "allowedHomeClassifications": {
      "core-to-core": "core-to-core",
      "shell-to-core": "shell-to-core",
      "shell-to-shell": "shell-to-shell"
    },
    "coreToShellAllowed": false,
    "allCandidateForbiddenDirectImportPatterns": [
      "Foreign.*",
      "Unsafe.*",
      "System.IO.Unsafe",
      "GHC.IO.Unsafe"
    ],
    "allCoreAdditionalForbiddenDirectImports": [
      "System.IO",
      "Control.Monad.IO.Class",
      "Debug.Trace"
    ],
    "safeScalarAdditionalForbiddenDirectImports": [
      "Data.Vector.Unboxed"
    ]
  },
  "conditionalOptimizations": {
    "runSTAndMutableUnboxedVector": {
      "allowedOnlyWhen": [
        "mutable reference cannot escape a pure return type",
        "full parity mismatch count is zero",
        "allocation and Core evidence exists",
        "focused Criterion improvement passes the frozen selector"
      ],
      "fallback": "ordinary U.Vector and U.foldl'"
    },
    "strictDataUnpackInlineSpecialise": {
      "oneAtATime": true,
      "fullCorrectnessRequired": true,
      "fallback": "ordinary newtype, U.Vector, and U.foldl'"
    }
  },
  "authoritativeProfiles": {
    "baseline": [
      "-O0",
      "-fasm"
    ],
    "optimized": [
      "-O2",
      "-fasm"
    ],
    "runtime": [
      "+RTS",
      "-N1",
      "-RTS"
    ],
    "fallbackProfile": "baseline-o0-fasm"
  },
  "forbiddenOptimizationFlags": [
    "-fllvm",
    "-ffast-math",
    "-mfma",
    "-mavx*",
    "-march=native",
    "-fpolymorphic-specialisation",
    "-fspecialise-aggressively",
    "-funbox-strict-fields",
    "RULES"
  ],
  "hardFailureConditions": [
    "unclassified module",
    "category and import graph disagree",
    "wrapper claims Data.Vector.Unboxed is Safe",
    "candidate Trustworthy or Unsafe declaration",
    "candidate core depends on shell",
    "candidate direct Foreign or Unsafe import or use",
    "unknown, new, or source-hash-drifted upstream transitive edge"
  ]
}
