{
  "schemaVersion": "s1.4x-haskell-module-safety-policy-v1",
  "language": "GHC2024",
  "categories": {
    "safe-scalar": {
      "mandatoryCompileMode": "Safe",
      "allowedRoles": [
        "error ADT",
        "scalar types",
        "scalar validation",
        "vector-free scalar kernel"
      ],
      "forbiddenImports": [
        "Data.Vector.Unboxed",
        "System.IO",
        "Control.Monad.IO.Class",
        "Foreign.*",
        "Unsafe.*",
        "System.IO.Unsafe",
        "GHC.IO.Unsafe",
        "Debug.Trace"
      ]
    },
    "audited-pure-vector": {
      "mandatoryCompileMode": "SafeHaskell-None-with-audited-purity-gate",
      "allowedRoles": [
        "pure numeric kernel using Data.Vector.Unboxed"
      ],
      "allowedDirectExternalImports": [
        "Data.Vector.Unboxed"
      ],
      "forbiddenDirectImports": [
        "System.IO",
        "Control.Monad.IO.Class",
        "Foreign.*",
        "Unsafe.*",
        "System.IO.Unsafe",
        "GHC.IO.Unsafe",
        "Debug.Trace"
      ]
    },
    "io-shell": {
      "mandatoryCompileMode": "ordinary",
      "allowedRoles": [
        "strict JSON pre-parser",
        "binary manifest reader",
        "atomic process shell",
        "sanitized transport error mapper",
        "shell-only pure SHA-256"
      ],
      "coreMayDependOnCategory": false
    },
    "test": {
      "mandatoryCompileMode": "ordinary",
      "allowedRoles": [
        "unit, property, process, negative, and contract tests"
      ]
    },
    "benchmark": {
      "mandatoryCompileMode": "ordinary",
      "allowedRoles": [
        "Criterion harness and fixture setup outside the kernel timer"
      ]
    }
  },
  "everyModuleExactlyOneCategory": true,
  "mandatoryCoreExtensions": [
    "NoForeignFunctionInterface",
    "NoTemplateHaskell",
    "NoCPP",
    "NoRebindableSyntax",
    "NoLinearTypes",
    "NoMagicHash",
    "NoStrict",
    "NoGeneralizedNewtypeDeriving",
    "NoDerivingVia",
    "NoDeriveAnyClass"
  ],
  "forbiddenCorePositiveExtensions": [
    "ForeignFunctionInterface",
    "TemplateHaskell",
    "CPP",
    "RebindableSyntax",
    "LinearTypes",
    "MagicHash",
    "Strict",
    "GeneralizedNewtypeDeriving",
    "DerivingVia",
    "DeriveAnyClass"
  ],
  "candidateSourceSuffixPolicy": {
    "allowedSourceSuffixes": [
      ".hs"
    ],
    "forbiddenCompilableSuffixes": [
      ".lhs",
      ".hsc",
      ".hs-boot"
    ],
    "allowedNonHsConfigurationPaths": [
      "selected-profile.v1.json",
      "package.yaml"
    ],
    "nonHsEntriesMustHaveRole": "configuration"
  },
  "candidateDerivingPolicy": "deriving stock only",
  "forbiddenCandidateModuleDeclarations": [
    "Trustworthy",
    "Unsafe"
  ],
  "forbiddenCoreTypesAndUses": [
    "IO",
    "MonadIO",
    "environment access",
    "clock",
    "random",
    "network",
    "Control.Exception.throw",
    "Control.Exception.throwIO",
    "foreign import",
    "foreign export"
  ],
  "forbiddenPartialAndUnsafeSymbols": [
    "Prelude.head",
    "Prelude.tail",
    "Prelude.init",
    "Prelude.last",
    "Prelude.!!",
    "Text.Read.read",
    "Data.Maybe.fromJust",
    "Data.Either.fromLeft",
    "Data.Either.fromRight",
    "Data.List.foldl1",
    "Data.List.maximum",
    "Data.List.minimum",
    "Debug.Trace",
    "System.IO.Unsafe",
    "GHC.IO.Unsafe",
    "Foreign.*"
  ],
  "forbiddenSourceLocalControls": [
    "OPTIONS_GHC",
    "HLint ignore",
    "global Strict",
    "LinearTypes",
    "TemplateHaskell",
    "CPP",
    "MagicHash"
  ],
  "vectorProvenance": {
    "package": "vector",
    "version": "0.13.2.0",
    "module": "Data.Vector.Unboxed",
