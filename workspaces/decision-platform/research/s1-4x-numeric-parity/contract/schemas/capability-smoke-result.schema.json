{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone-ai-trading-coach.invalid/s1-4x/schemas/capability-smoke-result.schema.json",
  "title": "S1.4X capability smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planSha256",
    "language",
    "toolchainIdentitySha256",
    "results",
    "aggregateStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "s1.4x-capability-smoke-result-v1"
    },
    "planSha256": {
      "$ref": "#/$defs/sha256"
    },
    "language": {
      "enum": [
        "scala",
        "haskell"
      ]
    },
    "toolchainIdentitySha256": {
      "$ref": "#/$defs/sha256"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/result"
      },
      "x-s1-4x-unique-by": "smokeId"
    },
    "aggregateStatus": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "language": {
            "const": "scala"
          }
        },
        "required": [
          "language"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "properties": {
                "smokeId": {
                  "enum": [
                    "scala-toolchain-identity",
                    "scala-stable-compiler-profile",
                    "scala-scalafmt-idempotence",
                    "scala-scalafix-disable-syntax",
                    "scala-source-policy",
                    "scala-explicit-result-types",
                    "scala-jmh-native-json",
                    "scala-profile-abc-correctness"
                  ]
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-toolchain-identity"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-stable-compiler-profile"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-scalafmt-idempotence"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-scalafix-disable-syntax"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-source-policy"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-explicit-result-types"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-jmh-native-json"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "scala-profile-abc-correctness"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "language": {
            "const": "haskell"
          }
        },
        "required": [
          "language"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "properties": {
                "smokeId": {
                  "enum": [
                    "haskell-toolchain-identity",
                    "haskell-language-safety-profile",
                    "haskell-format-and-lint",
                    "haskell-native-harnesses",
                    "haskell-profile-correctness",
                    "haskell-ghc-9.14.1-compatibility"
                  ]
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "haskell-toolchain-identity"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "haskell-language-safety-profile"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "haskell-format-and-lint"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "haskell-native-harnesses"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "haskell-profile-correctness"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "smokeId": {
                      "const": "haskell-ghc-9.14.1-compatibility"
                    }
                  },
                  "required": [
                    "smokeId"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "aggregateStatus": {
            "const": "PASS"
          }
        },
        "required": [
          "aggregateStatus"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "status": {
                  "const": "FAIL"
                }
              },
              "required": [
                "status"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smokeId",
        "compilerStatus",
        "argv",
        "exitCode",
        "stdoutSha256",
        "stderrSha256",
        "artifactSha256",
        "status",
        "disposition",
        "provenFallback",
        "fallbackExecuted"
      ],
      "properties": {
        "smokeId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "compilerStatus": {
          "enum": [
            "stable",
            "preview",
            "experimental",
            "nightly"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stdoutSha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderrSha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "disposition": {
          "enum": [
            "ADOPT",
            "FALLBACK",
            "BLOCKED_TOOLCHAIN",
            "BLOCKED_CONTRACT"
          ]
        },
        "provenFallback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "fallbackExecuted": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exitCode": {
                "const": 0
              },
              "disposition": {
                "const": "ADOPT"
              },
              "fallbackExecuted": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "disposition": {
                "enum": [
                  "FALLBACK",
                  "BLOCKED_TOOLCHAIN",
                  "BLOCKED_CONTRACT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "FALLBACK"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "FAIL"
              },
              "fallbackExecuted": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "BLOCKED_TOOLCHAIN",
                  "BLOCKED_CONTRACT"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "FAIL"
              },
              "fallbackExecuted": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
