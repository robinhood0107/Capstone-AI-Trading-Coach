{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone-ai-trading-coach.invalid/s1-4x/schemas/dependency-native-edge-result.schema.json",
  "title": "S1.4X Haskell dependency native-edge audit result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policySha256",
    "laneId",
    "compilerVersion",
    "packagePlanSha256",
    "sourceArchiveManifestSha256",
    "linkMetadataSha256",
    "edges",
    "newNonBootEdgeCount",
    "candidateAuthoredEdgeCount",
    "candidateAddedNativeDependencyCount",
    "candidateCoreDirectNativeBindingImportCount",
    "candidateCoreDirectNativeBindingCallCount",
    "timedKernelExplicitCandidateNativeInteropCallCount",
    "unknownEdgeCount",
    "staleAllowlistEntryCount",
    "nonBootPlanEquivalentToAuthoritative",
    "aggregateStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "s1.4x-dependency-native-edge-result-v1"
    },
    "policySha256": {
      "$ref": "#/$defs/sha256"
    },
    "laneId": {
      "enum": [
        "authoritative",
        "latest-compatibility"
      ]
    },
    "compilerVersion": {
      "enum": [
        "9.10.3",
        "9.14.1"
      ]
    },
    "packagePlanSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceArchiveManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "linkMetadataSha256": {
      "$ref": "#/$defs/sha256"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "newNonBootEdgeCount": {
      "const": 0
    },
    "candidateAuthoredEdgeCount": {
      "const": 0
    },
    "candidateAddedNativeDependencyCount": {
      "const": 0
    },
    "candidateCoreDirectNativeBindingImportCount": {
      "const": 0
    },
    "candidateCoreDirectNativeBindingCallCount": {
      "const": 0
    },
    "timedKernelExplicitCandidateNativeInteropCallCount": {
      "const": 0
    },
    "unknownEdgeCount": {
      "const": 0
    },
    "staleAllowlistEntryCount": {
      "const": 0
    },
    "nonBootPlanEquivalentToAuthoritative": {
      "const": true
    },
    "aggregateStatus": {
      "const": "PASS"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "laneId": {
            "const": "authoritative"
          }
        },
        "required": [
          "laneId"
        ]
      },
      "then": {
        "properties": {
          "compilerVersion": {
            "const": "9.10.3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "laneId": {
            "const": "latest-compatibility"
          }
        },
        "required": [
          "laneId"
        ]
      },
      "then": {
        "properties": {
          "compilerVersion": {
            "const": "9.14.1"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "package",
        "version",
        "sourceSha256",
        "effectiveFlags",
        "edgeKind",
        "linkedLibrary",
        "provenance",
        "candidateAuthored",
        "coreReachable",
        "shellOnly",
        "timedRegion",
        "reviewDisposition"
      ],
      "properties": {
        "category": {
          "enum": [
            "ghc-rts",
            "compiler-boot-package",
            "lts-24.50-transitive"
          ]
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "effectiveFlags": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "edgeKind": {
          "enum": [
            "ffi",
            "c-source",
            "linked-library",
            "compiler-primop",
            "rts-runtime"
          ]
        },
        "linkedLibrary": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "candidateAuthored": {
          "const": false
        },
        "coreReachable": {
          "type": "boolean"
        },
        "shellOnly": {
          "type": "boolean"
        },
        "timedRegion": {
          "type": "boolean"
        },
        "reviewDisposition": {
          "const": "ALLOW_FROZEN"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "package": {
                "const": "math-functions"
              }
            },
            "required": [
              "package"
            ]
          },
          "then": {
            "properties": {
              "effectiveFlags": {
                "required": [
                  "system-erf",
                  "system-expm1"
                ],
                "properties": {
                  "system-erf": {
                    "const": false
                  },
                  "system-expm1": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
