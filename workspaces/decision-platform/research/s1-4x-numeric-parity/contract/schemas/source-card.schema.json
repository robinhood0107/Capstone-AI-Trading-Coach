{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone-ai-trading-coach.invalid/s1-4x/schemas/source-card.schema.json",
  "title": "S1.4X toolchain capability source cards",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidencePriority",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "s1.4x-source-cards-v1"
    },
    "evidencePriority": {
      "const": "official-stable>accepted-proposal>official-event>third-party"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      },
      "x-s1-4x-unique-by": "featureId"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "distributionProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stackDistributionChannel",
        "installer",
        "stackPolicy",
        "ghcupVersion",
        "stackInstallCommand",
        "ghcupMetadataCommit",
        "ghcupMetadataUri",
        "stackArchiveUri",
        "stackArchiveSha256",
        "stackBinPathId",
        "stackBinSha256",
        "stackNumericVersion",
        "upstreamStandaloneAssetSha256",
        "upstreamStandaloneAssetRole",
        "verifiedAt"
      ],
      "properties": {
        "stackDistributionChannel": {
          "const": "ghcup-managed"
        },
        "installer": {
          "const": "ghcup"
        },
        "stackPolicy": {
          "const": "GHCup-managed exact-version installation"
        },
        "ghcupVersion": {
          "const": "0.2.6.2"
        },
        "stackInstallCommand": {
          "const": "ghcup install stack 3.11.1"
        },
        "ghcupMetadataCommit": {
          "const": "0341867f2d419567cf42ea6931e031b00ab3a922"
        },
        "ghcupMetadataUri": {
          "const": "https://github.com/haskell/ghcup-metadata/commit/0341867f2d419567cf42ea6931e031b00ab3a922"
        },
        "stackArchiveUri": {
          "const": "https://downloads.haskell.org/~ghcup/unofficial-bindists/stack/3.11.1/stack-3.11.1-linux-x86_64.tar.gz"
        },
        "stackArchiveSha256": {
          "const": "ca3cc5e89d87d1b85594a866de4062671d19ec039cd2401df70d4ccff03ffed9"
        },
        "stackBinPathId": {
          "const": "GHCUP_STACK_3_11_1"
        },
        "stackBinSha256": {
          "const": "923dbd137756652c67b376e2447c655b87fcc373f4d104b5073bca913471ecbe"
        },
        "stackNumericVersion": {
          "const": "3.11.1"
        },
        "upstreamStandaloneAssetSha256": {
          "const": "67c66e918801c41ae4d286b1c91f9124f691c1c7d56071b53889cf4a5c667550"
        },
        "upstreamStandaloneAssetRole": {
          "const": "comparison-only-not-installed-provenance"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "officialSource",
        "sourceDate",
        "claim",
        "evidenceClass",
        "status",
        "compilerStatus",
        "problemRelevance",
        "correctnessRisk",
        "toolingCompatibility",
        "decision",
        "requiredLint",
        "requiredTests",
        "requiredBenchmark",
        "provenFallback",
        "decisionDate",
        "verifiedAt",
        "licenseAccessNote",
        "adoptedSession",
        "assumptions"
      ],
      "properties": {
        "featureId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "officialSource": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "sourceDate": {
          "type": "string",
          "format": "date"
        },
        "claim": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceClass": {
          "enum": [
            "officialStableRelease",
            "officialReference",
            "officialCompilerDocumentation",
            "acceptedProposal",
            "officialEventDiscovery",
            "thirdParty"
          ]
        },
        "status": {
          "enum": [
            "verified",
            "candidate",
            "superseded",
            "unavailable"
          ]
        },
        "compilerStatus": {
          "enum": [
            "stable",
            "preview",
            "experimental",
            "nightly"
          ]
        },
        "problemRelevance": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "correctnessRisk": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "toolingCompatibility": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "decision": {
          "enum": [
            "ADOPT",
            "CONDITIONAL",
            "PROBE_ONLY",
            "REJECT"
          ]
        },
        "requiredLint": {
          "$ref": "#/$defs/stringList"
        },
        "requiredTests": {
          "$ref": "#/$defs/stringList"
        },
        "requiredBenchmark": {
          "$ref": "#/$defs/stringList"
        },
        "provenFallback": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "decisionDate": {
          "type": "string",
          "format": "date"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "licenseAccessNote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "adoptedSession": {
          "const": "S1.4X"
        },
        "assumptions": {
          "$ref": "#/$defs/stringList"
        },
        "distributionProvenance": {
          "$ref": "#/$defs/distributionProvenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "featureId": {
                "const": "haskell.stack-3.11.1"
              }
            },
            "required": [
              "featureId"
            ]
          },
          "then": {
            "required": [
              "distributionProvenance"
            ]
          }
        }
      ]
    }
  }
}
