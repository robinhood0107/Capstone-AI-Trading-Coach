{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capstone-ai-trading-coach.invalid/s1-4x/schemas/toolchain-provenance.schema.json",
  "title": "S1.4X portable GHCup-managed Stack provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stackPolicy",
    "stackInstallCommand",
    "ghcupToolId",
    "ghcupVersion",
    "ghcupReleaseUri",
    "ghcupAssetUri",
    "ghcupAssetSha256",
    "ghcupMetadataCommit",
    "ghcupMetadataUri",
    "ghcupMetadataRawUri",
    "ghcupMetadataRawSha256",
    "stackDistributionChannel",
    "stackArchiveUri",
    "stackArchiveSha256",
    "stackBinPathId",
    "stackBinResolver",
    "stackBinSha256",
    "stackNumericVersion",
    "upstreamStandaloneAssetUri",
    "upstreamStandaloneAssetSha256",
    "upstreamStandaloneAssetRole",
    "verifiedAt",
    "gate0MetadataEntryEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "s1.4x-toolchain-provenance-v1"
    },
    "stackPolicy": {
      "const": "GHCup-managed exact-version installation"
    },
    "stackInstallCommand": {
      "const": "ghcup install stack 3.11.1"
    },
    "ghcupToolId": {
      "const": "GHCUP_0_2_6_2_LINUX_X86_64"
    },
    "ghcupVersion": {
      "const": "0.2.6.2"
    },
    "ghcupReleaseUri": {
      "const": "https://github.com/haskell/ghcup-hs/releases/tag/v0.2.6.2"
    },
    "ghcupAssetUri": {
      "const": "https://github.com/haskell/ghcup-hs/releases/download/v0.2.6.2/x86_64-linux-ghcup-0.2.6.2"
    },
    "ghcupAssetSha256": {
      "const": "9ed5da5449b48043a0d17e767c05d2ef585e25a639bb934329496c6d2fad9cf8"
    },
    "ghcupMetadataCommit": {
      "const": "0341867f2d419567cf42ea6931e031b00ab3a922"
    },
    "ghcupMetadataUri": {
      "const": "https://github.com/haskell/ghcup-metadata/commit/0341867f2d419567cf42ea6931e031b00ab3a922"
    },
    "ghcupMetadataRawUri": {
      "const": "https://raw.githubusercontent.com/haskell/ghcup-metadata/0341867f2d419567cf42ea6931e031b00ab3a922/ghcup-0.1.0.yaml"
    },
    "ghcupMetadataRawSha256": {
      "const": "49c8a036ce399587205a11ac24e73465cadc5f3232e9418a9d87f4b7f746c4ec"
    },
    "stackDistributionChannel": {
      "const": "ghcup-managed"
    },
    "stackArchiveUri": {
      "const": "https://downloads.haskell.org/~ghcup/unofficial-bindists/stack/3.11.1/stack-3.11.1-linux-x86_64.tar.gz"
    },
    "stackArchiveSha256": {
      "const": "ca3cc5e89d87d1b85594a866de4062671d19ec039cd2401df70d4ccff03ffed9"
    },
    "stackBinPathId": {
      "const": "GHCUP_STACK_3_11_1"
    },
    "stackBinResolver": {
      "const": "ghcup whereis stack 3.11.1"
    },
    "stackBinSha256": {
      "const": "923dbd137756652c67b376e2447c655b87fcc373f4d104b5073bca913471ecbe"
    },
    "stackNumericVersion": {
      "const": "3.11.1"
    },
    "upstreamStandaloneAssetUri": {
      "const": "https://github.com/commercialhaskell/stack/releases/download/v3.11.1/stack-3.11.1-linux-x86_64-bin"
    },
    "upstreamStandaloneAssetSha256": {
      "const": "67c66e918801c41ae4d286b1c91f9124f691c1c7d56071b53889cf4a5c667550"
    },
    "upstreamStandaloneAssetRole": {
      "const": "comparison-only-not-installed-provenance"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "gate0MetadataEntryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "sourceSha256",
        "serialization",
        "payload",
        "digestSha256"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "serialization": {
          "enum": [
            "utf8-exact-bytes",
            "canonical-json-utf8"
          ]
        },
        "payload": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        },
        "digestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "x-s1-4x-forbid-absolute-local-paths": true,
  "x-s1-4x-installed-provenance-chain": "GHCup metadata snapshot -> GHCup Stack archive -> installed Stack binary -> numeric version",
  "x-s1-4x-upstream-standalone-is-not-install-provenance": true
}
