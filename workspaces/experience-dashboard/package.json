{
  "name": "experience-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "투자 원칙 기반 AI 트레이딩 코치 — Experience Dashboard (팀원 A workspace)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:contract",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:contract": "node --test tests/contract/*.test.mjs",
    "test:e2e:live": "playwright test",
    "test:e2e:owner-acceptance": "playwright test --config=playwright.team-a.config.ts"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
