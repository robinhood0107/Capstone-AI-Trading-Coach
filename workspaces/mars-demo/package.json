{
  "name": "mars-demo",
  "version": "2.0.0",
  "private": true,
  "description": "Isolated low-resource MARS DEMO application",
  "scripts": {
    "dev": "node scripts/with-shared-dependencies.mjs next dev",
    "build": "node scripts/with-shared-dependencies.mjs next build",
    "start": "next start",
    "typecheck": "node scripts/with-shared-dependencies.mjs tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests --max-warnings=0"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "google-auth-library": "11.1.0",
    "next": "15.5.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.24",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.12",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4",
    "js-yaml": "4.3.2"
  }
}
