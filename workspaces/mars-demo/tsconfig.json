{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/shared/api/client": ["src/adapters/client.ts"],
      "@/shared/api/session": ["src/adapters/session.tsx"],
      "@/shared/api/*": ["../experience-dashboard/src/shared/api/*"],
      "@/shared/ui/*": ["../experience-dashboard/src/shared/ui/*"],
      "@/shared/lib/*": ["../experience-dashboard/src/shared/lib/*"],
      "@/features/*": ["../experience-dashboard/src/features/*"],
      "@full/app/*": ["../experience-dashboard/src/app/*"],
      "@demo/*": ["src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
